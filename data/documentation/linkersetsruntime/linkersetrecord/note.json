:", ","kind":"text"},{"preciseIdentifier":"s:s5UInt8V","text":"UInt8","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:s5UInt8V","text":"UInt8","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:s5UInt8V","text":"UInt8","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:s5UInt8V","text":"UInt8","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:s5UInt8V","text":"UInt8","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:s5UInt8V","text":"UInt8","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:s5UInt8V","text":"UInt8","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:s5UInt8V","text":"UInt8","kind":"typeIdentifier"},{"text":"), record","kind":"text"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17LinkerSetsRuntime0A9SetRecordV","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord","text":"LinkerSetRecord","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:17LinkerSetsRuntime0A9SetRecordV7Literala","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/Literal","text":"Literal","kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"In an ELF image the records sit in the note section "},{"code":".note.linker_sets","type":"codeVoice"},{"type":"text","text":", which the linker"},{"type":"text","text":" "},{"type":"text","text":"covers with a "},{"code":"PT_NOTE","type":"codeVoice"},{"type":"text","text":" program header, so "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet"},{"type":"text","text":" finds each loaded image’s records"},{"type":"text","text":" "},{"type":"text","text":"through "},{"code":"dl_iterate_phdr","type":"codeVoice"},{"type":"text","text":", a shared library’s and a "},{"code":"dlopen","type":"codeVoice"},{"type":"text","text":"ed one’s included. Each note"},{"type":"text","text":" "},{"type":"text","text":"has the standard header: "},{"code":"nameSize","type":"codeVoice"},{"type":"text","text":" 11 and "},{"code":"name","type":"codeVoice"},{"type":"text","text":" "},{"code":"\"LinkerSets\"","type":"codeVoice"},{"type":"text","text":" with its terminating"},{"type":"text","text":" "},{"type":"text","text":"zero, padded to 12 bytes; "},{"code":"descriptorSize","type":"codeVoice"},{"type":"text","text":", the size of a record (32 bytes where pointers"},{"type":"text","text":" "},{"type":"text","text":"are 64 bits, 20 where they are 32); and "},{"code":"type","type":"codeVoice"},{"type":"text","text":" 1. The record follows as the descriptor:"}],"type":"paragraph"},{"syntax":"swift","code":["let note: LinkerSetRecord.Note = (11, 32, 1, (76, 105, 110, 107, 101, 114, 83, 101, 116, 115, 0, 0),","                                  (0x726F_7574, 0, { outValue, type, hint, reserved in false }, 0, 0))"],"type":"codeListing"},{"inlineContent":[{"text":"The 24-byte header keeps the record at its own alignment, whether a reader aligns notes to","type":"text"},{"text":" ","type":"text"},{"text":"4 bytes or to 8.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime","doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://LinkerSetsRuntime/documentation/LinkerSetsRuntime/LinkerSetRecord/Note":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"navigatorTitle":[{"kind":"identifier","text":"Note"}],"type":"topic","abstract":[{"text":"A record as a macro writes it in an ELF image: the record, wrapped in an ELF note.","type":"text"}],"url":"\/documentation\/linkersetsruntime\/linkersetrecord\/note","kind":"symbol","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/Note","role":"symbol","title":"LinkerSetRecord.Note"},"doc://LinkerSetsRuntime/documentation/LinkerSetsRuntime":{"type":"topic","abstract":[{"text":"Find every record of a kind at run time, without building any macros.","type":"text"}],"url":"\/documentation\/linkersetsruntime","kind":"symbol","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime","role":"collection","title":"LinkerSetsRuntime"},"doc://LinkerSetsRuntime/documentation/LinkerSetsRuntime/LinkerSetRecord/Literal":{"navigatorTitle":[{"kind":"identifier","text":"Literal"}],"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/Literal","abstract":[{"text":"A record as a macro writes it: a tuple of the record’s fields, in order.","type":"text"}],"kind":"symbol","role":"symbol","title":"LinkerSetRecord.Literal","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Literal"}],"type":"topic","url":"\/documentation\/linkersetsruntime\/linkersetrecord\/literal"},"doc://LinkerSetsRuntime/documentation/LinkerSetsRuntime/LinkerSet":{"type":"topic","abstract":[{"type":"text","text":"Every record of one kind, across every image the program has loaded, and the values they"},{"type":"text","text":" "},{"type":"text","text":"produce."}],"kind":"symbol","role":"symbol","title":"LinkerSet","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet","navigatorTitle":[{"text":"LinkerSet","kind":"identifier"}],"url":"\/documentation\/linkersetsruntime\/linkerset","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSet","kind":"identifier"}]},"doc://LinkerSetsRuntime/documentation/LinkerSetsRuntime/LinkerSetRecord":{"url":"\/documentation\/linkersetsruntime\/linkersetrecord","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetRecord","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"One entry in a linker set: a record an attached macro places in the section LinkerSets owns."}],"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord","navigatorTitle":[{"text":"LinkerSetRecord","kind":"identifier"}],"title":"LinkerSetRecord","role":"symbol"}}}