{"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/LinkerSetsMacroSupport\/s16SendableMetatypeP","doc:\/\/LinkerSetsMacroSupport\/17SwiftSyntaxMacros13AttachedMacroP","doc:\/\/LinkerSetsMacroSupport\/17SwiftSyntaxMacros5MacroP","doc:\/\/LinkerSetsMacroSupport\/17SwiftSyntaxMacros9PeerMacroP"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetMacro"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiftSyntaxMacros9PeerMacroP","text":"PeerMacro"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A client declares its own macro by conforming a type in its compiler plugin and returning"},{"type":"text","text":" "},{"type":"text","text":"its kind; the expansion is shared:"}],"type":"paragraph"},{"code":["import LinkerSetsMacroSupport","import SwiftCompilerPlugin","","@main","struct RoutesPlugin: CompilerPlugin {","    let providingMacros: [any Macro.Type] = [RouteMacro.self]","}","","public enum RouteMacro: LinkerSetMacro {","    public static func kind(of attribute: AttributeSyntax) -> UInt32 { 0x726F_7574 }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The expansion is a private ","type":"text"},{"code":"@used","type":"codeVoice"},{"text":" peer, placed with ","type":"text"},{"code":"@section","type":"codeVoice"},{"text":" in the section LinkerSets","type":"text"},{"text":" ","type":"text"},{"text":"owns, whose accessor produces the declaration’s value:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"a static property’s or a global variable’s value;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a static or free function, as a value of its function type;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"a struct, enum, class or actor, as its metatype: "},{"code":"any P.Type","type":"codeVoice"},{"type":"text","text":" when"},{"type":"text","text":" "},{"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/requiredConformance(of:)","type":"reference","isActive":true},{"type":"text","text":" names a protocol "},{"code":"P","type":"codeVoice"},{"type":"text","text":", which the type must then conform to or the"},{"type":"text","text":" "},{"type":"text","text":"expansion doesn’t compile, and "},{"code":"Any.Type","type":"codeVoice"},{"type":"text","text":" otherwise."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A function isolated to the main actor, by its own ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" or its type’s or extension’s,","type":"text"},{"text":" ","type":"text"},{"text":"is stored as its isolated type (","type":"text"},{"code":"@MainActor () -> Void","type":"codeVoice"},{"text":"), read with","type":"text"},{"text":" ","type":"text"},{"code":"LinkerSet<@MainActor () -> Void>","type":"codeVoice"},{"text":" and called on the main actor. A property isolated to the","type":"text"},{"text":" ","type":"text"},{"text":"main actor is refused, since the record’s nonisolated accessor can’t read it: one marked","type":"text"},{"text":" ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":", or a ","type":"text"},{"code":"var","type":"codeVoice"},{"text":" of a ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" type. Only a written ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" is seen. A custom","type":"text"},{"text":" ","type":"text"},{"text":"global actor’s attribute, and isolation a type inherits from a protocol it conforms to, can’t","type":"text"},{"text":" ","type":"text"},{"text":"be seen in the syntax, so a member isolated that way fails to compile inside the expansion.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It diagnoses anything else, each with a message of its own: generic functions and types,"},{"type":"text","text":" "},{"type":"text","text":"members of generic types, instance members, protocol requirements, declarations inside a"},{"type":"text","text":" "},{"type":"text","text":"function, closure or accessor, and a kind that isn’t a 32-bit literal other than 0."}],"type":"paragraph"},{"inlineContent":[{"text":"Before swift-syntax 600 a macro can’t see its lexical context. There a type it registers must","type":"text"},{"text":" ","type":"text"},{"text":"be declared at file scope, and the compiler, not the macro, refuses a local declaration or a","type":"text"},{"text":" ","type":"text"},{"text":"member of a generic type, with an error in the expansion.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/linkersetsmacrosupport\/linkersetmacro"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro"},"metadata":{"symbolKind":"protocol","externalID":"s:22LinkerSetsMacroSupport0a3SetC0P","navigatorTitle":[{"kind":"identifier","text":"LinkerSetMacro"}],"role":"symbol","roleHeading":"Protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetMacro","kind":"identifier"}],"modules":[{"name":"LinkerSetsMacroSupport"}],"title":"LinkerSetMacro","remoteSource":{"fileName":"LinkerSetMacro.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSetsMacroSupport\/LinkerSetMacro.swift#L48"}},"kind":"symbol","sections":[],"abstract":