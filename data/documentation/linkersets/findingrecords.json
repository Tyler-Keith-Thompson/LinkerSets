{"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/linkersets\/findingrecords"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet"},{"text":" names a kind and a type. Its ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/values"},{"text":" are the values of every record of","type":"text"},{"text":" ","type":"text"},{"text":"that kind that produces the type:","type":"text"}],"type":"paragraph"},{"code":["let routes = LinkerSet<Route>(kind: .routes).values"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"What you ask for depends on what was marked:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Marked declaration"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ask for"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static let home = Route(path: \"\/\")"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LinkerSet<Route>"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static func migrate(_ db: inout Database)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LinkerSet<(inout Database) -> Void>"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@MainActor static func show()"},{"text":", or a static func of a ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"LinkerSet<@MainActor () -> Void>","type":"codeVoice"},{"text":", read on the main actor","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"struct Login: AnalyticsEvent","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"@LinkerSetEntry","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LinkerSet<Any.Type>"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"struct Login: AnalyticsEvent","type":"codeVoice"},{"text":", with a macro requiring ","type":"text"},{"code":"AnalyticsEvent","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LinkerSet<any AnalyticsEvent.Type>"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"A record of the right kind but another type is left out of "},{"type":"codeVoice","code":"values"},{"type":"text","text":". Nothing traps, and nothing"},{"type":"text","text":" "},{"type":"text","text":"throws: a set with no matching records is empty."}],"type":"paragraph"},{"text":"Order","type":"heading","level":3,"anchor":"Order"},{"inlineContent":[{"type":"text","text":"Records come back image by image in the order the loader lists them (the program, then its"},{"type":"text","text":" "},{"type":"text","text":"libraries, then each library loaded later), and within an image in the order the linker laid them"},{"type":"text","text":" "},{"type":"text","text":"out. The order is stable from one read to the next while nothing new is loaded, but it isn’t one"},{"type":"text","text":" "},{"type":"text","text":"you choose. Sort the values when order matters:"}],"type":"paragraph"},{"code":["let migrations = LinkerSet<Migration>(kind: .migrations).values.sorted { $0.version < $1.version }"],"type":"codeListing","syntax":"swift"},{"text":"When records are read","type":"heading","level":3,"anchor":"When-records-are-read"},{"inlineContent":[{"type":"text","text":"Nothing runs at launch. Each read of "},{"type":"codeVoice","code":"values"},{"type":"text","text":" or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/records"},{"type":"text","text":" asks the loader for its"},{"type":"text","text":" "},{"type":"text","text":"images and walks their records, so a read after "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":" includes the new library’s records. A read"},{"type":"text","text":" "},{"type":"text","text":"walks every record of every kind, O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") in their number; keep the result rather than reading it in"},{"type":"text","text":" "},{"type":"text","text":"a hot loop."}],"type":"paragraph"},{"text":"Records one at a time","type":"heading","level":3,"anchor":"Records-one-at-a-time"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/records"},{"type":"text","text":" gives the records themselves, of the set’s kind, before any type is asked"},{"type":"text","text":" "},{"type":"text","text":"for. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/value(as:)"},{"type":"text","text":" asks one record for a value and says why it can’t produce one:"}],"type":"paragraph"},{"code":["for record in LinkerSet<Route>(kind: .routes).records {","    do {","        let route = try record.value(as: Route.self)","        print(route.path)","    } catch .typeMismatch {","        \/\/ A record of this kind that holds something else.","    } catch {","        \/\/ .emptySlot or .unsupportedVersion: the set already leaves these out.","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A record whose reserved fields aren’t zero was written by a newer layout of the library; the set"},{"type":"text","text":" "},{"type":"text","text":"skips it rather than call an accessor whose contract it doesn’t know."}],"type":"paragraph"},{"text":"Records the linker never saw","type":"heading","level":3,"anchor":"Records-the-linker-never-saw"},{"inlineContent":[{"text":"A record is in the program only if its module is. SwiftPM and Bazel link every module a target","type":"text"},{"text":" ","type":"text"},{"text":"depends on, so a module whose only job is to declare records still reaches the program. A build","type":"text"},{"text":" ","type":"text"},{"text":"that links a static library’s members only when something calls into them leaves such a module","type":"text"},{"text":" ","type":"text"},{"text":"out. Link it whole: ","type":"text"},{"type":"codeVoice","code":"-force_load"},{"text":" on Apple platforms, ","type":"text"},{"type":"codeVoice","code":"--whole-archive"},{"text":" on Linux.","type":"text"}],"type":"paragraph"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords"},"seeAlsoSections":[{"anchor":"Guides","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","doc:\/\/LinkerSets\/documentation\/LinkerSets\/UniqueKeys","doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking","doc:\/\/LinkerSets\/documentation\/LinkerSets\/Performance"],"title":"Guides","generated":true}],"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets"]]},"kind":"article","metadata":{"modules":[{"name":"LinkerSets"}],"title":"Finding records","role":"article","roleHeading":"Article"},"abstract":[{"type":"text","text":"Read every declaration of a kind, as the type you expect."}],"references":{"doc://LinkerSetsRuntime/documentation/LinkerSetsRuntime/LinkerSet/values":{"type":"topic","kind":"symbol","url":"\/documentation\/linkersetsruntime\/linkerset\/values","abstract":[{"type":"text","text":"The value of each record that produces a "},{"code":"Value","type":"codeVoice"},{"type":"te