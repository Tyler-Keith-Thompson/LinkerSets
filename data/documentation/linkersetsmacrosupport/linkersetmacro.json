{"abstract":[{"text":"A macro that turns the declaration it’s attached to into a linker-set record of one kind.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/recordMacroName"],"generated":true,"anchor":"Type-Properties","title":"Type Properties"},{"identifiers":["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/kind(of:)","doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/kindArgument(of:)","doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/recordPeers(of:providingPeersOf:in:)","doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/refusal(of:providingPeersOf:in:)","doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/requiredConformance(of:)","doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/uniqueKey(of:attribute:)","doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/uniqueKeyArgument(of:)"],"generated":true,"anchor":"Type-Methods","title":"Type Methods"}],"seeAlsoSections":[{"identifiers":["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetRecordMacro"],"generated":true,"anchor":"Declaring-a-macro","title":"Declaring a macro"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetMacro"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiftSyntaxMacros9PeerMacroP","text":"PeerMacro"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"A client declares its own macro by conforming a type in its compiler plugin and returning"},{"type":"text","text":" "},{"type":"text","text":"its kind; the expansion is shared:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import LinkerSetsMacroSupport","import SwiftCompilerPlugin","","@main","struct RoutesPlugin: CompilerPlugin {","    let providingMacros: [any Macro.Type] = [RouteMacro.self]","}","","public enum RouteMacro: LinkerSetMacro {","    public static func kind(of attribute: AttributeSyntax) -> UInt32 { 0x726F_7574 }","}"]},{"inlineContent":[{"type":"text","text":"The expansion is one peer, "},{"code":"#linkerSetRecord(kind:storing:)","type":"codeVoice"},{"type":"text","text":" ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetRecordMacro"},{"type":"text","text":"), which"},{"type":"text","text":" "},{"type":"text","text":"the LinkerSets module declares and which expands in turn to a private "},{"code":"@used","type":"codeVoice"},{"type":"text","text":" declaration,"},{"type":"text","text":" "},{"type":"text","text":"placed with "},{"code":"@section","type":"codeVoice"},{"type":"text","text":" in the section LinkerSets owns, whose accessor produces the declaration’s"},{"type":"text","text":" "},{"type":"text","text":"value:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a static property’s or a global variable’s value;"}]}]},{"content":[{"inlineContent":[{"text":"a static or free function, as a value of its function type;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"a struct, enum, class or actor, as its metatype: ","type":"text"},{"code":"any P.Type","type":"codeVoice"},{"text":" when","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/requiredConformance(of:)","type":"reference"},{"text":" names a protocol ","type":"text"},{"code":"P","type":"codeVoice"},{"text":", which the type must then conform to or the","type":"text"},{"text":" ","type":"text"},{"text":"expansion doesn’t compile, and ","type":"text"},{"code":"Any.Type","type":"codeVoice"},{"text":" otherwise.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A function isolated to the main actor, by its own "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" or its type’s or extension’s,"},{"type":"text","text":" "},{"type":"text","text":"is stored as its isolated type ("},{"type":"codeVoice","code":"@MainActor () -> Void"},{"type":"text","text":"), read with"},{"type":"text","text":" "},{"type":"codeVoice","code":"LinkerSet<@MainActor () -> Void>"},{"type":"text","text":" and called on the main actor. A property isolated to the"},{"type":"text","text":" "},{"type":"text","text":"main actor is refused, since the record’s nonisolated accessor can’t read it: one marked"},{"type":"text","text":" "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":", or a "},{"type":"codeVoice","code":"var"},{"type":"text","text":" of a "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" type. Only a written "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" is seen. A custom"},{"type":"text","text":" "},{"type":"text","text":"global actor’s attribute, and isolation a type inherits from a protocol it conforms to, can’t"},{"type":"text","text":" "},{"type":"text","text":"be seen in the syntax, so a member isolated that way fails to compile inside the expansion."}],"type":"paragraph"},{"inlineContent":[{"text":"It diagnoses anything else, each with a message of its own: generic functions and types,","type":"text"},{"text":" ","type":"text"},{"text":"members of generic types, instance members, protocol requirements, declarations inside a","type":"text"},{"text":" ","type":"text"},{"text":"function, closure or accessor, a kind that isn’t a 32-bit literal other than 0, and a unique key","type":"text"},{"text":" ","type":"text"},{"text":"that is empty or sits in a private or fileprivate type.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Before swift-syntax 600 a macro can’t see its lexical context. There a type it registers must"},{"type":"text","text":" "},{"type":"text","text":"be declared at file scope, and the compiler, not the macro, refuses a local declaration or a"},{"type":"text","text":" "},{"type":"text","text":"member of a generic type, with an error in the expansion."}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/LinkerSetsMacroSupport\/s16SendableMetatypeP","doc:\/\/LinkerSetsMacroSupport\/17SwiftSyntaxMacros13AttachedMacroP","doc:\/\/LinkerSetsMacroSupport\/17SwiftSyntaxMacros5MacroP","doc:\/\/LinkerSetsMacroSupport\/17SwiftSyntaxMacros9PeerMacroP"],"type":"inheritsFrom","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersetsmacrosupport\/linkersetmacro"]}],"identifier":{"url":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport"]]},"metadata":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetMacro","kind":"identifier"}],"roleHeading":"Protocol","modules":[{"name":"LinkerSetsMacroSupport"}],"navigatorTitle":[{"kind":"identifier","text":"LinkerSetMacro"}],"role":"symbol","title":"LinkerSetMacro","remoteSource":{"fileName":"LinkerSetMacro.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSetsMacroSupport\/LinkerSetMacro.swift#L51"},"symbolKind":"protocol","externalID":"s:22LinkerSetsMacroSupport0a3SetC0P"},"sections":[],"references":{"doc: