ive it a macro with the kind fixed, such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Route"},{"type":"text","text":", from its own compiler plugin. The LinkerSetsMacroSupport module’s documentation shows"},{"type":"text","text":" "},{"type":"text","text":"how."}]}],"kind":"content"}],"abstract":[{"text":"Declarations that register themselves at compile time and are found at run time across every module a program links.","type":"text"}],"topicSections":[{"title":"Guides","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking"],"anchor":"Guides"},{"title":"Declaring records","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)"],"anchor":"Declaring-records"},{"title":"Macros","generated":true,"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/linkerSetRecord(kind:storing:)"],"anchor":"Macros"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersets"]}],"sections":[],"references":{"doc://LinkerSets/documentation/LinkerSets/LinkerSetEntry(kind:)":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Declares a record of "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" whose value is this declaration’s."}],"title":"LinkerSetEntry(kind:)","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)","role":"symbol","url":"\/documentation\/linkersets\/linkersetentry(kind:)","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetEntry"},{"kind":"text","text":"("},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UInt32","preciseIdentifier