},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"UInt8","preciseIdentifier":"s:s5UInt8V"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"UInt8","preciseIdentifier":"s:s5UInt8V"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"UInt8","preciseIdentifier":"s:s5UInt8V"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"UInt8","preciseIdentifier":"s:s5UInt8V"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"UInt8","preciseIdentifier":"s:s5UInt8V"},{"kind":"text","text":"), record"},{"kind":"text","text":": "},{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","kind":"typeIdentifier","text":"LinkerSetRecord","preciseIdentifier":"s:10LinkerSets0A9SetRecordV"},{"kind":"text","text":"."},{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Literal","kind":"typeIdentifier","text":"Literal","preciseIdentifier":"s:10LinkerSets0A9SetRecordV7Literala"},{"kind":"text","text":")"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In an ELF image the records sit in the note section "},{"type":"codeVoice","code":".note.linker_sets"},{"type":"text","text":", which the linker"},{"type":"text","text":" "},{"type":"text","text":"covers with a "},{"type":"codeVoice","code":"PT_NOTE"},{"type":"text","text":" program header, so "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet"},{"type":"text","text":" finds each loaded image’s records"},{"type":"text","text":" "},{"type":"text","text":"through "},{"type":"codeVoice","code":"dl_iterate_phdr"},{"type":"text","text":", a shared library’s and a "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":"ed one’s included. Each note"},{"type":"text","text":" "},{"type":"text","text":"has the standard header: "},{"type":"codeVoice","code":"nameSize"},{"type":"text","text":" 11 and "},{"type":"codeVoice","code":"name"},{"type":"text","text":" "},{"type":"codeVoice","code":"\"LinkerSets\""},{"type":"text","text":" with its terminating"},{"type":"text","text":" "},{"type":"text","text":"zero, padded to 12 bytes; "},{"type":"codeVoice","code":"descriptorSize"},{"type":"text","text":", the size of a record (32 bytes where pointers"},{"type":"text","text":" "},{"type":"text","text":"are 64 bits, 20 where they are 32); and "},{"type":"codeVoice","code":"type"},{"type":"text","text":" 1. The record follows as the descriptor:"}]},{"type":"codeListing","code":["let note: LinkerSetRecord.Note = (11, 32, 1, (76, 105, 110, 107, 101, 114, 83, 101, 116, 115, 0, 0),","                                  (0x726F_7574, 0, { outValue, type, hint, reserved in false }, 0, 0))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The 24-byte header keeps the record at its own alignment, whether a reader aligns notes to"},{"type":"text","text":" "},{"type":"text","text":"4 bytes or to 8."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord"]]},"identifier":{"url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Note","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersets\/linkersetrecord\/note"]}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://LinkerSets/documentation/LinkerSets/LinkerSetRecord/Literal":{"title":"LinkerSetRecord.Literal","navigatorTitle":[{"kind":"identifier","text":"Literal"}],"abstract":[{"text":"A record as a macro writes it: a tuple of the record’s fields, in order.","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Literal"}],"kind":"symbol","url":"\/documentation\/linkersets\/linkersetrecord\/literal","role":"symbol","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Literal","type":"topic"},"doc://LinkerSets/documentation/LinkerSets/LinkerSet":{"url":"\/documentation\/linkersets\/linkerset","type":"topic","abstract":[{"text":"Every record of one kind, across every image the program has loaded, and the values they","type":"text"},{"text":" ","type":"text"},{"text":"produce.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSet"}],"title":"LinkerSet","navigatorTitle":[{"kind":"identifier","text":"LinkerSet"}],"role":"symbol","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet"},"doc://LinkerSets/documentation/LinkerSets":{"role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/linkersets","title":"LinkerSets","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets","abstract":[{"type":"text","text":"Declarations that register themselves at compile time and are found at run time across every module a program links."}]},"doc://LinkerSets/documentation/LinkerSets/LinkerSetRecord/Note":{"abstract":[{"text":"A record as a macro writes it in an ELF image: the record, wrapped in an ELF note.","type":"text"}],"url":"\/documentation\/linkersets\/linkersetrecord\/note","title":"LinkerSetRecord.Note","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Note","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"role":"symbol","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Note"}]},"doc://LinkerSets/documentation/LinkerSets/LinkerSetRecord":{"type":"topic","navigatorTitle":[{"text":"LinkerSetRecord","kind":"identifier"}],"abstract":[{"type":"text","text":"One entry in a linker set: a record an attached macro places in the section LinkerSets owns."}],