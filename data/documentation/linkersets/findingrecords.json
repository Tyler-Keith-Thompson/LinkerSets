{"abstract":[{"type":"text","text":"Read every declaration of a kind, as the type you expect."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersets\/findingrecords"]}],"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets"]]},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet","type":"reference","isActive":true},{"text":" names a kind and a type. Its ","type":"text"},{"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/values","type":"reference","isActive":true},{"text":" are the values of every record of","type":"text"},{"text":" ","type":"text"},{"text":"that kind that produces the type:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let routes = LinkerSet<Route>(kind: .routes).values"]},{"type":"paragraph","inlineContent":[{"text":"What you ask for depends on what was marked:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Marked declaration"}]}],[{"type":"paragraph","inlineContent":[{"text":"Ask for","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"static let home = Route(path: \"\/\")","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"LinkerSet<Route>","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"static func migrate(_ db: inout Database)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"LinkerSet<(inout Database) -> Void>","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@MainActor static func show()"},{"type":"text","text":", or a static func of a "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" type"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LinkerSet<@MainActor () -> Void>"},{"text":", read on the main actor","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"struct Login: AnalyticsEvent","type":"codeVoice"},{"type":"text","text":", with "},{"code":"@LinkerSetEntry","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LinkerSet<Any.Type>"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"struct Login: AnalyticsEvent"},{"type":"text","text":", with a macro requiring "},{"type":"codeVoice","code":"AnalyticsEvent"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LinkerSet<any AnalyticsEvent.Type>"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"A record of the right kind but another type is left out of ","type":"text"},{"code":"values","type":"codeVoice"},{"text":". Nothing traps, and nothing","type":"text"},{"text":" ","type":"text"},{"text":"throws: a set with no matching records is empty.","type":"text"}]},{"level":3,"type":"heading","text":"Types registered by hand","anchor":"Types-registered-by-hand"},{"type":"paragraph","inlineContent":[{"code":"@LinkerSetEntry","type":"codeVoice"},{"text":" on a type stores it as ","type":"text"},{"code":"Any.Type","type":"codeVoice"},{"text":", so a ","type":"text"},{"code":"LinkerSet<any Step.Type>","type":"codeVoice"},{"text":" doesn’t find","type":"text"},{"text":" ","type":"text"},{"text":"it. A client macro that requires ","type":"text"},{"code":"Step","type":"codeVoice"},{"text":" stores ","type":"text"},{"code":"any Step.Type","type":"codeVoice"},{"text":"; until there is one (or in tests","type":"text"},{"text":" ","type":"text"},{"text":"that use a kind of their own), mark a static let typed as the existential metatype:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["protocol Step: SendableMetatype {","    static var name: String { get }","}","","struct First: Step { static let name = \"first\" }","","enum Steps {","    @LinkerSetEntry(kind: .steps)","    static let first: any Step.Type = First.self","}","","let steps = LinkerSet<any Step.Type>(kind: .steps).values"]},{"type":"paragraph","inlineContent":[{"code":"Step","type":"codeVoice"},{"text":" refines ","type":"text"},{"code":"SendableMetatype","type":"codeVoice"},{"text":" because a static let must be ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" in Swift 6, and","type":"text"},{"text":" ","type":"text"},{"code":"any Step.Type","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" only when the protocol says its metatypes are. Without it the","type":"text"},{"text":" ","type":"text"},{"text":"compiler warns that the property isn’t concurrency-safe (","type":"text"},{"code":"MutableGlobalVariable","type":"codeVoice"},{"text":"), which is an","type":"text"},{"text":" ","type":"text"},{"text":"error in a build that treats warnings as errors. A ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" protocol, such as a UIKit delegate","type":"text"},{"text":" ","type":"text"},{"text":"protocol, refines it the same way.","type":"text"}]},{"level":3,"type":"heading","text":"Order","anchor":"Order"},{"type":"paragraph","inlineContent":[{"text":"Records come back image by image in the order the loader lists them (the program, then its","type":"text"},{"text":" ","type":"text"},{"text":"libraries, then each library loaded later), and within an image in the order the linker laid them","type":"text"},{"text":" ","type":"text"},{"text":"out. The order is stable from one read to the next while nothing new is loaded, but it isn’t one","type":"text"},{"text":" ","type":"text"},{"text":"you choose. Sort the values when order matters:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let migrations = LinkerSet<Migration>(kind: .migrations).values.sorted { $0.version < $1.version }"]},{"level":3,"type":"heading","text":"When records are read","anchor":"When-records-are-read"},{"type":"paragraph","inlineContent":[{"text":"Nothing runs at launch. Each read of ","type":"text"},{"type":"codeVoice","code":"values"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/records","isActive":true,"type":"reference"},{"text":" asks the loader for its","type":"text"},{"text":" ","type":"text"},{"text":"images and walks their records, so a read after ","type":"text"},{"type":"codeVoice","code":"dlopen"},{"text":" includes the new library’s records. A read","type":"text"},{"text":" ","type":"text"},{"text":"walks every record of every kind, O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":") in their number; keep the result rather than reading it in","type":"text"},{"text":" ","type":"text"},{"text":"a hot loop.","type":"text"}]},{"level":3,"type":"heading","text":"Records one at a time","anchor":"Records-one-at-a-time"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/records","type":"reference","isActive":true},{"text":" gives the records themselves, of the set’s kind, before any type is asked","type":"text"},{"text":" ","type":"text"},{"text":"for. ","type":"text"},{"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/value(as:)","type":"reference","isActive":true},{"text":" asks one record for a value and says why it can’t produce one:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["for record in LinkerSet<Route>(kind: .routes).records {","    do {","        let route = try record.value(as: Route.self)","        print(route.path)","    } catch .typeMismatch {","        \/\/ A record of this kind that holds something else.","    } catch {","        \/\/ .emptySlot or .unsupportedVersion: the set already leaves these out.","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"A record whose reserved fields aren’t zero was written by a newer layout of the library; the set","type":"text"},{"text":" ","type":"text"},{"text":"skips it rather than call an accessor whose contract it doesn’t know.","type":"text"}]},{"level":3,"type":"heading","text":"Records the linker never saw","anchor":"Records-the-linker-never-saw"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record is in the program only if its module is. SwiftPM and Bazel link every module a target"},{"type":"text","text":" "},{"type":"text","text":"depends on, so a module whose only job is to declare records still reaches the program. A build"},{"type":"text","text":" "},{"type":"text","text":"that links a static library’s members only when something calls into them leaves such a module"},{"type":"text","text":" "},{"type":"text","text":"out. Link it whole: "},{"code":"-force_load","type":"codeVoice"},{"type":"text","text":" on Apple platforms, "},{"code":"--whole-archive","type":"codeVoice"},{"type":"text","text":" on Linux."}]}],"kind":"content"}],"metadata":{"role":"article","title":"Finding records","modules":[{"name":"LinkerSets"}],"roleHeading":"Article"},"identifier":{"url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","interfaceLanguage":"swift"},"kind":"article","seeAlsoSections":[{"anchor":"Guides","generated":true,"title":"Guides","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","doc:\/\/LinkerSets\/documentation\/LinkerSets\/UniqueKeys","doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking","doc:\/\/LinkerSets\/documentation\/LinkerSets\/Performance"]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://LinkerSets/documentation/LinkerSets/WhatTheMacrosRefuse":{"role":"article","abstract":[{"type":"text","text":"Every declara