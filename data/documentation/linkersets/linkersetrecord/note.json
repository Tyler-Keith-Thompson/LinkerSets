"kind":"text"},{"text":"UInt8","preciseIdentifier":"s:s5UInt8V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"UInt8","preciseIdentifier":"s:s5UInt8V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"UInt8","preciseIdentifier":"s:s5UInt8V","kind":"typeIdentifier"},{"text":"), record","kind":"text"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","text":"LinkerSetRecord","preciseIdentifier":"s:10LinkerSets0A9SetRecordV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Literal","text":"Literal","preciseIdentifier":"s:10LinkerSets0A9SetRecordV7Literala","kind":"typeIdentifier"},{"text":")","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"In an ELF image the records sit in the note section "},{"code":".note.linker_sets","type":"codeVoice"},{"type":"text","text":", which the linker"},{"type":"text","text":" "},{"type":"text","text":"covers with a "},{"code":"PT_NOTE","type":"codeVoice"},{"type":"text","text":" program header, so "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet"},{"type":"text","text":" finds each loaded image’s records"},{"type":"text","text":" "},{"type":"text","text":"through "},{"code":"dl_iterate_phdr","type":"codeVoice"},{"type":"text","text":", a shared library’s and a "},{"code":"dlopen","type":"codeVoice"},{"type":"text","text":"ed one’s included. Each note"},{"type":"text","text":" "},{"type":"text","text":"has the standard header: "},{"code":"nameSize","type":"codeVoice"},{"type":"text","text":" 11 and "},{"code":"name","type":"codeVoice"},{"type":"text","text":" "},{"code":"\"LinkerSets\"","type":"codeVoice"},{"type":"text","text":" with its terminating"},{"type":"text","text":" "},{"type":"text","text":"zero, padded to 12 bytes; "},{"code":"descriptorSize","type":"codeVoice"},{"type":"text","text":", the size of a record (32 bytes where pointers"},{"type":"text","text":" "},{"type":"text","text":"are 64 bits, 20 where they are 32); and "},{"code":"type","type":"codeVoice"},{"type":"text","text":" 1. The record follows as the descriptor:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let note: LinkerSetRecord.Note = (11, 32, 1, (76, 105, 110, 107, 101, 114, 83, 101, 116, 115, 0, 0),","                                  (0x726F_7574, 0, { outValue, type, hint, reserved in false }, 0, 0))"]},{"inlineContent":[{"type":"text","text":"The 24-byte header keeps the record at its own alignment, whether a reader aligns notes to"},{"type":"text","text":" "},{"type":"text","text":"4 bytes or to 8."}],"type":"paragraph"}]}],"metadata":{"title":"LinkerSetRecord.Note","externalID":"s:10LinkerSets0A9SetRecordV4Notea","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"role":"symbol","remoteSource":{"fileName":"LinkerSetRecord.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSets\/LinkerSetRecord.swift#L74"},"symbolKind":"typealias","navigatorTitle":[{"kind":"identifier","text":"Note"}],"roleHeading":"Type Alias","modules":[{"name":"LinkerSets"}]},"abstract":[{"text":"A record as a macro writes it in an ELF image: the record, wrapped in an ELF note.","type":"text"}],"references":{"doc://LinkerSets/documentation/LinkerSets/LinkerSetRecord/Literal":{"title":"LinkerSetRecord.Literal","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Literal","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Literal","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/linkersets\/linkersetrecord\/literal"