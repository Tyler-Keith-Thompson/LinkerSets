{"identifier":{"url":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersetsmacrosupport"]}],"topicSections":[{"anchor":"Declaring-a-macro","title":"Declaring a macro","identifiers":["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro"]},{"anchor":"Diagnostics","title":"Diagnostics","identifiers":["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacroDiagnostic"]}],"metadata":{"title":"LinkerSetsMacroSupport","externalID":"LinkerSetsMacroSupport","symbolKind":"module","modules":[{"name":"LinkerSetsMacroSupport"}],"roleHeading":"Framework","role":"collection"},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"The expansion behind every linker-set macro, for clients that declare a kind and a macro of"},{"type":"text","text":" "},{"type":"text","text":"their own."}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"code":"@LinkerSetEntry(kind:)","type":"codeVoice"},{"text":" takes its kind as an argument. A client that registers one kind of","type":"text"},{"text":" ","type":"text"},{"text":"thing (routes, events, migrations) gives it a macro that fixes the kind instead, so its users","type":"text"},{"text":" ","type":"text"},{"text":"write ","type":"text"},{"code":"@Route","type":"codeVoice"},{"text":" and never see a number. That takes three declarations.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The client’s compiler plugin, a ","type":"text"},{"code":".macro","type":"codeVoice"},{"text":" target that depends on this module, names the kind:","type":"text"}],"type":"paragraph"},{"code":["import LinkerSetsMacroSupport","import SwiftCompilerPlugin","","@main","struct RoutesMacrosPlugin: CompilerPlugin {","    let providingMacros: [any Macro.Type] = [RouteMacro.self]","}","","public enum RouteMacro: LinkerSetMacro {","    public static func kind(of attribute: AttributeSyntax) -> UInt32 { 0x726F_7574 }  \/\/ \"rout\"","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The client’s library declares the macro, the same kind, and the read of the set. It re-exports"},{"type":"text","text":" "},{"type":"text","text":"LinkerSets, because the expansion names LinkerSets’ types in its users’ files:"}],"type":"paragraph"},{"code":["@_exported import LinkerSets","","extension LinkerSetKind {","    static let routes = LinkerSetKind(rawValue: 0x726F_7574)  \/\/ \"rout\"","}","","@attached(peer)","public macro Route() = #externalMacro(module: \"RoutesMacros\", type: \"RouteMacro\")","","extension Endpoints {","    public static var all: [Endpoint] {","        LinkerSet<Endpoint>(kind: .routes).values","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Its users then register routes and read them through the library:"}],"type":"paragraph"},{"code":["enum Endpoints {","    @Route static let home = Endpoint(path: \"\/\")","}","","let endpoints = Endpoints.all"],"syntax":"swift","type":"codeListing"},{"text":"What the re-export exposes","anchor":"What-the-re-export-exposes","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The expansion is written into each user’s file and names "},{"code":"LinkerSets.LinkerSetRecord","type":"codeVoice"},{"type":"text","text":" there, so"},{"type":"text","text":" "},{"type":"text","text":"that file has to see the LinkerSets module. With "},{"code":"@_exported import LinkerSets","type":"codeVoice"},{"type":"text","text":" in the client’s"},{"type":"text","text":" "},{"type":"text","text":"library, importing the client is enough. With a plain or "},{"code":"public import","type":"codeVoice"},{"type":"text","text":", every user’s file fails"},{"type":"text","text":" "},{"type":"text","text":"to compile with “cannot find ‘LinkerSets’ in scope” until it imports LinkerSets itself. The"},{"type":"text","text":" "},{"type":"text","text":"compile tests in "},{"code":"Tests\/CompileFailures","type":"codeVoice"},{"type":"text","text":" ("},{"code":"ExportingClientUser","type":"codeVoice"},{"type":"text","text":", "},{"code":"ImportingClientUser","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"ImportingClientUserImportingLinkerSets","type":"codeVoice"},{"type":"text","text":") check each case."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"So every file that imports the client also sees "},{"type":"codeVoice","code":"LinkerSet"},{"type":"text","text":", "},{"type":"codeVoice","code":"LinkerSetKind"},{"type":"text","text":" and anything"},{"type":"text","text":" "},{"type":"text","text":"public the client adds to them. A kind constant doesn’t need to be public: the macro writes the"},{"type":"text","text":" "},{"type":"text","text":"kind as a number, so users’ files never name the constant. Keep it internal and give users the"},{"type":"text","text":" "},{"type":"text","text":"values through the client’s own API, as "},{"type":"codeVoice","code":"Endpoints.all"},{"type":"text","text":" does above. A user can still read the set"},{"type":"text","text":" "},{"type":"text","text":"by its number, "},{"type":"codeVoice","code":"LinkerSetKind(rawValue: 0x726F_7574)"},{"type":"text","text":"; an internal constant only keeps it out of"},{"type":"text","text":" "},{"type":"text","text":"autocomplete and out of the client’s public API."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro","isActive":true,"type":"reference"},{"text":" writes the same record ","type":"text"},{"code":"@LinkerSetEntry","type":"codeVoice"},{"text":" writes, in the same section, and its","type":"text"},{"text":" ","type":"text"},{"text":"diagnostics name the client’s attribute (","type":"text"},{"code":"'@Route' applies to static members only","type":"codeVoice"},{"text":"). Each kind","type":"text"},{"text":" ","type":"text"},{"text":"is a set of its own, so two clients in one program never see each other’s records as long as","type":"text"},{"text":" ","type":"text"},{"text":"their kinds differ. Kind 0 is reserved, and the expansion refuses it.","type":"text"}],"type":"paragraph"},{"text":"Registering types","anchor":"Registering-types","level":3,"type":"heading"},{"inlineContent":[{"text":"A macro attached to a struct, enum, class or actor stores the type’s metatype. To read the types","type":"text"},{"text":" ","type":"text"},{"text":"as a protocol they share, without casting, the plugin names that protocol in","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/requiredConformance(of:)","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["public enum EventMacro: LinkerSetMacro {","    public static func kind(of attribute: AttributeSyntax) -> UInt32 { 0x6576_6E74 }  \/\/ \"evnt\"","","    public static func requiredConformance(of attribute: AttributeSyntax) -> TypeSyntax? {","        \"Events.AnalyticsEvent\"","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each record then holds "},{"type":"codeVoice","code":"any AnalyticsEvent.Type"},{"type":"text","text":", read with"},{"type":"text","text":" "},{"type":"codeVoice","code":"LinkerSet<any AnalyticsEvent.Type>(kind: .events).values"},{"type":"text","text":". A type that doesn’t conform fails to"},{"type":"text","text":" "},{"type":"text","text":"compile where it’s declared: “cannot convert value of type ‘NotAnEvent.Type’ to type"},{"type":"text","text":" "},{"type":"text","text":"‘any AnalyticsEvent.Type’”. Qualify the protocol with its module so a type of the same name at"},{"type":"text","text":" "},{"type":"text","text":"the use site can’t stand in for it. Without a required protocol, a type’s record holds"},{"type":"text","text":" "},{"type":"codeVoice","code":"Any.Type"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A registered type can be nested in another from swift-syntax 600 on. Before 600 a macro can’t"},{"type":"text","text":" "},{"type":"text","text":"see where its declaration sits, so the type must be declared at file scope."}],"type":"paragraph"},{"inlineContent":[{"text":"A macro that takes its kind as an argument can return ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/kindArgument(of:)"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/kind(of:)"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Writing the expansion yourself","anchor":"Writing-the-expansion-yourself","level":3,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro","type":"reference","isActive":true},{"text":" supplies the peer ","type":"text"},{"type":"codeVoice","code":"expansion"},{"text":". A macro that needs more writes its own and","type":"text"},{"text":" ","type":"text"},{"text":"calls ","type":"text"},{"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/recordPeers(of:providingPeersOf:in:)","type":"reference","isActive":true},{"text":" from it for the record. That’s how","type":"text"},{"text":" ","type":"text"},{"text":"a macro adds the conformance as well, so its users write ","type":"text"},{"type":"codeVoice","code":"@Event struct Login {}"},{"text":" without naming","type":"text"},{"text":" ","type":"text"},{"text":"the protocol. The macro takes an extension role beside the peer:","type":"text"}],"type":"paragraph"},{"code":["public enum EventMacro: LinkerSetMacro, ExtensionMacro {","    public static func kind(of attribute: AttributeSyntax) -> UInt32 { 0x6576_6E74 }  \/\/ \"evnt\"","","    public static func requiredConformance(of attribute: AttributeSyntax) -> TypeSyntax? {","        \"Events.AnalyticsEvent\"","    }","","    \/\/ The record, as a peer.","    public static func expansion(","        of node: AttributeSyntax,","        providingPeersOf declaration: some DeclSyntaxProtocol,","        in context: some MacroExpansionContext","    ) throws -> [DeclSyntax] {","        try recordPeers(of: node, providingPeersOf: declaration, in: context)","    }","","    \/\/ The conformance the record requires, as an extension.","    public static func expansion(","        of node: AttributeSyntax,","        attachedTo declaration: some DeclGroupSyntax,","        providingExtensionsOf type: some TypeSyntaxProtocol,","        conformingTo protocols: [TypeSyntax],","        in context: some MacroExpansionContext","    ) throws -> [ExtensionDeclSyntax] {","        [try ExtensionDeclSyntax(\"extension \\(type.trimmed): Events.AnalyticsEvent {}\")]","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The library declares the macro with both roles:","type":"text"}],"type":"paragraph"},{"code":["@attached(peer)","@attached(extension, conformances: AnalyticsEvent)","public macro Event() = #externalMacro(module: \"EventsMacros\", type: \"EventMacro\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A type can then carry data of its own through the protocol (a schema, a name) while the record","type":"text"},{"text":" ","type":"text"},{"text":"holds only its metatype, read as ","type":"text"},{"type":"codeVoice","code":"LinkerSet<any AnalyticsEvent.Type>"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Skipping a record instead of refusing it","anchor":"Skipping-a-record-instead-of-refusing-it","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The expansion refuses what a record can’t hold with an error. A macro that would rather skip some"},{"type":"text","text":" "},{"type":"text","text":"of those (a generic event that its library lists by hand, say) asks"},{"type":"text","text":" "},{"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/refusal(of:providingPeersOf:in:)","type":"reference","isActive":true},{"type":"text","text":" first. It returns a"},{"type":"text","text":" "},{"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacroDiagnostic","type":"reference","isActive":true},{"type":"text","text":" whose "},{"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacroDiagnostic\/reason-swift.property","type":"reference","isActive":true},{"type":"text","text":" says why, and whose"},{"type":"text","text":" "},{"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacroDiagnostic\/node","type":"reference","isActive":true},{"type":"text","text":" is where to report it, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when the declaration can hold a"},{"type":"text","text":" "},{"type":"text","text":"record:"}],"type":"paragraph"},{"code":["public static func expansion(","    of node: AttributeSyntax,","    providingPeersOf declaration: some DeclSyntaxProtocol,","    in context: some MacroExpansionContext",") throws -> [DeclSyntax] {","    if let refusal = try refusal(of: node, providingPeersOf: declaration, in: context),","       refusal.reason == .genericType {","        context.diagnose(Diagnostic(node: refusal.node, message: GenericEventNote()))","        return []","    }","    return try recordPeers(of: node, providingPeersOf: declaration, in: context)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Every other refusal still reaches ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/recordPeers(of:providingPeersOf:in:)","type":"reference"},{"text":", which","type":"text"},{"text":" ","type":"text"},{"text":"throws it. Where a declaration sits (in a function’s body, a protocol or a generic type) is seen","type":"text"},{"text":" ","type":"text"},{"text":"from swift-syntax 600 on; before it those three aren’t returned, and the compiler refuses them in","type":"text"},{"text":" ","type":"text"},{"text":"the expansion.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport":{"url":"\/documentation\/linkersetsmacrosupport","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport","abstract":[{"type":"text","text":"The expansion behind every linker-set macro, for clients that declare a kind and a macro of"},{"type":"text","text":" "},{"type":"text","text":"their own."}],"type":"topic","kind":"symbol","role":"collection","title":"LinkerSetsMacroSupport"},"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetMacro/refusal(of:providingPeersOf:in:)":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"refusal"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11SwiftSyntax09AttributeB0V","kind":"typeIdentifier","text":"AttributeSyntax"},{"kind":"text","text":", "},{"kind":"externalParam","text":"providingPeersOf"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11SwiftSyntax04DeclB8ProtocolP","kind":"typeIdentifier","text":"DeclSyntaxProtocol"},{"kind":"text","text":", "},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:17SwiftSyntaxMacros21MacroExpansionContextP","kind":"typeIdentifier","text":"MacroExpansionContext"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:22LinkerSetsMacroSupport0a3SetC10DiagnosticV","kind":"typeIdentifier","text":"LinkerSetMacroDiagnostic"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/refusal(of:providingPeersOf:in:)","role":"symbol","title":"refusal(of:providingPeersOf:in:)","abstract":[{"text":"Why ","type":"text"},{"code":"declaration","type":"codeVoice"},{"text":" can’t hold a record, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when it can: the checks","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/recordPeers(of:providingPeersOf:in:)","type":"reference"},{"text":" makes of the declaration and of where it sits,","type":"text"},{"text":" ","type":"text"},{"text":"without writing anything.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/linkersetsmacrosupport\/linkersetmacro\/refusal(of:providingpeersof:in:)"},"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetMacro/requiredConformance(of:)":{"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/requiredConformance(of:)","url":"\/documentation\/linkersetsmacrosupport\/linkersetmacro\/requiredconformance(of:)","abstract":[{"text":"The protocol a type that ","type":"text"},{"type":"codeVoice","code":"attribute"},{"text":" registers must conform to, such as ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" ","type":"text"},{"text":"for none.","type":"text"}],"defaultImplementations":1,"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"requiredConformance","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AttributeSyntax","kind":"typeIdentifier","preciseIdentifier":"s:11SwiftSyntax09AttributeB0V"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"TypeSyntax","kind":"typeIdentifier","preciseIdentifier":"s:11SwiftSyntax04TypeB0V"},{"text":"?","kind":"text"}],"kind":"symbol","role":"symbol","required":true,"title":"requiredConformance(of:)"},"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetMacroDiagnostic/reason-swift.property":{"url":"\/documentation\/linkersetsmacrosupport\/linkersetmacrodiagnostic\/reason-swift.property","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacroDiagnostic\/reason-swift.property","abstract":[{"type":"text","text":"Why the declaration or kind is refused."}],"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reason","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:22LinkerSetsMacroSupport0a3SetC10DiagnosticV","text":"LinkerSetMacroDiagnostic","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:22LinkerSetsMacroSupport0a3SetC10DiagnosticV6ReasonO","text":"Reason","kind":"typeIdentifier"}],"kind":"symbol","role":"symbol","title":"reason"},"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetMacro":{"navigatorTitle":[{"text":"LinkerSetMacro","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/linkersetsmacrosupport\/linkersetmacro","abstract":[{"type":"text","text":"A macro that turns the declaration it’s attached to into a linker-set record of one kind."}],"kind":"symbol","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetMacro","kind":"identifier"}],"title":"LinkerSetMacro"},"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetMacroDiagnostic/node":{"url":"\/documentation\/linkersetsmacrosupport\/linkersetmacrodiagnostic\/node","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacroDiagnostic\/node","abstract":[{"text":"The node the message points at: the declaration, or the attribute for a kind.","type":"text"}],"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"node","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Syntax","preciseIdentifier":"s:11SwiftSyntax0B0V","kind":"typeIdentifier"}],"kind":"symbol","role":"symbol","title":"node"},"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetMacroDiagnostic":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetMacroDiagnostic"}],"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacroDiagnostic","role":"symbol","title":"LinkerSetMacroDiagnostic","kind":"symbol","abstract":[{"type":"text","text":"Why a linker-set macro refuses a declaration or a kind, with the message the compiler shows,"},{"type":"text","text":" "},{"type":"text","text":"naming the macro as it was written ("},{"type":"codeVoice","code":"@Route"},{"type":"text","text":"), and the node the message points at."}],"type":"topic","url":"\/documentation\/linkersetsmacrosupport\/linkersetmacrodiagnostic","navigatorTitle":[{"kind":"identifier","text":"LinkerSetMacroDiagnostic"}]},"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetMacro/recordPeers(of:providingPeersOf:in:)":{"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/recordPeers(of:providingPeersOf:in:)","url":"\/documentation\/linkersetsmacrosupport\/linkersetmacro\/recordpeers(of:providingpeersof:in:)","abstract":[{"type":"text","text":"The record that "},{"type":"codeVoice","code":"declaration"},{"type":"text","text":" becomes, as a peer, for a macro that writes its own"},{"type":"text","text":" "},{"type":"codeVoice","code":"expansion"},{"type":"text","text":" and calls this from it: to add a condition first, or beside another role, such"},{"type":"text","text":" "},{"type":"text","text":"as an extension that adds a conformance."}],"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"recordPeers","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AttributeSyntax","preciseIdentifier":"s:11SwiftSyntax09AttributeB0V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"providingPeersOf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeclSyntaxProtocol","preciseIdentifier":"s:11SwiftSyntax04DeclB8ProtocolP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MacroExpansionContext","preciseIdentifier":"s:17SwiftSyntaxMacros21MacroExpansionContextP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"DeclSyntax","preciseIdentifier":"s:11SwiftSyntax04DeclB0V","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","role":"symbol","title":"recordPeers(of:providingPeersOf:in:)"},"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetMacro/kindArgument(of:)":{"kind":"symbol","type":"topic","url":"\/documentation\/linkersetsmacrosupport\/linkersetmacro\/kindargument(of:)","title":"kindArgument(of:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kindArgument","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AttributeSyntax","preciseIdentifier":"s:11SwiftSyntax09AttributeB0V","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"UInt32","preciseIdentifier":"s:s6UInt32V","kind":"typeIdentifier"}],"abstract":[{"text":"The attribute’s ","type":"text"},{"type":"codeVoice","code":"kind:"},{"text":" argument: an integer literal from 1 through ","type":"text"},{"type":"codeVoice","code":"UInt32.max"},{"text":".","type":"text"}],"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/kindArgument(of:)","role":"symbol"},"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetMacro/kind(of:)":{"role":"symbol","url":"\/documentation\/linkersetsmacrosupport\/linkersetmacro\/kind(of:)","type":"topic","abstract":[{"text":"The kind of the record that ","type":"text"},{"code":"attribute","type":"codeVoice"},{"text":" declares, from 1 through ","type":"text"},{"code":"UInt32.max","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/kind(of:)","kind":"symbol","required":true,"title":"kind(of:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kind","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11SwiftSyntax09AttributeB0V","text":"AttributeSyntax","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:s6UInt32V","text":"UInt32","kind":"typeIdentifier"}]}}}