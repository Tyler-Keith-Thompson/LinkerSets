{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet","isActive":true},{"type":"text","text":" names a kind and a type. Its "},{"type":"reference","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/values","isActive":true},{"type":"text","text":" are the values of every record of"},{"type":"text","text":" "},{"type":"text","text":"that kind that produces the type:"}]},{"type":"codeListing","code":["let routes = LinkerSet<Route>(kind: .routes).values"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"What you ask for depends on what was marked:"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Marked declaration"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Ask for"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"static let home = Route(path: \"\/\")","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LinkerSet<Route>"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"static func migrate(_ db: inout Database)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LinkerSet<(inout Database) -> Void>"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@MainActor static func show()"},{"text":", or a static func of a ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LinkerSet<@MainActor () -> Void>"},{"type":"text","text":", read on the main actor"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"struct Login: AnalyticsEvent"},{"type":"text","text":", with "},{"type":"codeVoice","code":"@LinkerSetEntry"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LinkerSet<Any.Type>"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"struct Login: AnalyticsEvent"},{"type":"text","text":", with a macro requiring "},{"type":"codeVoice","code":"AnalyticsEvent"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LinkerSet<any AnalyticsEvent.Type>","type":"codeVoice"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"A record of the right kind but another type is left out of ","type":"text"},{"code":"values","type":"codeVoice"},{"text":". Nothing traps, and nothing","type":"text"},{"text":" ","type":"text"},{"text":"throws: a set with no matching records is empty.","type":"text"}]},{"type":"heading","text":"Types registered by hand","anchor":"Types-registered-by-hand","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@LinkerSetEntry"},{"type":"text","text":" on a type stores it as "},{"type":"codeVoice","code":"Any.Type"},{"type":"text","text":", so a "},{"type":"codeVoice","code":"LinkerSet<any Step.Type>"},{"type":"text","text":" doesn’t find"},{"type":"text","text":" "},{"type":"text","text":"it. A client macro that requires "},{"type":"codeVoice","code":"Step"},{"type":"text","text":" stores "},{"type":"codeVoice","code":"any Step.Type"},{"type":"text","text":"; until there is one (or in tests"},{"type":"text","text":" "},{"type":"text","text":"that use a kind of their own), mark a static let typed as the existential metatype:"}]},{"type":"codeListing","code":["protocol Step: SendableMetatype {","    static var name: String { get }","}","","struct First: Step { static let name = \"first\" }","","enum Steps {","    @LinkerSetEntry(kind: .steps)","    static let first: any Step.Type = First.self","}","","let steps = LinkerSet<any Step.Type>(kind: .steps).values"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Step"},{"type":"text","text":" refines "},{"type":"codeVoice","code":"SendableMetatype"},{"type":"text","text":" because a static let must be "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" in Swift 6, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"any Step.Type"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" only when the protocol says its metatypes are. Without it the"},{"type":"text","text":" "},{"type":"text","text":"compiler warns that the property isn’t concurrency-safe ("},{"type":"codeVoice","code":"MutableGlobalVariable"},{"type":"text","text":"), which is an"},{"type":"text","text":" "},{"type":"text","text":"error in a build that treats warnings as errors. A "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" protocol, such as a UIKit delegate"},{"type":"text","text":" "},{"type":"text","text":"protocol, refines it the same way."}]},{"type":"heading","text":"Order","anchor":"Order","level":3},{"type":"paragraph","inlineContent":[{"text":"Records come back image by image in the order the loader lists them (the program, then its","type":"text"},{"text":" ","type":"text"},{"text":"libraries, then each library loaded later), and within an image in the order the linker laid them","type":"text"},{"text":" ","type":"text"},{"text":"out. The order is stable from one read to the next while nothing new is loaded, but it isn’t one","type":"text"},{"text":" ","type":"text"},{"text":"you choose. Sort the values when order matters:","type":"text"}]},{"type":"codeListing","code":["let migrations = LinkerSet<Migration>(kind: .migrations).values.sorted { $0.version < $1.version }"],"syntax":"swift"},{"type":"heading","text":"When records are read","anchor":"When-records-are-read","level":3},{"type":"paragraph","inlineContent":[{"text":"Nothing runs at launch. Each read of ","type":"text"},{"type":"codeVoice","code":"values"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/records","type":"reference","isActive":true},{"text":" asks the loader for its","type":"text"},{"text":" ","type":"text"},{"text":"images and walks their records, so a read after ","type":"text"},{"type":"codeVoice","code":"dlopen"},{"text":" includes the new library’s records. A read","type":"text"},{"text":" ","type":"text"},{"text":"walks every record of every kind, O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") in their number; keep the result rather than reading it in","type":"text"},{"text":" ","type":"text"},{"text":"a hot loop.","type":"text"}]},{"type":"heading","text":"Records one at a time","anchor":"Records-one-at-a-time","level":3},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/records","isActive":true},{"type":"text","text":" gives the records themselves, of the set’s kind, before any type is asked"},{"type":"text","text":" "},{"type":"text","text":"for. "},{"type":"reference","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/value(as:)","isActive":true},{"type":"text","text":" asks one record for a value and says why it can’t produce one:"}]},{"type":"codeListing","code":["for record in LinkerSet<Route>(kind: .routes).records {","    do {","        let route = try record.value(as: Route.self)","        print(route.path)","    } catch .typeMismatch {","        \/\/ A record of this kind that holds something else.","    } catch {","        \/\/ .emptySlot or .unsupportedVersion: the set already leaves these out.","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A record whose reserved fields aren’t zero was written by a newer layout of the library; the set","type":"text"},{"text":" ","type":"text"},{"text":"skips it rather than call an accessor whose contract it doesn’t know.","type":"text"}]},{"type":"heading","text":"Records the linker never saw","anchor":"Records-the-linker-never-saw","level":3},{"type":"paragraph","inlineContent":[{"text":"A record is in the program only if its module is. SwiftPM and Bazel link every module a target","type":"text"},{"text":" ","type":"text"},{"text":"depends on, so a module whose only job is to declare records still reaches the program. A build","type":"text"},{"text":" ","type":"text"},{"text":"that links a static library’s members only when something calls into them leaves such a module","type":"text"},{"text":" ","type":"text"},{"text":"out. Link it whole: ","type":"text"},{"code":"-force_load","type":"codeVoice"},{"text":" on Apple platforms, ","type":"text"},{"code":"--whole-archive","type":"codeVoice"},{"text":" on Linux.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/linkersets\/findingrecords"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","role":"article","title":"Finding records","modules":[{"name":"LinkerSets"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets"]]},"abstract":[{"type":"text","text":"Read every declaration of a kind, as the type you expect."}],"seeAlsoSections":[{"title":"Guides","anchor":"Guides","generated":true,"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","doc:\/\/LinkerSets\/documentation\/LinkerSets\/UniqueKeys","doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking","doc:\/\/LinkerSets\/documentation\/LinkerSets\/Performance"]}],"kind":"article","sections":[],"references":{"doc://LinkerSets/documentation/LinkerSets/UniqueKeys":{"title":"Unique keys","type":"topic","url":"\/documentation\/linkersets\/u