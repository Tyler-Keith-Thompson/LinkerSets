# The tests, built once and linked into two runners; the speed-reliant ones, in Performance/, are
# LinkerSetsPerformanceTests below. Tagged `debug-only`: none of these relies on speed, so
# `--config=release` neither builds nor runs them (.bazelrc).
swift_library(
    name = "LinkerSetsTestsLibrary",
    testonly = True,
    # Tests are found through metadata the linker would otherwise drop, since nothing
    # references them by name.
    alwayslink = True,
    srcs = glob(["**/*.swift"], exclude = ["Performance/**"]),
    module_name = "LinkerSetsTests",
    tags = ["debug-only"],
    # Read by //:package_swift_test, which checks Package.swift against the Bazel graph.
    visibility = ["//:__pkg__"],
    deps = [
        "//Sources/LinkerSets",
        "//Sources/LinkerSetsRuntime",
        "//Sources/ExampleCatalog",
        "//Sources/ExampleManyRecords",
        "//Sources/ExampleRoutes",
        "//Sources/ExampleMigrations",
        "//Sources/ExampleEvents",
        "//Sources/ExamplePlugins",
        "//Sources/ExampleSessions",
        "//Tests/LinkerSetsTestSupport",
        "@swiftpkg_swift_property_based//:PropertyBased",
        "@swiftpkg_swiftprng//:Generators",
        "@swiftpkg_swiftprng//:Sampling",
    ],
)

# `bazel test` / `just test`: a standalone executable, fast to start and run in Bazel's sandbox.
swift_test(
    name = "LinkerSetsTests",
    size = "small",
    tags = ["debug-only"],
    deps = [":LinkerSetsTestsLibrary"],
)

# The generated Xcode project: a real .xctest bundle (an MH_BUNDLE), which is what Xcode's test
# runner loads. `manual` keeps it out of `bazel test //...`; it runs through xcodebuild, so it
# is only for Xcode. XCTest refuses exit tests in a sandboxed host, hence `no-sandbox`.
macos_unit_test(
    name = "LinkerSetsTestsBundle",
    bundle_name = "LinkerSetsTests",
    size = "small",
    minimum_os_version = "15.0",
    tags = ["manual", "no-sandbox"],
    # Visible so `//:xcodeproj` can name it as a top-level target.
    visibility = ["//visibility:public"],
    deps = [":LinkerSetsTestsLibrary"],
)

