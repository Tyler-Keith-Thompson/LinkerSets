{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSet","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Records are declared at compile time as ","type":"text"},{"code":"@used","type":"codeVoice"},{"text":" globals in the section LinkerSets owns. In a","type":"text"},{"text":" ","type":"text"},{"text":"Mach-O image that is ","type":"text"},{"code":"__DATA_CONST,__linker_sets","type":"codeVoice"},{"text":", each record a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/Literal","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"In an ELF image it is the note section ","type":"text"},{"code":".note.linker_sets","type":"codeVoice"},{"text":", each record wrapped in a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/Note","type":"reference"},{"text":". In a WebAssembly module it is the data section ","type":"text"},{"code":"linker_sets","type":"codeVoice"},{"text":", and in","type":"text"},{"text":" ","type":"text"},{"text":"a PE image (Windows) the grouped section ","type":"text"},{"code":".lnkset$M","type":"codeVoice"},{"text":", which the linker merges into ","type":"text"},{"code":".lnkset","type":"codeVoice"},{"text":". A","type":"text"},{"text":" ","type":"text"},{"text":"linker set finds them at run time in every image the loader has mapped: the program, the","type":"text"},{"text":" ","type":"text"},{"text":"shared libraries it was linked with, and any loaded later with ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"text":". On Apple platforms it","type":"text"},{"text":" ","type":"text"},{"text":"reads each image’s section through the loader’s list of images; on ELF platforms (Linux,","type":"text"},{"text":" ","type":"text"},{"text":"Android, FreeBSD) it reads each image’s note segments through ","type":"text"},{"code":"dl_iterate_phdr","type":"codeVoice"},{"text":"; on","type":"text"},{"text":" ","type":"text"},{"text":"WebAssembly (WASI), whose program is one statically linked module, it reads the section","type":"text"},{"text":" ","type":"text"},{"text":"between the ","type":"text"},{"code":"__start_linker_sets","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"__stop_linker_sets","type":"codeVoice"},{"text":" symbols wasm-ld defines; on Windows","type":"text"},{"text":" ","type":"text"},{"text":"it reads each loaded module’s ","type":"text"},{"code":".lnkset","type":"codeVoice"},{"text":" section through ","type":"text"},{"code":"K32EnumProcessModules","type":"codeVoice"},{"text":" and the","type":"text"},{"text":" ","type":"text"},{"text":"module’s PE section table, skipping the zero padding the linker may put between contributions:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let routes = LinkerSet<Route>(kind: .routes).values"]},{"type":"paragraph","inlineContent":[{"text":"Each read asks the loader again, so a read after a ","type":"text"},{"type":"codeVoice","code":"dlopen"},{"text":" includes the new image’s records.","type":"text"},{"text":" ","type":"text"},{"text":"Records come back image by image in the loader’s order, and within an image in the order the","type":"text"},{"text":" ","type":"text"},{"text":"linker laid them out, so two reads with no load between them return the same records in the","type":"text"},{"text":" ","type":"text"},{"text":"same order.","type":"text"},{"text":" ","type":"text"},{"text":"A kind no record was declared with gives an empty set, as does kind 0, which marks an empty","type":"text"},{"text":" ","type":"text"},{"text":"slot.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Records survive dead stripping (","type":"text"},{"type":"codeVoice","code":"-dead_strip"},{"text":", ","type":"text"},{"type":"codeVoice","code":"--gc-sections"},{"text":") in debug and release builds:","type":"text"},{"text":" ","type":"text"},{"text":"each is ","type":"text"},{"type":"codeVoice","code":"@used"},{"text":", and the section is retained. A record reaches the program only when the","type":"text"},{"text":" ","type":"text"},{"text":"linker links its module’s object file, though. SwiftPM links every object of a target’s","type":"text"},{"text":" ","type":"text"},{"text":"dependencies, and so does Bazel’s ","type":"text"},{"type":"codeVoice","code":"swift_library"},{"text":", which is ","type":"text"},{"type":"codeVoice","code":"alwayslink"},{"text":" by default. A build","type":"text"},{"text":" ","type":"text"},{"text":"that links a static archive’s members only on demand drops a module that nothing references","type":"text"},{"text":" ","type":"text"},{"text":"by name. Link such a module whole (","type":"text"},{"type":"codeVoice","code":"-force_load"},{"text":" on Mach-O, ","type":"text"},{"type":"codeVoice","code":"--whole-archive"},{"text":" on ELF).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Reading never traps. A record whose reserved fields aren’t zero, written by a newer layout, is","type":"text"},{"text":" ","type":"text"},{"text":"skipped; a section whose size isn’t a whole number of records is read up to its last whole","type":"text"},{"text":" ","type":"text"},{"text":"record; on ELF, a note that isn’t LinkerSets’, or whose record size this version doesn’t know,","type":"text"},{"text":" ","type":"text"},{"text":"is skipped.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersetsruntime\/linkerset"]}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/LinkerSetsRuntime\/s8SendableP","doc:\/\/LinkerSetsRuntime\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"seeAlsoSections":[{"identifiers":["doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord","doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetKind"],"generated":true,"anchor":"Finding-records","title":"Finding records"}],"topicSections":[{"identifiers":["doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/init(kind:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/kind","doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/records","doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/values"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"}],"kind":"symbol","metadata":{"role":"symbol","navigatorTitle":[{"text":"LinkerSet","kind":"identifier"}],"modules":[{"name":"LinkerSetsRuntime"}],"externalID":"s:17LinkerSetsRuntime0A3SetV","roleHeading":"Structure","title":"LinkerSet","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSet"}],"remoteSource":{"fileName":"LinkerSet.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSetsRuntime\/LinkerSet.swift#L41"},"symbolKind":"struct"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet"},"abstract":[{"text":"Every record of one kind, across every image the program has loaded, and the values they","type":"text"},{"text":" ","type":"text"},{"text":"produce.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime"]]},"sections":[],"references":{"doc://LinkerSetsRuntime/s8SendableP":