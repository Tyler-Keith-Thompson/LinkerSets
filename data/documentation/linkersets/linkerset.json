{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets"]]},"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/init(kind:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/kind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/records","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/values"]}],"metadata":{"modules":[{"name":"LinkerSets"}],"symbolKind":"struct","navigatorTitle":[{"text":"LinkerSet","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSet"}],"roleHeading":"Structure","externalID":"s:10LinkerSets0A3SetV","role":"symbol","remoteSource":{"fileName":"LinkerSet.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSets\/LinkerSet.swift#L41"},"title":"LinkerSet"},"abstract":[{"text":"Every record of one kind, across every image the program has loaded, and the values they","type":"text"},{"text":" ","type":"text"},{"text":"produce.","type":"text"}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/LinkerSets\/s8SendableP","doc:\/\/LinkerSets\/s16SendableMetatypeP"],"kind":"relationships"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSet","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"mentions":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords"],"kind":"mentions"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"Records are declared at compile time as ","type":"text"},{"type":"codeVoice","code":"@used"},{"text":" globals in the section LinkerSets owns. In a","type":"text"},{"text":" ","type":"text"},{"text":"Mach-O image that is ","type":"text"},{"type":"codeVoice","code":"__DATA_CONST,__linker_sets"},{"text":", each record a ","type":"text"},{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Literal","type":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"In an ELF image it is the note section ","type":"text"},{"type":"codeVoice","code":".note.linker_sets"},{"text":", each record wrapped in a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Note","type":"reference","isActive":true},{"text":". In a WebAssembly module it is the data section ","type":"text"},{"type":"codeVoice","code":"linker_sets"},{"text":", and in","type":"text"},{"text":" ","type":"text"},{"text":"a PE image (Windows) the grouped section ","type":"text"},{"type":"codeVoice","code":".lnkset$M"},{"text":", which the linker merges into ","type":"text"},{"type":"codeVoice","code":".lnkset"},{"text":". A","type":"text"},{"text":" ","type":"text"},{"text":"linker set finds them at run time in every image the loader has mapped: the program, the","type":"text"},{"text":" ","type":"text"},{"text":"shared libraries it was linked with, and any loaded later with ","type":"text"},{"type":"codeVoice","code":"dlopen"},{"text":". On Apple platforms it","type":"text"},{"text":" ","type":"text"},{"text":"reads each image’s section through the loader’s list of images; on ELF platforms (Linux,","type":"text"},{"text":" ","type":"text"},{"text":"Android, FreeBSD) it reads each image’s note segments through ","type":"text"},{"type":"codeVoice","code":"dl_iterate_phdr"},{"text":"; on","type":"text"},{"text":" ","type":"text"},{"text":"WebAssembly (WASI), whose program is one statically linked module, it reads the section","type":"text"},{"text":" ","type":"text"},{"text":"between the ","type":"text"},{"type":"codeVoice","code":"__start_linker_sets"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"__stop_linker_sets"},{"text":" symbols wasm-ld defines; on Windows","type":"text"},{"text":" ","type":"text"},{"text":"it reads each loaded module’s ","type":"text"},{"type":"codeVoice","code":".lnkset"},{"text":" section through ","type":"text"},{"type":"codeVoice","code":"K32EnumProcessModules"},{"text":" and the","type":"text"},{"text":" ","type":"text"},{"text":"module’s PE section table, skipping the zero padding the linker may put between contributions:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let routes = LinkerSet<Route>(kind: .routes).values"]},{"inlineContent":[{"type":"text","text":"Each read asks the loader again, so a read after a "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":" includes the new image’s records."},{"type":"text","text":" "},{"type":"text","text":"Records come back image by image in the loader’s order, and within an image in the order the"},{"type":"text","text":" "},{"type":"text","text":"linker laid them out, so two reads with no load between them return the same records in the"},{"type":"text","text":" "},{"type":"text","text":"same order."},{"type":"text","text":" "},{"type":"text","text":"A kind no record was declared with gives an empty set, as does kind 0, which marks an empty"},{"type":"text","text":" "},{"type":"text","text":"slot."}],"type":"paragraph"},{"inlineContent":[{"text":"Records survive dead stripping (","type":"text"},{"type":"codeVoice","code":"-dead_strip"},{"text":", ","type":"text"},{"type":"codeVoice","code":"--gc-sections"},{"text":") in debug and release builds:","type":"text"},{"text":" ","type":"text"},{"text":"each is ","type":"text"},{"type":"codeVoice","code":"@used"},{"text":", and the section is retained. A record reaches the program only when the","type":"text"},{"text":" ","type":"text"},{"text":"linker links its module’s object file, though. SwiftPM links every object of a target’s","type":"text"},{"text":" ","type":"text"},{"text":"dependencies, and so does Bazel’s ","type":"text"},{"type":"codeVoice","code":"swift_library"},{"text":", which is ","type":"text"},{"type":"codeVoice","code":"alwayslink"},{"text":" by default. A build","type":"text"},{"text":" ","type":"text"},{"text":"that links a static archive’s members only on demand drops a module that nothing references","type":"text"},{"text":" ","type":"text"},{"text":"by name. Link such a module whole (","type":"text"},{"type":"codeVoice","code":"-force_load"},{"text":" on Mach-O, ","type":"text"},{"type":"codeVoice","code":"--whole-archive"},{"text":" on ELF).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Reading never traps. A record whose reserved fields aren’t zero, written by a newer layout, is"},{"type":"text","text":" "},{"type":"text","text":"skipped; a section whose size isn’t a whole number of records is read up to its last whole"},{"type":"text","text":" "},{"type":"text","text":"record; on ELF, a note that isn’t LinkerSets’, or whose record size this version doesn’t know,"},{"type":"text","text":" "},{"type":"text","text":"is skipped."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","variants":[{"paths":["\/documentation\/linkersets\/linkerset"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Finding records","generated":true,"anchor":"Finding-records","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet"},"sections":[],"references":{"doc://LinkerSets/documentation/LinkerSets/DeclaringAKind":