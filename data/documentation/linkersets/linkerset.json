ker links its module’s object file, though. SwiftPM links every object of a target’s","type":"text"},{"text":" ","type":"text"},{"text":"dependencies, and so does Bazel’s ","type":"text"},{"code":"swift_library","type":"codeVoice"},{"text":", which is ","type":"text"},{"code":"alwayslink","type":"codeVoice"},{"text":" by default. A build","type":"text"},{"text":" ","type":"text"},{"text":"that links a static archive’s members only on demand drops a module that nothing references","type":"text"},{"text":" ","type":"text"},{"text":"by name. Link such a module whole (","type":"text"},{"code":"-force_load","type":"codeVoice"},{"text":" on Mach-O, ","type":"text"},{"code":"--whole-archive","type":"codeVoice"},{"text":" on ELF).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reading never traps. A record whose reserved fields aren’t zero, written by a newer layout, is"},{"type":"text","text":" "},{"type":"text","text":"skipped; a section whose size isn’t a whole number of records is read up to its last whole"},{"type":"text","text":" "},{"type":"text","text":"record."}]}]}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/LinkerSets\/s8SendableP","doc:\/\/LinkerSets\/s16SendableMetatypeP"]}],"kind":"symbol","sections":[],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSet","kind":"identifier"}],"modules":[{"name":"LinkerSets"}],"title":"LinkerSet","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSets\/LinkerSet.swift#L31","fileName":"LinkerSet.swift"},"externalID":"s:10LinkerSets0A3SetV","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"LinkerSet"}],"roleHeading":"Structure"},"references":{"doc://LinkerSets/documentation/LinkerSets/LinkerSetRecord/Literal":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "}