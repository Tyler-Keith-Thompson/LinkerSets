ro by conforming a type in its compiler plugin and returning"},{"type":"text","text":" "},{"type":"text","text":"its kind; the expansion is shared:"}]},{"code":["import LinkerSetsMacroSupport","import SwiftCompilerPlugin","","@main","struct RoutesPlugin: CompilerPlugin {","    let providingMacros: [any Macro.Type] = [RouteMacro.self]","}","","public enum RouteMacro: LinkerSetMacro {","    public static func kind(of attribute: AttributeSyntax) -> UInt32 { 0x726F_7574 }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The expansion is one peer, ","type":"text"},{"type":"codeVoice","code":"#linkerSetRecord(kind:storing:)"},{"text":" (","type":"text"},{"isActive":true,"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetRecordMacro","type":"reference"},{"text":"), which","type":"text"},{"text":" ","type":"text"},{"text":"the LinkerSets module declares and which expands in turn to a private ","type":"text"},{"type":"codeVoice","code":"@used"},{"text":" declaration,","type":"text"},{"text":" ","type":"text"},{"text":"placed with ","type":"text"},{"type":"codeVoice","code":"@section"},{"text":" in the section LinkerSets owns, whose accessor produces the declaration’s","type":"text"},{"text":" ","type":"text"},{"text":"value:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"a static property’s or a global variable’s value;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a static or free function, as a value of its function type;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"a struct, enum, class or actor, as its metatype: ","type":"text"},{"type":"codeVoice","code":"any P.Type"},{"text":" when","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/re