{"hierarchy":{"paths":[["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetMacro"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiftSyntaxMacros9PeerMacroP","text":"PeerMacro"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A client declares its own macro by conforming a type in its compiler plugin and returning"},{"type":"text","text":" "},{"type":"text","text":"its kind; the expansion is shared:"}]},{"type":"codeListing","code":["import LinkerSetsMacroSupport","import SwiftCompilerPlugin","","@main","struct RoutesPlugin: CompilerPlugin {","    let providingMacros: [any Macro.Type] = [RouteMacro.self]","}","","public enum RouteMacro: LinkerSetMacro {","    public static func kind(of attribute: AttributeSyntax) -> UInt32 { 0x726F_7574 }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The expansion is a private "},{"code":"@used","type":"codeVoice"},{"type":"text","text":" peer, placed with "},{"code":"@section","type":"codeVoice"},{"type":"text","text":" in the section LinkerSets"},{"type":"text","text":" "},{"type":"text","text":"owns, whose accessor produces the declaration’s value:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"a static property’s or a global variable’s value;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"a static or free function, as a value of its function type;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"a struct, enum, class or actor, as its metatype: "},{"type":"codeVoice","code":"any P.Type"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/requiredConformance(of:)","isActive":true},{"type":"text","text":" names a protocol "},{"type":"codeVoice","code":"P"},{"type":"text","text":", which the type must then conform to or the"},{"type":"text","text":" "},{"type":"text","text":"expansion doesn’t compile, and "},{"type":"codeVoice","code":"Any.Type"},{"type":"text","text":" otherwise."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A function isolated to the main actor, by its own "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" or its type’s or extension’s,"},{"type":"text","text":" "},{"type":"text","text":"is stored as its isolated type ("},{"type":"codeVoice","code":"@MainActor () -> Void"},{"type":"text","text":"), read with"},{"type":"text","text":" "},{"type":"codeVoice","code":"LinkerSet<@MainActor () -> Void>"},{"type":"text","text":" and called on the main actor. A property isolated to the"},{"type":"text","text":" "},{"type":"text","text":"main actor is refused, since the record’s nonisolated accessor can’t read it: one marked"},{"type":"text","text":" "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":", or a "},{"type":"codeVoice","code":"var"},{"type":"text","text":" of a "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" type. Only a written "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" is seen. A custom"},{"type":"text","text":" "},{"type":"text","text":"global actor’s attribute, and isolation a type inherits from a protocol it conforms to, can’t"},{"type":"text","text":" "},{"type":"text","text":"be seen in the syntax, so a member isolated that way fails to compile inside the expansion."}]},{"type":"paragraph","inlineContent":[{"text":"It diagnoses anything else, each with a message of its own: generic functions and types,","type":"text"},{"text":" ","type":"text"},{"text":"members of generic types, instance members, protocol requirements, declarations inside a","type":"text"},{"text":" ","type":"text"},{"text":"function, closure or accessor, and a kind that isn’t a 32-bit literal other than 0.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Before swift-syntax 600 a macro can’t see its lexical context. There a type it registers must","type":"text"},{"text":" ","type":"text"},{"text":"be declared at file scope, and the compiler, not the macro, refuses a local declaration or a","type":"text"},{"text":" ","type":"text"},{"text":"member of a generic type, with an error in the expansion.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/linkersetsmacrosupport\/linkersetmacro"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"modules":[{"name":"LinkerSetsMacroSupport"}],"externalID":"s:22LinkerSetsMacroSupport0a3SetC0P","role":"symbol","title":"LinkerSetMacro","symbolKind":"protocol","remoteSource":{"fileName":"LinkerSetMacro.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSetsMacroSupport\/LinkerSetMacro.swift#L48"},"roleHeading":"Protocol","navigatorTitle":[{"text":"LinkerSetMacro","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetMacro"}]},"abstract":[{"text":"A macro that turns the declaration it’s attached to into a linker-set record of one kind.","type":"text"}],"topicSections":[{"generated":true,"anchor":"Type-Methods","identifiers":["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/kind(of:)","doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/Li