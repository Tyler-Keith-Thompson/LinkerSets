{"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/LinkerSets\/s8SendableP","doc:\/\/LinkerSets\/s16SendableMetatypeP"]}],"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet"},"seeAlsoSections":[{"title":"Finding records","anchor":"Finding-records","generated":true,"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind"]}],"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/init(kind:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/kind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/records","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/values"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersets\/linkerset"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSet"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">"}]}]},{"mentions":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking"],"kind":"mentions"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Records are declared at compile time as "},{"code":"@used","type":"codeVoice"},{"type":"text","text":" globals in the section LinkerSets owns. In a"},{"type":"text","text":" "},{"type":"text","text":"Mach-O image that is "},{"code":"__DATA_CONST,__linker_sets","type":"codeVoice"},{"type":"text","text":", each record a "},{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Literal","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"In an ELF image it is the note section "},{"code":".note.linker_sets","type":"codeVoice"},{"type":"text","text":", each record wrapped in a"},{"type":"text","text":" "},{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Note","type":"reference","isActive":true},{"type":"text","text":". In a WebAssembly module it is the data section "},{"code":"linker_sets","type":"codeVoice"},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"text","text":"linker set finds them at run time in every image the loader has mapped: the program, the"},{"type":"text","text":" "},{"type":"text","text":"shared libraries it was linked with, and any loaded later with "},{"code":"dlopen","type":"codeVoice"},{"type":"text","text":". On Apple platforms it"},{"type":"text","text":" "},{"type":"text","text":"reads each image’s section through the loader’s list of images; on ELF platforms (Linux,"},{"type":"text","text":" "},{"type":"text","text":"Android, FreeBSD) it reads each image’s note segments through "},{"code":"dl_iterate_phdr","type":"codeVoice"},{"type":"text","text":"; on"},{"type":"text","text":" "},{"type":"text","text":"WebAssembly (WASI), whose program is one statically linked module, it reads the section"},{"type":"text","text":" "},{"type":"text","text":"between the "},{"code":"__start_linker_sets","type":"codeVoice"},{"type":"text","text":" and "},{"code":"__stop_linker_sets","type":"codeVoice"},{"type":"text","text":" symbols wasm-ld defines:"}],"type":"paragraph"},{"syntax":"swift","code":["let routes = LinkerSet<Route>(kind: .routes).values"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each read asks the loader again, so a read after a "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":" includes the new image’s records."},{"type":"text","text":" "},{"type":"text","text":"Records come back image by image in the loader’s order, and within an image in the order the"},{"type":"text","text":" "},{"type":"text","text":"linker laid them out, so two reads with no load between them return the same records in the"},{"type":"text","text":" "},{"type":"text","text":"same order."},{"type":"text","text":" "},{"type":"text","text":"A kind no record was declared with gives an empty set, as does kind 0, which marks an empty"},{"type":"text","text":" "},{"type":"text","text":"slot."}],"type":"paragraph"},{"inlineContent":[{"text":"Records survive dead stripping (","type":"text"},{"type":"codeVoice","code":"-dead_strip"},{"text":", ","type":"text"},{"type":"codeVoice","code":"--gc-sections"},{"text":") in debug and release builds:","type":"text"},{"text":" ","type":"text"},{"text":"each is ","type":"text"},{"type":"codeVoice","code":"@used"},{"text":", and the section is retained. A record reaches the program only when the","type":"text"},{"text":" ","type":"text"},{"text":"linker links its module’s object file, though. SwiftPM links every object of a target’s","type":"text"},{"text":" ","type":"text"},{"text":"dependencies, and so does Bazel’s ","type":"text"},{"type":"codeVoice","code":"swift_library"},{"text":", which is ","type":"text"},{"type":"codeVoice","code":"alwayslink"},{"text":" by default. A build","type":"text"},{"text":" ","type":"text"},{"text":"that links a static archive’s members only on demand drops a module that nothing references","type":"text"},{"text":" ","type":"text"},{"text":"by name. Link such a module whole (","type":"text"},{"type":"codeVoice","code":"-force_load"},{"text":" on Mach-O, ","type":"text"},{"type":"codeVoice","code":"--whole-archive"},{"text":" on ELF).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Reading never traps. A record whose reserved fields aren’t zero, written by a newer layout, is","type":"text"},{"text":" ","type":"text"},{"text":"skipped; a section whose size isn’t a whole number of records is read up to its last whole","type":"text"},{"text":" ","type":"text"},{"text":"record; on ELF, a note that isn’t LinkerSets’, or whose record size this version doesn’t know,","type":"text"},{"text":" ","type":"text"},{"text":"is skipped.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"title":"LinkerSet","externalID":"s:10LinkerSets0A3SetV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSet"}],"role":"symbol","remoteSource":{"fileName":"LinkerSet.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSets\/LinkerSet.swift#L38"},"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"LinkerSet"}],"roleHeading":"Structure","modules":[{"name":"LinkerSets"}]},"abstract":[{"text":"Every record of one kind, across every image the program has loaded, and the values they","type":"text"},{"text":" ","type":"text"},{"text":"produce.","type":"text"}],"references":{"doc://LinkerSets/documentation/LinkerSets/LinkerSet/kind":{"type":"topic","role":"symbol","abstract":[{"text":"The kind of record this set holds.","type":"text"}],"kind":"symbol","title":"kind","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"kind"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10LinkerSets0A7SetKindV","kind":"typeIdentifier","text":"LinkerSetKind"}],"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/kind","url":"\/documentation\/linkersets\/linkerset\/kind"},"doc://LinkerSets/documentation/LinkerSets/DeclaringAKind":{"abstract":[{"text":"Pick the number tha