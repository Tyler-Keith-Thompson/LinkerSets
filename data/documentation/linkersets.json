{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Declarations that register themselves at compile time and are found at run time across every module a program links."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSets\/documentation\/LinkerSets"},"topicSections":[{"title":"Guides","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","doc:\/\/LinkerSets\/documentation\/LinkerSets\/UniqueKeys","doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking","doc:\/\/LinkerSets\/documentation\/LinkerSets\/Performance"],"anchor":"Guides"},{"title":"Declaring records","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:uniqueKey:)"],"anchor":"Declaring-records"},{"title":"Macros","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/linkerSetRecord(kind:storing:)"],"generated":true,"anchor":"Macros"}],"sections":[],"metadata":{"symbolKind":"module","modules":[{"name":"LinkerSets"}],"roleHeading":"Framework","role":"collection","externalID":"LinkerSets","title":"LinkerSets"},"hierarchy":{"paths":[[]]},"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"An attached macro emits a small record into a section LinkerSets owns, and a typed run-time API"},{"type":"text","text":" "},{"type":"text","text":"enumerates every record of one kind in a deterministic order. Each record carries a kind, so"},{"type":"text","text":" "},{"type":"text","text":"clients share the mechanism without seeing each other’s records. Failures are typed errors; the"},{"type":"text","text":" "},{"type":"text","text":"run-time API never traps."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A declaration registers itself with "},{"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)","isActive":true},{"type":"text","text":", tagged with a kind: four ASCII"},{"type":"text","text":" "},{"type":"text","text":"characters read as a 32-bit integer. A "},{"type":"reference","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet","isActive":true},{"type":"text","text":" of that kind finds every such declaration"},{"type":"text","text":" "},{"type":"text","text":"at run time:"}],"type":"paragraph"},{"syntax":"swift","code":["import LinkerSets","","enum Routes {","    @LinkerSetEntry(kind: 0x726F_7574)  \/\/ \"rout\"","    static let home = Route(path: \"\/\")","}","","let routes = LinkerSet<Route>(kind: LinkerSetKind(rawValue: 0x726F_7574)).values"],"type":"codeListing"},{"inlineContent":[{"text":"A client that registers one kind of thing can give it a macro with the kind fixed, such as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@Route"},{"text":", from its own compiler plugin. The LinkerSetsMacroSupport module’s documentation shows","type":"text"},{"text":" ","type":"text"},{"text":"how.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/linkersets"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://LinkerSets/documentation/LinkerSets/linkerSetRecord(kind:storing:)":{"kind":"symbol","type":"topic","url":"\/documentation\/linkersets\/linkersetrecord(kind:storing:)","abstract":[{"type":"text","text":"Declares a record of "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" whose accessor stores "},{"type":"codeVoice","code":"value"},{"type":"text","text":": what every linker-set macro’s"},{"type":"text","text":" "},{"type":"text","text":"expansion calls."}],"role":"symbol","fragments":[{"text