ingpeersof:in:)","role":"symbol"},"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetMacro":{"abstract":[{"type":"text","text":"A macro that turns the declaration it’s attached to into a linker-set record of one kind."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetMacro"}],"type":"topic","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro","title":"LinkerSetMacro","url":"\/documentation\/linkersetsmacrosupport\/linkersetmacro","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LinkerSetMacro"}]},"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetMacro/kindArgument(of:)":{"title":"kindArgument(of:)","role":"symbol","type":"topic","url":"\/documentation\/linkersetsmacrosupport\/linkersetmacro\/kindargument(of:)","abstract":[{"text":"The attribute’s ","type":"text"},{"code":"kind:","type":"codeVoice"},{"text":" argument: an integer literal from 1 through ","type":"text"},{"code":"UInt32.max","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kindArgument"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"AttributeSyntax","preciseIdentifier":"s:11SwiftSyntax09AttributeB0V"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"UInt32","preciseIdentifier":"s:s6UInt32V"}],"kind":"symbol","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/kindArgument(of:)"},"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetMacro/requiredConformance(of:)":{"abstract":[{"text":"The protocol a type that ","type":"text"},{"type":"codeVoice","code":"attribute"},{"text":" registers must conform to, such as ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" ","type":"text"},{"text":"for none.","type":"text"}],"defaultImplementations":1,"required":true,"kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"requiredConformance"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11SwiftSyntax09AttributeB0V","text":"AttributeSyntax"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11SwiftSyntax04TypeB0V","text":"TypeSyntax"},{"kind":"text","text":"?"}],"url":"\/documentation\/linkersetsmacrosupport\/linkersetmacro\/requiredconformance(of:)","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/requiredConformance(of:)","type":"topic","title":"requiredConformance(of:)","role":"symbol"},"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetMacro/recordPeers(of:providingPeersOf:in:)":{"type":"topic","abstract":[{"type":"text","text":"The record that "},{"type":"codeVoice","code":"declaration"},{"type":"text","text":" becomes, as a peer, for a macro that writes its own"},{"type":"text","text":" "},{"type":"codeVoice","code":"expansion"},{"type":"text","text":" and calls this from it: to add a condition first, or beside another role, such"},{"type":"text","text":" "},{"type":"text","text":"as an extension that adds a conformance."}],"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/recordPeers(of:providingPeersOf:in:)","title":"recordPeers(of:providingPeersOf:in:)","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"recordPeers","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AttributeSyntax","preciseIdentifier":"s:11SwiftSyntax09AttributeB0V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"providingPeersOf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeclSyntaxProtocol","preciseIdentifier":"s:11SwiftSyntax04DeclB8ProtocolP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MacroExpansionContext","preciseIdentifier":"s:17SwiftSyntaxMacros21MacroExpansionContextP","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"DeclSyntax","preciseIdentifier":"s:11SwiftSyntax04DeclB0V","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/linkersetsmacrosupport\/linkersetmacro\/recordpeers(of:providingpeersof:in:)","role":"symbol"},"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport":{"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport","title":"LinkerSetsMacroSupport","abstract":[{"text":"The expansion behind every linker-set macro, for clients that declare a kind and a macro of","type":"text"},{"text":" ","type":"text"},{"text":"their own.","type":"text"}],"role":"collection","kind":"symbol","url":"\/documentation\/linkersetsmacrosupport","type":"topic"}}}