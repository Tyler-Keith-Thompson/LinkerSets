cle","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/Performance","abstract":[{"type":"text","text":"What records cost as an app grows: nothing at launch, a walk of the records when a set is read,"},{"type":"text","text":" "},{"type":"text","text":"and a few milliseconds of build time per marked declaration."}],"kind":"article","title":"Performance"}}}