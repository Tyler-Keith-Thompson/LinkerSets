{"metadata":{"remoteSource":{"fileName":"LinkerSetMacro.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSetsMacroSupport\/LinkerSetMacro.swift#L59"},"title":"LinkerSetMacro","modules":[{"name":"LinkerSetsMacroSupport"}],"externalID":"s:22LinkerSetsMacroSupport0a3SetC0P","roleHeading":"Protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetMacro"}],"symbolKind":"protocol","navigatorTitle":[{"text":"LinkerSetMacro","kind":"identifier"}],"role":"symbol"},"topicSections":[{"identifiers":["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/recordMacroName"],"anchor":"Type-Properties","title":"Type Properties","generated":true},{"identifiers":["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/kind(of:)","doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/kindArgument(of:)","doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/recordPeers(of:providingPeersOf:in:)","doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/refusal(of:providingPeersOf:in:)","doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/requiredConformance(of:)","doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/uniqueKey(of:attribute:)","doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/uniqueKeyArgument(of:)"],"anchor":"Type-Methods","title":"Type Methods","generated":true}],"seeAlsoSections":[{"identifiers":["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetRecordMacro"],"anchor":"Declaring-a-macro","title":"Declaring a macro","generated":true}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetMacro"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:17SwiftSyntaxMacros9PeerMacroP","kind":"typeIdentifier","text":"PeerMacro"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A client declares its own macro by conforming a type in its compiler plugin and returning","type":"text"},{"text":" ","type":"text"},{"text":"its kind; the expansion is shared:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import LinkerSetsMacroSupport","import SwiftCompilerPlugin","","@main","struct RoutesPlugin: CompilerPlugin {","    let providingMacros: [any Macro.Type] = [RouteMacro.self]","}","","public enum RouteMacro: LinkerSetMacro {","    public static func kind(of attribute: AttributeSyntax) -> UInt32 { 0x726F_7574 }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The expansion is one peer, "},{"type":"codeVoice","code":"#linkerSetRecord(kind:storing:)"},{"type":"text","text":" ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetRecordMacro"},{"type":"text","text":"), which"},{"type":"text","text":" "},{"type":"text","text":"the LinkerSets module declares and which expands in turn to a private "},{"type":"codeVoice","code":"@used"},{"type":"text","text":" declaration,"},{"type":"text","text":" "},{"type":"text","text":"placed with "},{"type":"codeVoice","code":"@section"},{"type":"text","text":" in the section LinkerSets owns, whose accessor produces the declaration’s"},{"type":"text","text":" "},{"type":"text","text":"value:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"a static property’s or a global variable’s value;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"a static or free function, as a value of its function type;","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"a struct, enum, class or actor, as its metatype: "},{"code":"any P.Type","type":"codeVoice"},{"type":"text","text":" when"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/requiredConformance(of:)"},{"type":"text","text":" names a protocol "},{"code":"P","type":"codeVoice"},{"type":"text","text":", which the type must then conform to or the"},{"type":"text","text":" "},{"type":"text","text":"expansion doesn’t compile, and "},{"code":"Any.Type","type":"codeVoice"},{"type":"text","text":" otherwise."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"A function isolated to the main actor, by its own ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" or its type’s or extension’s,","type":"text"},{"text":" ","type":"text"},{"text":"is stored as its isolated type (","type":"text"},{"code":"@MainActor () -> Void","type":"codeVoice"},{"text":"), read with","type":"text"},{"text":" ","type":"text"},{"code":"LinkerSet<@MainActor () -> Void>","type":"codeVoice"},{"text":" and called on the main actor. A property isolated to the","type":"text"},{"text":" ","type":"text"},{"text":"main actor is refused, since the record’s nonisolated accessor can’t read it: one marked","type":"text"},{"text":" ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":", or a ","type":"text"},{"code":"var","type":"codeVoice"},{"text":" of a ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" type. Only a written ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" is seen. A custom","type":"text"},{"text":" ","type":"text"},{"text":"global actor’s attribute, and isolation a type inherits from a protocol it conforms to, can’t","type":"text"},{"text":" ","type":"text"},{"text":"be seen in the syntax, so a member isolated that way fails to compile inside the expansion.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It diagnoses anything else, each with a message of its own: generic functions and types,","type":"text"},{"text":" ","type":"text"},{"text":"members of generic types, instance members, protocol requirements, declarations inside a","type":"text"},{"text":" ","type":"text"},{"text":"function, closure or accessor, a kind that isn’t a 32-bit literal other than 0, and a unique key","type":"text"},{"text":" ","type":"text"},{"text":"that is empty or sits in a private or fileprivate type.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A member of an extension of a generic type is refused when the extension names generic"},{"type":"text","text":" "},{"type":"text","text":"arguments or has a "},{"type":"codeVoice","code":"where"},{"type":"text","text":" clause. A plain "},{"type":"codeVoice","code":"extension Box"},{"type":"text","text":" of "},{"type":"codeVoice","code":"struct Box<T>"},{"type":"text","text":" doesn’t show that"},{"type":"text","text":" "},{"type":"codeVoice","code":"Box"},{"type":"text","text":" is generic, so the compiler refuses that member in the expansion instead."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A member’s record names it through the enclosing types, "},{"code":"Scheduler.Jobs.clean","type":"codeVoice"},{"type":"text","text":", which works"},{"type":"text","text":" "},{"type":"text","text":"in a class or an actor too."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before swift-syntax 600 a macro can’t see its lexical context. There a type it registers must"},{"type":"text","text":" "},{"type":"text","text":"be declared at file scope, a member’s record names it through "},{"type":"codeVoice","code":"Self"},{"type":"text","text":", so a static member of a"},{"type":"text","text":" "},{"type":"text","text":"class or an actor fails to compile in the expansion, and the compiler, not the macro, refuses"},{"type":"text","text":" "},{"type":"text","text":"a local declaration or a member of a generic type, with an error in the expansion."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersetsmacrosupport\/linkersetmacro"]}],"relationshipsSections":[{"type":"inheritsFrom","identifiers":["doc:\/\/LinkerSetsMacroSupport\/s16SendableMetatypeP","doc:\/\/LinkerSetsMacroSupport\/17SwiftSyntaxMacros13AttachedMacroP","doc:\/\/LinkerSetsMacroSupport\/17SwiftSyntaxMacros5MacroP","doc:\/\/LinkerSetsMacroSupport\/17SwiftSyntaxMacros9PeerMacroP"],"title":"Inherits From","kind":"relationships"}],"hierarchy":{"paths":[["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro","interfaceLanguage":"swift"},"abstract":[{"text":"A macro that turns the declaration it’s attached to into a linker-set record of one kind.","type":"text"}],"kind":"symbol","sections":[],"references":{"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetMacro/recordMacroName":{"defaultImplementations":1,"title":"recordMacroName","type":"topic","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/recordMacroName","abstract":[{"type":"text","text":"The name of the freestanding macro the record’s peer calls, without the "},{"code":"#","type":"codeVoice"},{"type":"text","text":":"},{"type":"text","text":" "},{"code":"linkerSetRecord","type":"codeVoice"},{"type":"text","text":", which the LinkerSets module declares, unless the client declares one of"},{"type":"text","text":" "},{"type":"text","text":"its own."}],"url":"\/documentation\/linkersetsmacrosupport\/linkersetmacro\/recordmacroname","required":true,"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{