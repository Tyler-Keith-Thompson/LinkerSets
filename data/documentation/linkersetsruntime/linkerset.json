xt":"Note","kind":"identifier"}],"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/Note","title":"LinkerSetRecord.Note","url":"\/documentation\/linkersetsruntime\/linkersetrecord\/note","abstract":[{"type":"text","text":"A record as a macro writes it in an ELF image: the record, wrapped in an ELF note."}],"role":"symbol"},"doc://LinkerSetsRuntime/documentation/LinkerSetsRuntime/LinkerSet":{"abstract":[{"text":"Every record of one kind, across every image the program has loaded, and the values they","type":"text"},{"text":" ","type":"text"},{"text":"produce.","type":"text"}],"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet","navigatorTitle":[{"text":"LinkerSet","kind":"identifier"}],"title":"LinkerSet","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSet","kind":"identifier"}],"type":"topic","url":"\/documentation\/linkersetsruntime\/linkerset"},"doc://LinkerSetsRuntime/documentation/LinkerSetsRuntime/LinkerSetRecord":{"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord","abstract":[{"type":"text","text":"One entry in a linker set: a record an attached macro places in the section LinkerSets owns."}],"url":"\/documentation\/linkersetsruntime\/linkersetrecord","title":"LinkerSetRecord","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetRecord"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"LinkerSetRecord"}],"kind":"symbol"}}}