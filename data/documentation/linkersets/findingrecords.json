use","type":"topic","url":"\/documentation\/linkersets\/whatthemacrosrefuse","kind":"article","title":"What the macros refuse"},"doc://LinkerSets/documentation/LinkerSets/DeclaringAKind":{"role":"article","abstract":[{"type":"text","text":"Pick the number that tags your declarations, and decide whether your users write it."}],"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","type":"topic","url":"\/documentation\/linkersets\/declaringakind","title":"Declaring a kind","kind":"article"},"doc://LinkerSets/documentation/LinkerSets/UniqueKeys":{"kind":"article","type":"topic","url":"\/documentation\/linkersets\/uniquekeys","abstract":[{"type":"text","text":"Make two records of one kind with the same key fail to build, within one executable or library."}],"role":"article","title":"Unique keys","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/UniqueKeys"},"doc://LinkerSets/documentation/LinkerSets/ReplacingARegistry":{"kind":"article","type":"topic","url":"\/documentation\/linkersets\/replacingaregistry","abstract":[{"type":"text","text":"Move a central list of event types, routes or registrations onto declarations that find"},{"type":"text","text":" "},{"type":"text","text":"themselves."}],"role":"article","title":"Replacing a hand-written registry","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry"},"doc://LinkerSets/documentation/LinkerSets/Performance":{"role":"article","abstract":[{"type":"text","text":"What records cost as an app grows: nothing at launch, a walk of the records when a set is read,"},{"type":"text","text":" "},{"type":"text","text":"and a few milliseconds of build time per marked declaration."}],"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/Performance","type":"topic","url":"\/documentation\/linkersets\/performance","kind":"article","title":"Performance"},"doc://LinkerSets/documentation/LinkerSets":{"role":"collection","abstract":[{"type":"text","text":"Declarations tha