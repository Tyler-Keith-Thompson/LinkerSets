 order of ","type":"text"},{"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/records","isActive":true,"type":"reference"},{"text":".","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"values"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":"]"}],"url":"\/documentation\/linkersetsruntime\/linkerset\/values"},"doc://LinkerSetsRuntime/documentation/LinkerSetsRuntime/LinkerSet/init(kind:)":{"url":"\/documentation\/linkersetsruntime\/linkerset\/init(kind:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"LinkerSetKind","preciseIdentifier":"s:17LinkerSetsRuntime0A7SetKindV"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"The set of records of "},{"type":"codeVoice","code":"kind"},{"type":"text","text":"."}],"type":"topic","kind":"symbol","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/init(kind:)","title":"init(kind:)","role":"symbol"},"doc://LinkerSetsRuntime/documentation/LinkerSetsRuntime":{"type":"topic","abstract":[{"text":"Find every record of a kind at run time, without building any macros.","type":"text"}],"url":"\/documentation\/linkersetsruntime","kind":"symbol","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime","role":"collection","title":"LinkerSetsRuntime"},"doc://LinkerSetsRuntime/documentation/LinkerSetsRuntime/LinkerSet":{"type":"topic","abstract":[{"type":"text","text":"Every record of one kind, across every image the program has loaded, and the values they"},{"type":"text","text":" "},{"type":"text","text":"produce."}],"kind":"symbol","role":"symbol","title":"LinkerSet","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet","navigatorTitle":[{"text":"LinkerSet","kind":"identifier"}],"url":"\/documentation\/linkersetsruntime\/linkerset","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSet","kind":"identifier"}]},"doc://LinkerSetsRuntime/documentation/LinkerSetsRuntime/LinkerSetRecord/Literal":{"navigatorTitle":[{"kind":"identifier","text":"Literal"}],"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/Literal","abstract":[{"text":"A record as a macro writes it: a tuple of the record’s fields, in order.","type":"text"}],"kind":"symbol","role":"symbol","title":"LinkerSetRecord.Literal","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Literal"}],"type":"topic","url":"\/documentation\/linkersetsruntime\/linkersetrecord\/literal"},"doc://LinkerSetsRuntime/documentation/LinkerSetsRuntime/LinkerSetRecord/isSupportedVersion":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Whether this version of LinkerSets can read the record: its reserved fields are zero, as"},{"type":"text","text":" "},{"type":"text","text":"every record of the current layout’s are."}],"role":"symbol","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/isSupportedVersion","title":"isSupportedVersion","url":"\/documentation\/linkersetsruntime\/linkersetrecord\/issupportedversion","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isSupportedVersion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]}}}