},{"text":"), record","kind":"text"},{"text":": ","kind":"text"},{"text":"LinkerSetRecord","kind":"typeIdentifier","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","preciseIdentifier":"s:10LinkerSets0A9SetRecordV"},{"text":".","kind":"text"},{"text":"Literal","kind":"typeIdentifier","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Literal","preciseIdentifier":"s:10LinkerSets0A9SetRecordV7Literala"},{"text":")","kind":"text"}]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"In an ELF image the records sit in the note section ","type":"text"},{"code":".note.linker_sets","type":"codeVoice"},{"text":", which the linker","type":"text"},{"text":" ","type":"text"},{"text":"covers with a ","type":"text"},{"code":"PT_NOTE","type":"codeVoice"},{"text":" program header, so ","type":"text"},{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","type":"reference","isActive":true},{"text":" finds each loaded image’s records","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"code":"dl_iterate_phdr","type":"codeVoice"},{"text":", a shared library’s and a ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"text":"ed one’s included. Each note","type":"text"},{"text":" ","type":"text"},{"text":"has the standard header: ","type":"text"},{"code":"nameSize","type":"codeVoice"},{"text":" 11 and ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" ","type":"text"},{"code":"\"LinkerSets\"","type":"codeVoice"},{"text":" with its terminating","type":"text"},{"text":" ","type":"text"},{"text":"zero, padded to 12 bytes; ","type":"text"},{"code":"descriptorSize","type":"codeVoice"},{"text":", the size of a record (32 bytes where pointers","type":"text"},{"text":" ","type":"text"},{"text":"are 64 bits, 20 where they are 32); and ","type":"text"},{"code":"type","type":"codeVoice"},{"text":" 1. The record follows as the descriptor:","type":"text"}]},{"type":"codeListing","code":["let note: LinkerSetRecord.Note = (11, 32, 1, (76, 105, 110, 107, 101, 114, 83, 101, 116, 115, 0, 0),","                                  (0x726F_7574, 0, { outValue, type, hint, reserved in false }, 0, 0))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The 24-byte header keeps the record at its own alignment, whether a reader aligns notes to","type":"text"},{"text":" ","type":"text"},{"text":"4 bytes or to 8.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersets\/linkersetrecord\/note"]}],"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord"]]},"identifier":{"url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Note","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"LinkerSets"}],"roleHeading":"Type Alias","externalID":"s:10LinkerSets0A9SetRecordV4Notea","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSets\/LinkerSetRecord.swift#L74","fileName":"LinkerSetRecord.swift"},"title":"LinkerSetRecord.Note","symbolKind":"typealias","navigatorTitle":[{"kind":"identifier","text":"Note"}],"role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Note","kind":"identifier"}]},"kind":"symbol","references":{"doc://LinkerSets/documentation/LinkerSets":{"url":"\/documentation\/linkersets","title":"LinkerSets","type":"topic","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets","role":"collection","kind":"symbol","abstract":[{"text":"Declarations that register themselves at compile time and are found at run time across every module a program links.","type":"text"}]},"doc://LinkerSets/documentation/LinkerSets/Lin