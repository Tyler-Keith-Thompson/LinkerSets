t"},{"text":" ","type":"text"},{"text":"produce.","type":"text"}],"title":"LinkerSet","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","url":"\/documentation\/linkersets\/linkerset","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"LinkerSet","kind":"identifier"}]}}}