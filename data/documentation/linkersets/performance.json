{"metadata":{"roleHeading":"Article","title":"Performance","role":"article","modules":[{"name":"LinkerSets"}]},"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersets\/performance"]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","identifier":{"url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/Performance","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record is data the linker places in a section, so nothing runs for it at launch. Reading a set"},{"type":"text","text":" "},{"type":"text","text":"walks every loaded image’s section once and calls the accessor of each record of the set’s kind."},{"type":"text","text":" "},{"type":"text","text":"That’s linear in the records the program holds, and the reads aren’t cached, so read a set once"},{"type":"text","text":" "},{"type":"text","text":"where the program starts and keep the array. "},{"type":"codeVoice","code":"LinkerSetsPerformanceTests"},{"type":"text","text":" checks the scaling in"},{"type":"text","text":" "},{"type":"text","text":"release builds: reading 3,000 records costs no more than about 10 times reading 300."}]},{"type":"paragraph","inlineContent":[{"text":"The build pays for each marked declaration: the macro’s expansion and the record it compiles to.","type":"text"},{"text":" ","type":"text"},{"text":"That cost is also linear while the records are spread across files, as they are in an app.","type":"text"},{"text":" ","type":"text"},{"text":"Thousands of records in one file take the compiler much longer, so generated registries are","type":"text"},{"text":" ","type":"text"},{"text":"better split.","type":"text"}]},{"type":"heading","level":3,"text":"Measured","anchor":"Measured"},{"type":"paragraph","inlineContent":[{"code":"just benchmark","type":"codeVoice"},{"text":" measures both in a SwiftPM package of generated records, against the same","type":"text"},{"text":" ","type":"text"},{"text":"declarations without the macro. These figures are from an M1 Ultra with Swift 6.4.2, in a debug","type":"text"},{"text":" ","type":"text"},{"text":"build, with each size’s records split across 10 files:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Records"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Build time the records add"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Per record"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Reading every record (release)"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"100","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"2.6 s"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"26 ms"}],"type":"paragraph"}],[{"inlineContent":[{"text":"77 µs","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"1,000"}],"type":"paragraph"}],[{"inlineContent":[{"text":"4.2 s","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"4.3 ms","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"242 µs"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"10,000","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"50 s","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"5.0 ms","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"2.0 ms"}],"type":"paragraph"}]]],"header":"row","alignments":["right","right","right","right"]},{"type":"paragraph","inlineContent":[{"text":"The 100-record row is mostly the macro plugin’s start-up, paid once per module that uses it. A","type":"text"},{"text":" ","type":"text"},{"text":"read also has a fixed part, the walk over every image the process has loaded, which is about","type":"text"},{"text":" ","type":"text"},{"text":"70 µs on macOS. In a single file, 10,000 records added 111 s to the build instead of 50 s.","type":"text"}]}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","doc:\/\/LinkerSets\/documentation\/LinkerSets\/UniqueKeys","doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking"],"anchor":"Guides","generated":true,"title":"Guides"}],"abstract":[{"type":"text","text":"What records cost as an app grows: nothing at launch, a walk of the records when a set is read,"},{"type":"text","text":" "},{"type":"text","text":"and a few milliseconds of build time per marked declaration."}],"references":{"doc://LinkerSets/documentation/LinkerSets/FindingRecords":{"title":"Finding records","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","abstract":[{"type":"text","text":"Read every declaration of a kind, as the type you expect."}],"url":"\/documentation\/linkersets\/findingrecords","type":"topic","role":"article","kind":"article"},"doc://LinkerSets/documentation/LinkerSets/UniqueKeys":{"title":"Unique keys","type":"topic","url":"\/documentation\/linkersets\/uniquekeys","kind":"article","abstract":[{"type":"text","text":"Make two records of one kind with the same key fail to build, within one executable or library."}],"role":"article","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/UniqueKeys"},"doc://LinkerSets/documentation/LinkerSets/PlatformsAndLinking":{"title":"Platforms and linking","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking","abstract":[{"type":"text","text":"Where records are found, how, and which test shows it."}],"url":"\/documentation\/linkersets\/platformsandlinking","type":"topic","role":"article","kind":"article"},"doc://LinkerSets/documentation/LinkerSets/WhatTheMacrosRefuse":{"title":"What the macros refuse","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","abstract":[{"text":"Every declaration a record can’t describe is a compile error, with a message that says why.","type":"text"}],"url":"\/documentation\/linkersets\/whatthemacrosrefuse","type":"topic","role":"article","kind":"article"},"doc://LinkerSets/documentation/LinkerSets":{"title":"LinkerSets","type":"topic","url":"\/documentation\/linkersets","kind":"symbol","abstract":[{"type":"text","text":"Declarations that register themselves at compile time and are found at run time across every module a program links."}],"role":"collection","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets"},"doc://LinkerSets/documentation/LinkerSets/DeclaringAKind":{"url":"\/documentation\/linkersets\/declaringakind","role":"article","type":"topic","title":"Declaring a kind","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","kind":"article","abstract":[{"type":"text","text":"Pick the number that tags your declarations, and decide whether your users write it."}]},"doc://LinkerSets/documentation/LinkerSets/ReplacingARegistry":{"role":"article","url":"\/documentation\/linkersets\/replacingaregistry","kind":"article","type":"topic","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","abstract":[{"type":"text","text":"Move a central list of event types, routes or registrations onto declarations that find"},{"type":"text","text":" "},{"type":"text","text":"themselves."}],"title":"Replacing a hand-written registry"}}}