{"metadata":{"symbolKind":"module","modules":[{"name":"LinkerSets"}],"title":"LinkerSets","role":"collection","roleHeading":"Framework","externalID":"LinkerSets"},"kind":"symbol","primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An attached macro emits a small record into a section LinkerSets owns, and a typed run-time API"},{"type":"text","text":" "},{"type":"text","text":"enumerates every record of one kind in a deterministic order. Each record carries a kind, so"},{"type":"text","text":" "},{"type":"text","text":"clients share the mechanism without seeing each other’s records. Failures are typed errors; the"},{"type":"text","text":" "},{"type":"text","text":"run-time API never traps."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A declaration registers itself with "},{"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)","isActive":true},{"type":"text","text":", tagged with a kind: four ASCII"},{"type":"text","text":" "},{"type":"text","text":"characters read as a 32-bit integer. A "},{"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","isActive":true},{"type":"text","text":" of that kind finds every such declaration"},{"type":"text","text":" "},{"type":"text","text":"at run time:"}]},{"type":"codeListing","code":["import LinkerSets","","enum Routes {","    @LinkerSetEntry(kind: 0x726F_7574)  \/\/ \"rout\"","    static let home = Route(path: \"\/\")","}","","let routes = LinkerSet<Route>(kind: LinkerSetKind(rawValue: 0x726F_7574)).values"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A client that registers one kind of thing can give it a macro with the kind fixed, such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Route"},{"type":"text","text":", from its own compiler plugin. The LinkerSetsMacroSupport module’s documentation shows"},{"type":"text","text":" "},{"type":"text","text":"how."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSets\/documentation\/LinkerSets"},"sections":[],"topicSections":[{"anchor":"Declaring-records","title":"Declaring records","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)"]},{"anchor":"Finding-records","title":"Finding records","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind"]}],"abstract":[{"type":"text","text":"Declarations that register themselves at compile time and are found at run time across every module a program links."}],"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/linkersets"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://LinkerSets/documentation/LinkerSets":{"abstract":[{"text":"Declarations that register themselves at compile time and are found at run time across every module a program links.","type":"text"}],"kind":"symbol","url":"\/documentation\/linkersets","title":"LinkerSets","type":"topic","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets","role":"collection"},"doc://LinkerSets/documentation/LinkerSets/LinkerSetEntry(kind:)":{"url":"\/documentation\/linkersets\/linkersetentry(kind:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)","title":"LinkerSetEntry(kind:)","type":"topic","abstract":[{"type":"text","text":"Declares a record of "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" whose value is this declaration’s."}],"fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetEntry"},{"kind":"text","text":"("},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UInt32","preciseIdentifier":"s:s6UInt32V"},{"kind":"text","text":")"}]},"doc://LinkerSets/documentation/LinkerSets/LinkerSetKind":{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetKind"}],"kind":"symbol","title":"LinkerSetKind","url":"\/documentation\/linkersets\/linkersetkind","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The tag that says which client a linker-set record belongs to."}],"navigatorTitle":[{"kind":"identifier","text":"LinkerSetKind"}]},"doc://LinkerSets/documentation/LinkerSets/LinkerSetRecord":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetRecord","kind":"identifier"}],"title":"LinkerSetRecord","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","url":"\/documentation\/linkersets\/linkersetrecord","role":"symbol","navigatorTitle":[{"text":"LinkerSetRecord","kind":"identifier"}],"type":"topic","abstract":[{"text":"One entry in a linker set: a record an attached macro places in the section LinkerSets owns.","type":"text"}],"kind":"symbol"},"doc://LinkerSets/documentation/LinkerSets/LinkerSet":{"navigatorTitle":[{"text":"LinkerSet","kind":"identifier"}],"url":"\/documentation\/linkersets\/linkerset","kind":"symbol","role":"symbol","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","title":"LinkerSet","abstract":[{"type":"text","text":"Every record of one kind, across every image the program has loaded, and the values they"},{"type":"text","text":" "},{"type":"text","text":"produce."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSet","kind":"identifier"}]}}}