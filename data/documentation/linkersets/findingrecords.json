ker laid them"},{"type":"text","text":" "},{"type":"text","text":"out. The order is stable from one read to the next while nothing new is loaded, but it isn’t one"},{"type":"text","text":" "},{"type":"text","text":"you choose. Sort the values when order matters:"}]},{"type":"codeListing","syntax":"swift","code":["let migrations = LinkerSet<Migration>(kind: .migrations).values.sorted { $0.version < $1.version }"]},{"type":"heading","level":3,"anchor":"When-records-are-read","text":"When records are read"},{"type":"paragraph","inlineContent":[{"text":"Nothing runs at launch. Each read of ","type":"text"},{"code":"values","type":"codeVoice"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/records","isActive":true,"type":"reference"},{"text":" asks the loader for its","type":"text"},{"text":" ","type":"text"},{"text":"images and walks their records, so a read after ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"text":" includes the new library’s records. A read","type":"text"},{"text":" ","type":"text"},{"text":"walks every record of every kind, O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") in their number; keep the result rather than reading it in","type":"text"},{"text":" ","type":"text"},{"text":"a hot loop.","type":"text"}]},{"type":"heading","level":3,"anchor":"Records-one-at-a-time","text":"Records one at a time"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/records","isActive":true,"type":"reference"},{"text":" gives the records themselves, of the set’s kind, before any type is asked","type":"text"},{"text":" ","type":"text"},{"text":"for. ","type":"text"},{"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/value(as:)","isActive":true,"type":"reference"},{"text":" asks one record for a value and says why it can’t produce