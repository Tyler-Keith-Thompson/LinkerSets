{"abstract":[{"type":"text","text":"A key that no other record of this kind in the same linked image may share, such as an"},{"type":"text","text":" "},{"type":"text","text":"event’s name, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for no check."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"uniqueKey"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":" "},{"kind":"internalParam","text":"declaration"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11SwiftSyntax04DeclB8ProtocolP","kind":"typeIdentifier","text":"DeclSyntaxProtocol"},{"kind":"text","text":", "},{"kind":"externalParam","text":"attribute"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11SwiftSyntax09AttributeB0V","kind":"typeIdentifier","text":"AttributeSyntax"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The declaration the attribute is attached to.","type":"text"}]}],"name":"declaration"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The attribute being expanded, as written."}]}],"name":"attribute"}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The key, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"With a key, the expansion also declares a function whose symbol is named for the kind and"},{"type":"text","text":" "},{"type":"text","text":"the key, "},{"type":"codeVoice","code":"$linkerset_kind_65766E74_key_Login"},{"type":"text","text":", so two declarations with the same key fail to"},{"type":"text","text":" "},{"type":"text","text":"build: in one module the compiler refuses the second definition, and across the modules of"},{"type":"text","text":" "},{"type":"text","text":"one executable or library the linker does, naming the symbol and both object files. Letters"},{"type":"text","text":" "},{"type":"text","text":"and digits stand as they are in the name; every other UTF-8 byte is "},{"type":"codeVoice","code":"_"},{"type":"text","text":" and two hex"},{"type":"text","text":" "},{"type":"text","text":"digits, so any string other than the empty one encodes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The check reaches one linked image only: separate shared libraries and code loaded with"},{"type":"text","text":" "},{"code":"dlopen","type":"codeVoice"},{"type":"text","text":" each keep their own symbols, so a client that needs the guarantee across images"},{"type":"text","text":" "},{"type":"text","text":"still checks at run time."}],"type":"paragraph"},{"name":"Throws","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A diagnostic when the declaration or attribute doesn’t give a key the macro can"},{"type":"text","text":" "},{"type":"text","text":"use."}]}],"type":"aside"}]}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"defaultImplementationsSections":[{"anchor":"LinkerSetMacro-Implementations","title":"LinkerSetMacro Implementations","identifiers":["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/uniqueKey(of:attribute:)-6ryvp"]}],"variants":[{"paths":["\/documentation\/linkersetsmacrosupport\/linkersetmacro\/uniquekey(of:attribute:)"],"traits":[{"interface