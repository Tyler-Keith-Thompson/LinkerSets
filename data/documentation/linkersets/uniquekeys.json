{"variants":[{"paths":["\/documentation\/linkersets\/uniquekeys"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets"]]},"abstract":[{"type":"text","text":"Make two records of one kind with the same key fail to build, within one executable or library."}],"seeAlsoSections":[{"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking","doc:\/\/LinkerSets\/documentation\/LinkerSets\/Performance"],"anchor":"Guides","title":"Guides","generated":true}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/UniqueKeys","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Records are anonymous bytes in a section, and the linker concatenates them, so two modules can"},{"type":"text","text":" "},{"type":"text","text":"register the same route or the same event name, and nothing notices until the program reads the"},{"type":"text","text":" "},{"type":"text","text":"set. The linker does refuse two definitions of one symbol. A record declared with a unique key gets"},{"type":"text","text":" "},{"type":"text","text":"a function beside it whose symbol is named for the record’s kind and the key, so a second"},{"type":"text","text":" "},{"type":"text","text":"declaration of that kind and key defines the symbol again and the build fails, naming it."}],"type":"paragraph"},{"code":["enum Routes {","    @LinkerSetEntry(kind: 0x726F_7574, uniqueKey: \"\/home\")","    static let home = Route(path: \"\/home\")","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:uniqueKey:)"},{"type":"text","text":" takes the key as a string literal. A client’s own macro gives"},{"type":"text","text":" "},{"type":"text","text":"each declaration its key from LinkerSetsMacroSupport’s "},{"type":"codeVoice","code":"uniqueKey(of:attribute:)"},{"type":"text","text":": from the"},{"type":"text","text":" "},{"type":"text","text":"declaration, such as an event type’s name, or from an argument of the attribute through"},{"type":"text","text":" "},{"type":"codeVoice","code":"uniqueKeyArgument(of:)"},{"type":"text","text":". Records of different kinds never clash, because the kind is part of the"},{"type":"text","text":" "},{"type":"text","text":"symbol’s name."}],"type":"paragraph"},{"type":"heading","text":"What the developer sees","level":3,"anchor":"What-the-developer-sees"},{"inlineContent":[{"type":"text","text":"The symbol reads "},{"code":"$linkerset_kind_<kind>_key_<key>","type":"codeVoice"},{"type":"text","text":": the kind as eight hex digits, then the key,"},{"type":"text","text":" "},{"type":"text","text":"with ASCII letters and digits as they are and every other UTF-8 byte as "},{"code":"_","type":"codeVoice"},{"type":"text","text":" and two hex digits. The"},{"type":"text","text":" "},{"type":"text","text":"route above is "},{"code":"$linkerset_kind_726F7574_key__2Fhome","type":"codeVoice"},{"type":"text","text":", and an event named "},{"code":"OrderPlaced","type":"codeVoice"},{"type":"text","text":" of kind"},{"type":"text","text":" "},{"code":"\"evnt\"","type":"codeVoice"},{"type":"text","text":" is "},{"code":"$linkerset_kind_65766E74_key_OrderPlaced","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two declarations in one module are caught by the compiler:"}],"type":"paragraph"},{"code":["error: multiple definitions of symbol '$linkerset_kind_726F7574_key__2Fhome'"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"Two modules linked into one program are caught by the linker, which names both object files. Each","type":"text"},{"text":" ","type":"text"},{"text":"linker words it its own way.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Apple’s "},{"type":"codeVoice","code":"ld"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["duplicate symbol '_$linkerset_kind_65766E74_key_OrderPlaced' in:","    ...\/libCheckout.a[2](OrderPlaced.swift.o)","    ...\/libOrders.a[2](OrderPlaced.swift.o)","ld: 1 duplicate symbols"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"LLVM’s "},{"type":"codeVoice","code":"lld"},{"type":"text","text":" for ELF, which Bazel links with on Linux and Android uses, points at the macro"},{"type":"text","text":" "},{"type":"text","text":"expansion that declares each one:"}],"type":"paragraph"},{"code":["ld.lld: error: duplicate symbol: $linkerset_kind_65766E74_key_OrderPlaced",">>> defined at @__swiftmacro_6Orders11OrderPlaced5EventfMp_.swift:6",">>>            OrderPlaced.swift.o:($linkerset_kind_65766E74_key_OrderPlaced) in archive libOrders.a",">>> defined at @__swiftmacro_8Checkout11OrderPlaced5EventfMp_.swift:6",">>>            OrderPlaced.swift.o:(.text.$linkerset_kind_65766E74_key_OrderPlaced+0x0) in archive libCheckout.a"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"GNU gold, which ","type":"text"},{"code":"swiftc","type":"codeVoice"},{"text":" links with on Linux by default:","type":"text"}],"type":"paragraph"},{"code":["\/usr\/bin\/ld.gold: error: .\/libCheckout.a(OrderPlaced.swift.o): multiple definition of '$linkerset_kind_65766E74_key_OrderPlaced'","\/usr\/bin\/ld.gold: .\/libOrders.a(OrderPlaced.swift.o): previous definition here"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"codeVoice","code":"wasm-ld"},{"type":"text","text":", for WebAssembly:"}],"type":"paragraph"},{"code":["wasm-ld: error: duplicate symbol: $linkerset_kind_65766E74_key_OrderPlaced",">>> defined in ...\/Orders.objlib\/a.o",">>> defined in ...\/Checkout.objlib\/b.o"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"On Windows, "},{"code":"lld-link","type":"codeVoice"},{"type":"text","text":" and "},{"code":"link.exe","type":"codeVoice"},{"type":"text","text":" refuse a symbol defined twice as well ("},{"code":"LNK2005","type":"codeVoice"},{"type":"text","text":" from"},{"type":"text","text":" "},{"code":"link.exe","type":"codeVoice"},{"type":"text","text":"), but no test shows it yet."}],"type":"paragraph"},{"type":"heading","text":"One linked image at a time","level":3,"anchor":"One-linked-image-at-a-time"},{"inlineContent":[{"text":"The check covers the modules linked statically into one executable or one shared library. It","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t reach across images:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shared libraries and frameworks keep their symbols apart. On Apple platforms each image’s"},{"type":"text","text":" "},{"type":"text","text":"symbols live in a namespace of their own, and on ELF the first definition the loader finds wins"},{"type":"text","text":" "},{"type":"text","text":"without an error. The function is internal, so a library doesn’t export it either."}]}]},{"content":[{"inlineContent":[{"text":"A library opened with ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"text":" is never compared with the program.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"A record of the same key in another image is still read, so a client that needs the guarantee for","type":"text"},{"text":" ","type":"text"},{"text":"the whole process keeps a check at run time too, such as throwing when two records share a name.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Static archives","level":3,"anchor":"Static-archives"},{"inlineContent":[{"text":"A static archive’s member is linked only when something references it. Its record and its key’s","type":"text"},{"text":" ","type":"text"},{"text":"symbol sit in the same object file, so the two are linked together or not at all: a module whose","type":"text"},{"text":" ","type":"text"},{"text":"records are missing (see ","type":"text"},{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking","isActive":true,"type":"reference"},{"text":") is missing from the check as well.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"SwiftPM and Bazel link a target’s modules whole, and there a duplicate is an error. Apple’s "},{"code":"ld","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"makes one exception: with "},{"code":"-dead_strip","type":"codeVoice"},{"type":"text","text":", the default for release builds in Xcode, a duplicate from"},{"type":"text","text":" "},{"type":"text","text":"an archive member read on demand is only a warning, "},{"code":"ld: warning: duplicate symbol","type":"codeVoice"},{"type":"text","text":", and the link"},{"type":"text","text":" "},{"type":"text","text":"succeeds. Link the archive whole ("},{"code":"-force_load","type":"codeVoice"},{"type":"text","text":", or "},{"code":"-all_load","type":"codeVoice"},{"type":"text","text":" for every archive), or make the"},{"type":"text","text":" "},{"type":"text","text":"linker’s warnings errors with "},{"code":"-Xlinker -fatal_warnings","type":"codeVoice"},{"type":"text","text":", to keep it an error. Linux’s linkers and"},{"type":"text","text":" "},{"code":"wasm-ld","type":"codeVoice"},{"type":"text","text":" make it an error either way."}],"type":"paragraph"},{"type":"heading","text":"Where a key can’t be checked","level":3,"anchor":"Where-a-key-cant-be-checked"},{"inlineContent":[{"type":"text","text":"A symbol declared inside a "},{"type":"codeVoice","code":"private"},{"type":"text","text":" or "},{"type":"codeVoice","code":"fileprivate"},{"type":"text","text":" type, or an extension marked either way, is"},{"type":"text","text":" "},{"type":"text","text":"local to its file, and the linker never compares local symbols. The macros refuse a unique key"},{"type":"text","text":" "},{"type":"text","text":"there: “can’t check its unique key inside a private or fileprivate type”. The enclosing type can be"},{"type":"text","text":" "},{"type":"text","text":"seen from swift-syntax 600 on. With an older swift-syntax the key in such a type compiles and goes"},{"type":"text","text":" "},{"type":"text","text":"unchecked. A key that is empty, or a "},{"type":"codeVoice","code":"uniqueKey:"},{"type":"text","text":" argument that isn’t a string literal or holds an"},{"type":"text","text":" "},{"type":"text","text":"interpolation, is refused too ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse"},{"type":"text","text":")."}],"type":"paragraph"},{"type":"heading","text":"What is tested where","level":3,"anchor":"What-is-tested-where"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Format"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Covered by"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Runs in","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Mach-O, macOS"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Tests\/CompileFailures","type":"codeVoice"},{"text":": ","type":"text"},{"code":"DuplicateEventNames","type":"codeVoice"},{"text":" (an archive read on demand), ","type":"text"},{"code":"DistinctEventNames","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DuplicateKeyInOneModule","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"just test"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"ELF, Linux","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The same tests, linked with "},{"type":"codeVoice","code":"lld"},{"type":"text","text":"; gold checked by hand"}],"type":"paragraph"}],[{"inlineContent":[{"text":"CI’s Linux Bazel job","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"WebAssembly"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Checked by hand with the 6.4.3 SDK’s "},{"code":"wasm-ld","type":"codeVoice"},{"type":"text","text":"; "},{"code":"UniqueKeyRecordTests","type":"codeVoice"},{"type":"text","text":" reads keyed records"}],"type":"paragraph"}],[{"inlineContent":[{"code":"just wasi-test","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"COFF, Windows","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Untested: "},{"type":"codeVoice","code":"UniqueKeyRecordTests"},{"type":"text","text":" shows keyed records build and read, but no test links a duplicate"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"CI’s Windows workflow"}],"type":"paragraph"}]]],"header":"row"},{"inlineContent":[{"type":"text","text":"The Bazel tests build their programs with "},{"code":"tools\/link_test.bzl","type":"codeVoice"},{"type":"text","text":", which links outside Bazel’s own"},{"type":"text","text":" "},{"type":"text","text":"link step so that a link meant to fail doesn’t fail the build. SwiftPM can’t hold such a test: a"},{"type":"text","text":" "},{"type":"text","text":"package with a duplicate fails to build as a whole."}],"type":"paragraph"}]}],"sections":[],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"LinkerSets"}],"title":"Unique keys"},"references":{"doc://LinkerSets/documentation/LinkerSets/LinkerSetEntry(kind:uniqueKey:)":{"fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetEntry"},{"kind":"text","text":"("},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt32V","text":"UInt32"},{"kind":"text","text":", "},{"kind":"externalParam","text":"uniqueKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":")"}],"type":"topic","title":"LinkerSetEntry(kind:uniqueKey:)","role":"symbol","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:uniqueKey:)","url":"\/documentation\/linkersets\/linkersetentry(kind:uniquekey:)","kind":"symbol","abstract":[{"type":"text","text":"Declares a record of "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" whose value is this declaration’s, and that no other record of"},{"type":"text","text":" "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" in the same executable or library may share "},{"type":"codeVoice","code":"uniqueKey"},{"type":"text","text":" with."}]},"doc://LinkerSets/documentation/LinkerSets/Performance":{"kind":"article","abstract":[{"type":"text","text":"What records cost as an app grows: nothing at launch, a walk of the records when a set is read,"},{"type":"text","text":" "},{"type":"text","text":"and a few milliseconds of build time per marked declaration."}],"type":"topic","role":"article","title":"Performance","url":"\/documentation\/linkersets\/performance","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/Performance"},"doc://LinkerSets/documentation/LinkerSets/PlatformsAndLinking":{"type":"topic","kind":"article","url":"\/documentation\/linkersets\/platformsandlinking","abstract":[{"type":"text","text":"Where records are found, how, and which test shows it."}],"role":"article","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking","title":"Platforms and linking"},"doc://LinkerSets/documentation/LinkerSets/DeclaringAKind":{"kind":"article","abstract":[{"type":"text","text":"Pick the number that tags your declarations, and decide whether your users write it."}],"type":"topic","role":"article","title":"Declaring a kind","url":"\/documentation\/linkersets\/declaringakind","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind"},"doc://LinkerSets/documentation/LinkerSets/ReplacingARegistry":{"type":"topic","kind":"article","url":"\/documentation\/linkersets\/replacingaregistry","abstract":[{"text":"Move a central list of event types, routes or registrations onto declarations that find","type":"text"},{"text":" ","type":"text"},{"text":"themselves.","type":"text"}],"role":"article","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","title":"Replacing a hand-written registry"},"doc://LinkerSets/documentation/LinkerSets/WhatTheMacrosRefuse":{"kind":"article","abstract":[{"type":"text","text":"Every declaration a record can’t describe is a compile error, with a message that says why."}],"type":"topic","role":"article","title":"What the macros refuse","url":"\/documentation\/linkersets\/whatthemacrosrefuse","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse"},"doc://LinkerSets/documentation/LinkerSets/FindingRecords":{"type":"topic","title":"Finding records","url":"\/documentation\/linkersets\/findingrecords","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","role":"article","kind":"article","abstract":[{"text":"Read every declaration of a kind, as the type you expect.","type":"text"}]},"doc://LinkerSets/documentation/LinkerSets":{"kind":"symbol","abstract":[{"text":"Declarations that register themselves at compile time and are found at run time across every module a program links.","type":"text"}],"type":"topic","role":"collection","url":"\/documentation\/linkersets","title":"LinkerSets","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets"}}}