{"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)"],"title":"Declaring records","anchor":"Declaring-records"},{"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind"],"title":"Finding records","anchor":"Finding-records"}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An attached macro emits a small record into a section LinkerSets owns, and a typed run-time API"},{"type":"text","text":" "},{"type":"text","text":"enumerates every record of one kind in a deterministic order. Each record carries a kind, so"},{"type":"text","text":" "},{"type":"text","text":"clients share the mechanism without seeing each other’s records. Failures are typed errors; the"},{"type":"text","text":" "},{"type":"text","text":"run-time API never traps."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A declaration registers itself with "},{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)","type":"reference","isActive":true},{"type":"text","text":", tagged with a kind: four ASCII"},{"type":"text","text":" "},{"type":"text","text":"characters read as a 32-bit integer. A "},{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","type":"reference","isActive":true},{"type":"text","text":" of that kind finds every such declaration"},{"type":"text","text":" "},{"type":"text","text":"at run time:"}]},{"code":["import LinkerSets","","enum Routes {","    @LinkerSetEntry(kind: 0x726F_7574)  \/\/ \"rout\"","    static let home = Route(path: \"\/\")","}","","let routes = LinkerSet<Route>(kind: LinkerSetKind(rawValue: 0x726F_7574)).values"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A client that registers one kind of thing can give it a macro with the kind fixed, such as","type":"text"},{"text":" ","type":"text"},{"code":"@Route","type":"codeVoice"},{"text":", from its own compiler plugin. The LinkerSetsMacroSupport module’s documentation shows","type":"text"},{"text":" ","type":"text"},{"text":"how.","type":"text"}]}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersets"]}],"metadata":{"externalID":"LinkerSets","roleHeading":"Framework","role":"collection","symbolKind":"module","modules":[{"name":"LinkerSets"}],"title":"LinkerSets"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSets\/documentation\/LinkerSets"},"abstract":[{"text":"Declarations that register themselves at compile time and are found at run time across every module a program links.","type":"text"}],"references":{"doc://LinkerSets/documentation/LinkerSets":{"title":"LinkerSets","kind":"symbol","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets","abstract":[{"type":"text","text":"Declarations that register themselves at compile time and are found at run time across every module a program links."}],"type":"topic","role":"collection","url":"\/documentation\/linkersets"},"doc://LinkerSets/documentation/LinkerSets/LinkerSetKind":{"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetKind"}],"title":"LinkerSetKind","url":"\/documentation\/linkersets\/linkersetkind","navigatorTitle":[{"kind":"identifier","text":"LinkerSetKind"}],"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind","abstract":[{"type":"text","text":"The tag that says which client a linker-set record belongs to."}]},"doc://LinkerSets/documentation/LinkerSets/LinkerSetRecord":{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","url":"\/documentation\/linkersets\/linkersetrecord","title":"LinkerSetRecord","kind":"symbol","navigatorTitle":[{"text":"LinkerSetRecord","kind":"identifier"}],"abstract":[{"text":"One entry in a linker set: a record an attached macro places in the section LinkerSets owns.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetRecord","kind":"identifier"}]},"doc://LinkerSets/documentation/LinkerSets/LinkerSet":{"role":"symbol","abstract":[{"type":"text","text":"Every record of one kind, across every image the program has loaded, and the values they"},{"type":"text","text":" "},{"type":"text","text":"produce."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSet"}],"navigatorTitle":[{"kind":"identifier","text":"LinkerSet"}],"kind":"symbol","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","title":"LinkerSet","type":"topic","url":"\/documentation\/linkersets\/linkerset"},"doc://LinkerSets/documentation/LinkerSets/LinkerSetEntry(kind:)":{"fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetEntry"},{"kind":"text","text":"("},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt32V","text":"UInt32"},{"kind":"text","text":")"}],"title":"LinkerSetEntry(kind:)","abstract":[{"text":"Declares a record of ","type":"text"},{"code":"kind","type":"codeVoice"},{"text":" whose value is this declaration’s.","type":"text"}],"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/linkersets\/linkersetentry(kind:)"}}}