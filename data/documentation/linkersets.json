{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSets\/documentation\/LinkerSets"},"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"An attached macro emits a small record into a section LinkerSets owns, and a typed run-time API"},{"type":"text","text":" "},{"type":"text","text":"enumerates every record of one kind in a deterministic order. Each record carries a kind, so"},{"type":"text","text":" "},{"type":"text","text":"clients share the mechanism without seeing each other’s records. Failures are typed errors; the"},{"type":"text","text":" "},{"type":"text","text":"run-time API never traps."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A declaration registers itself with "},{"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)","isActive":true},{"type":"text","text":", tagged with a kind: four ASCII"},{"type":"text","text":" "},{"type":"text","text":"characters read as a 32-bit integer. A "},{"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","isActive":true},{"type":"text","text":" of that kind finds every such declaration"},{"type":"text","text":" "},{"type":"text","text":"at run time:"}],"type":"paragraph"},{"code":["import LinkerSets","","enum Routes {","    @LinkerSetEntry(kind: 0x726F_7574)  \/\/ \"rout\"","    static let home = Route(path: \"\/\")","}","","let routes = LinkerSet<Route>(kind: LinkerSetKind(rawValue: 0x726F_7574)).values"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A client that registers one kind of thing can give it a macro with the kind fixed, such as"},{"type":"text","text":" "},{"code":"@Route","type":"codeVoice"},{"type":"text","text":", from its own compiler plugin. The LinkerSetsMacroSupport module’s documentation shows"},{"type":"text","text":" "},{"type":"text","text":"how."}],"type":"paragraph"}]}],"metadata":{"modules":[{"name":"LinkerSets"}],"title":"LinkerSets","role":"collection","externalID":"LinkerSets","roleHeading":"Framework","symbolKind":"module"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersets"]}],"abstract":[{"text":"Declarations that register themselves at compile time and are found at run time across every module a program links.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking"],"title":"Guides","anchor":"Guides"},{"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)"],"title":"Declaring records","anchor":"Declaring-records"},{"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind"],"title":"Finding records","anchor":"Finding-records"}],"sections":[],"references":{"doc://LinkerSets/documentation/LinkerSets":{"title":"LinkerSets","role":"collection","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets","url":"\/documentation\/linkersets","kind":"symbol","type":"topic","abstract":[{"text":"Declarations that register themselves at compile time and are found at run time across every module a program links.","type":"text"}]},"doc://LinkerSets/documentation/LinkerSets/FindingRecords":{"kind":"article","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","url":"\/documentation\/linkersets\/findingrecords","role":"article","title":"Finding records","abst