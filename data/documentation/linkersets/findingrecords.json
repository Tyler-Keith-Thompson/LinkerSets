{"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet"},{"type":"text","text":" names a kind and a type. Its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/values"},{"type":"text","text":" are the values of every record of"},{"type":"text","text":" "},{"type":"text","text":"that kind that produces the type:"}]},{"syntax":"swift","type":"codeListing","code":["let routes = LinkerSet<Route>(kind: .routes).values"]},{"type":"paragraph","inlineContent":[{"text":"What you ask for depends on what was marked:","type":"text"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Marked declaration"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Ask for","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"static let home = Route(path: \"\/\")"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LinkerSet<Route>","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"static func migrate(_ db: inout Database)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LinkerSet<(inout Database) -> Void>","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@MainActor static func show()"},{"type":"text","text":", or a static func of a "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" type"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LinkerSet<@MainActor () -> Void>","type":"codeVoice"},{"text":", read on the main actor","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"struct Login: AnalyticsEvent","type":"codeVoice"},{"type":"text","text":", with "},{"code":"@LinkerSetEntry","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LinkerSet<Any.Type>"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"struct Login: AnalyticsEvent","type":"codeVoice"},{"text":", with a macro requiring ","type":"text"},{"code":"AnalyticsEvent","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LinkerSet<any AnalyticsEvent.Type>","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"A record of the right kind but another type is left out of ","type":"text"},{"type":"codeVoice","code":"values"},{"text":". Nothing traps, and nothing","type":"text"},{"text":" ","type":"text"},{"text":"throws: a set with no matching records is empty.","type":"text"}]},{"text":"Order","type":"heading","anchor":"Order","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records come back image by image in the order the loader lists them (the program, then its"},{"type":"text","text":" "},{"type":"text","text":"libraries, then each library loaded later), and within an image in the order the linker laid them"},{"type":"text","text":" "},{"type":"text","text":"out. The order is stable from one read to the next while nothing new is loaded, but it isn’t one"},{"type":"text","text":" "},{"type":"text","text":"you choose. Sort the values when order matters:"}]},{"syntax":"swift","type":"codeListing","code":["let migrations = LinkerSet<Migration>(kind: .migrations).values.sorted { $0.version < $1.version }"]},{"text":"When records are read","type":"heading","anchor":"When-records-are-read","level":3},{"type":"paragraph","inlineContent":[{"text":"Nothing runs at launch. Each read of ","type":"text"},{"type":"codeVoice","code":"values"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/records","type":"reference","isActive":true},{"text":" asks the loader for its","type":"text"},{"text":" ","type":"text"},{"text":"images and walks their records, so a read after ","type":"text"},{"type":"codeVoice","code":"dlopen"},{"text":" includes the new library’s records. A read","type":"text"},{"text":" ","type":"text"},{"text":"walks every record of every kind, O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") in their number; keep the result rather than reading it in","type":"text"},{"text":" ","type":"text"},{"text":"a hot loop.","type":"text"}]},{"text":"Records one at a time","type":"heading","anchor":"Records-one-at-a-time","level":3},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/records","type":"reference","isActive":true},{"text":" gives the records themselves, of the set’s kind, before any type is asked","type":"text"},{"text":" ","type":"text"},{"text":"for. ","type":"text"},{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/value(as:)","type":"reference","isActive":true},{"text":" asks one record for a value and says why it can’t produce one:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["for record in LinkerSet<Route>(kind: .routes).records {","    do {","        let route = try record.value(as: Route.self)","        print(route.path)","    } catch .typeMismatch {","        \/\/ A record of this kind that holds something else.","    } catch {","        \/\/ .emptySlot or .unsupportedVersion: the set already leaves these out.","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record whose reserved fields aren’t zero was written by a newer layout of the library; the set"},{"type":"text","text":" "},{"type":"text","text":"skips it rather than call an accessor whose contract it doesn’t know."}]},{"text":"Records the linker never saw","type":"heading","anchor":"Records-the-linker-never-saw","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record is in the program only if its module is. SwiftPM and Bazel link every module a target"},{"type":"text","text":" "},{"type":"text","text":"depends on, so a module whose only job is to declare records still reaches the program. A build"},{"type":"text","text":" "},{"type":"text","text":"that links a static library’s members only when something calls into them leaves such a module"},{"type":"text","text":" "},{"type":"text","text":"out. Link it whole: "},{"type":"codeVoice","code":"-force_load"},{"type":"text","text":" on Apple platforms, "},{"type":"codeVoice","code":"--whole-archive"},{"type":"text","text":" on Linux."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersets\/findingrecords"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets"]]},"kind":"article","metadata":{"role":"article","title":"Finding records","roleHeading":"Article","modules":[{"name":"LinkerSets"}]},"abstract":[{"type":"text","text":"Read every declaration of a kind, as the type you expect."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords"},"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking"],"anchor":"Guides"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://LinkerSets/documentation/LinkerSets/ReplacingARegistry":{"type":"topic","abstract":[{"type":"text","text":"Move a central list of event types, routes or registrations onto declarations that find"},{"type":"text","text":" "},{"type":"text","text":"themselves."}],"title":"Replacing a hand-written registry","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","kind":"article","url":"\/documentation\/linkersets\/replacingaregistry","role":"article"},"