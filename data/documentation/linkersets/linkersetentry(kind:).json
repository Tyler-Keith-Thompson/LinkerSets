{"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(peer) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetEntry","kind":"identifier"},{"text":"(","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt32","preciseIdentifier":"s:s6UInt32V","kind":"typeIdentifier"},{"text":")","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The kind the record is tagged with, as an integer literal.","type":"text"}]}],"name":"kind"}]},{"mentions":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind"],"kind":"mentions"},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Attach it to a static property, a global variable, a static function, a free function, or a"},{"type":"text","text":" "},{"type":"text","text":"struct, enum, class or actor that isn’t generic, at file scope or in a type that isn’t"},{"type":"text","text":" "},{"type":"text","text":"generic. Anything else is a compile-time error that says why. The macro adds a "},{"type":"codeVoice","code":"@used"},{"type":"text","text":" peer, placed with"},{"type":"text","text":" "},{"type":"codeVoice","code":"@section"},{"type":"text","text":" in the section LinkerSets owns, whose accessor produces the variable’s value, the"},{"type":"text","text":" "},{"type":"text","text":"function itself as a value of its function type, or the type’s metatype as "},{"type":"codeVoice","code":"Any.Type"},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet","isActive":true},{"type":"text","text":" of the same kind and value type finds it at run time:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["enum Routes {","    @LinkerSetEntry(kind: 0x726F_7574)","    static let home = Route(path: \"\/\")","}","","let routes = LinkerSet<Route>(kind: LinkerSetKind(rawValue: 0x726F_7574)).values"]},{"inlineContent":[{"type":"text","text":"The kind is an integer literal from 1 through "},{"type":"codeVoice","code":"UInt32.max"},{"type":"text","text":"; kind 0 is reserved for empty"},{"type":"text","text":" "},{"type":"text","text":"slots. A record produces its value only for a request of exactly its type: a function"},{"type":"text","text":" "},{"type":"codeVoice","code":"func f(_ x: Int) -> String"},{"type":"text","text":" is found by "},{"type":"codeVoice","code":"LinkerSet<(Int) -> String>"},{"type":"text","text":", and a type by"},{"type":"text","text":" "},{"type":"codeVoice","code":"LinkerSet<Any.Type>"},{"type":"text","text":". A client whose types share a protocol reads them as "},{"type":"codeVoice","code":"any P.Type"},{"type":"text","text":" through"},{"type":"text","text":" "},{"type":"text","text":"a macro of its own that requires it (LinkerSetsMacroSupport’s "},{"type":"codeVoice","code":"LinkerSetMacro"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"text":"A module that uses it depends on LinkerSets, so its build includes LinkerSets’ macro plugin,","type":"text"},{"text":" ","type":"text"},{"text":"LinkerSetsMacros, and swift-syntax. A client with a plugin of its own can give its modules an","type":"text"},{"text":" ","type":"text"},{"text":"entry macro that writes the same records on LinkerSetsRuntime alone:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/tyler-keith-thompson.github.io\/LinkerSets\/documentation\/linkersetsmacrosupport#Writing-records-without-depending-on-LinkerSets","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Declares a record of "},{"code":"kind","type":"codeVoice"},{"type":"text","text":" whose value is this declaration’s."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersets\/linkersetentry(kind:)"]}],"seeAlsoSections":[{"generated":true,"anchor":"Declaring-records","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:uniqueKey:)"],"title":"Declaring records"}],"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets"]]},"metadata":{"modules":[{"name":"LinkerSets"}],"fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetEntry"},{"kind":"text","text":"("},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s6UInt32V","kind":"typeIdentifier","text":"UInt32"},{"kind":"text","text":")"}],"roleHeading":"Macro","remoteSource":{"fileName":"LinkerSetEntry.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSets\/LinkerSetEntry.swift#L32"},"externalID":"s:10LinkerSets0A8SetEntry4kindys6UInt32V_tcfm","role":"symbol","title":"LinkerSetEntry(kind:)","symbolKind":"macro"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)"},"references":{"doc://LinkerSets/documentation/LinkerSets/LinkerSetEntry(kind:uniqueKey:)":{"type":"topic","abstract":[{"text":"Declares a record of ","type":"text"},{"code":"kind","type":"codeVoice"},{"text":" whose value is this declaration’s, and that no other record of","type":"text"},{"text":" ","type":"text"},{"code":"kind","type":"codeVoice"},{"text":" in the same executable or library may share ","type":"text"},{"code":"uniqueKey","type":"codeVoice"},{"text":" with.","type":"text"}],"url":"\/documentation\/linkersets\/linkersetentry(kind:uniquekey:)","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetEntr