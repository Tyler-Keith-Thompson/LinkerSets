{"abstract":[{"type":"text","text":"Every record of one kind, across every image the program has loaded, and the values they"},{"type":"text","text":" "},{"type":"text","text":"produce."}],"seeAlsoSections":[{"anchor":"Finding-records","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind"],"title":"Finding records","generated":true}],"sections":[],"identifier":{"url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/init(kind:)"],"title":"Initializers","generated":true},{"anchor":"Instance-Properties","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/kind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/records","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/values"],"title":"Instance Properties","generated":true}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSet","kind":"identifier"}],"modules":[{"name":"LinkerSets"}],"navigatorTitle":[{"kind":"identifier","text":"LinkerSet"}],"roleHeading":"Structure","role":"symbol","title":"LinkerSet","externalID":"s:10LinkerSets0A3SetV","symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSets\/LinkerSet.swift#L41","fileName":"LinkerSet.swift"}},"relationshipsSections":[{"identifiers":["doc:\/\/LinkerSets\/s8SendableP","doc:\/\/LinkerSets\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSet","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"mentions":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry"],"kind":"mentions"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"Records are declared at compile time as ","type":"text"},{"code":"@used","type":"codeVoice"},{"text":" globals in the section LinkerSets owns. In a","type":"text"},{"text":" ","type":"text"},{"text":"Mach-O image that is ","type":"text"},{"code":"__DATA_CONST,__linker_sets","type":"codeVoice"},{"text":", each record a ","type":"text"},{"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Literal","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"In an ELF image it is the note section ","type":"text"},{"code":".note.linker_sets","type":"codeVoice"},{"text":", each record wrapped in a","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Note","isActive":true},{"text":". In a WebAssembly module it is the data section ","type":"text"},{"code":"linker_sets","type":"codeVoice"},{"text":", and in","type":"text"},{"text":" ","type":"text"},{"text":"a PE image (Windows) the grouped section ","type":"text"},{"code":".lnkset$M","type":"codeVoice"},{"text":", which the linker merges into ","type":"text"},{"code":".lnkset","type":"codeVoice"},{"text":". A","type":"text"},{"text":" ","type":"text"},{"text":"linker set finds them at run time in every image the loader has mapped: the program, the","type":"text"},{"text":" ","type":"text"},{"text":"shared libraries it was linked with, and any loaded later with ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"text":". On Apple platforms it","type":"text"},{"text":" ","type":"text"},{"text":"reads each image’s section through the loader’s list of images; on ELF platforms (Linux,","type":"text"},{"text":" ","type":"text"},{"text":"Android, FreeBSD) it reads each image’s note segments through ","type":"text"},{"code":"dl_iterate_phdr","type":"codeVoice"},{"text":"; on","type":"text"},{"text":" ","type":"text"},{"text":"WebAssembly (WASI), whose program is one statically linked module, it reads the section","type":"text"},{"text":" ","type":"text"},{"text":"between the ","type":"text"},{"code":"__start_linker_sets","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"__stop_linker_sets","type":"codeVoice"},{"text":" symbols wasm-ld defines; on Windows","type":"text"},{"text":" ","type":"text"},{"text":"it reads each loaded module’s ","type":"text"},{"code":".lnkset","type":"codeVoice"},{"text":" section through ","type":"text"},{"code":"K32EnumProcessModules","type":"codeVoice"},{"text":" and the","type":"text"},{"text":" ","type":"text"},{"text":"module’s PE section table, skipping the zero padding the linker may put between contributions:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let routes = LinkerSet<Route>(kind: .routes).values"],"type":"codeListing"},{"inlineContent":[{"text":"Each read asks the loader again, so a read after a ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"text":" includes the new image’s records.","type":"text"},{"text":" ","type":"text"},{"text":"Records come back image by image in the loader’s order, and within an image in the order the","type":"text"},{"text":" ","type":"text"},{"text":"linker laid them out, so two reads with no load between them return the same records in the","type":"text"},{"text":" ","type":"text"},{"text":"same order.","type":"text"},{"text":" ","type":"text"},{"text":"A kind no record was declared with gives an empty set, as does kind 0, which marks an empty","type":"text"},{"text":" ","type":"text"},{"text":"slot.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Records survive dead stripping (","type":"text"},{"code":"-dead_strip","type":"codeVoice"},{"text":", ","type":"text"},{"code":"--gc-sections","type":"codeVoice"},{"text":") in debug and release builds:","type":"text"},{"text":" ","type":"text"},{"text":"each is ","type":"text"},{"code":"@used","type":"codeVoice"},{"text":", and the section is retained. A record reaches the program only when the","type":"text"},{"text":" ","type":"text"},{"text":"linker links its module’s object file, though. SwiftPM links every object of a target’s","type":"text"},{"text":" ","type":"text"},{"text":"dependencies, and so does Bazel’s ","type":"text"},{"code":"swift_library","type":"codeVoice"},{"text":", which is ","type":"text"},{"code":"alwayslink","type":"codeVoice"},{"text":" by default. A build","type":"text"},{"text":" ","type":"text"},{"text":"that links a static archive’s members only on demand drops a module that nothing references","type":"text"},{"text":" ","type":"text"},{"text":"by name. Link such a module whole (","type":"text"},{"code":"-force_load","type":"codeVoice"},{"text":" on Mach-O, ","type":"text"},{"code":"--whole-archive","type":"codeVoice"},{"text":" on ELF).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Reading never traps. A record whose reserved fields aren’t zero, written by a newer layout, is"},{"type":"text","text":" "},{"type":"text","text":"skipped; a section whose size isn’t a whole number of records is read up to its last whole"},{"type":"text","text":" "},{"type":"text","text":"record; on ELF, a note that isn’t LinkerSets’, or whose record size this version doesn’t know,"},{"type":"text","text":" "},{"type":"text","text":"is skipped."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/linkersets\/linkerset"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets"]]},"references":{"doc://LinkerSets/documentation/LinkerSets/LinkerSetRecord":{"navigatorTitle":[{"kind":"identifier","text":"LinkerSetRecord"}],"type":"topic","abstract":[{"text":"One entry in a linker set: a record an attached macro places in the section LinkerSets owns.","type":"text"}],"title":"LinkerSetRecord","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetRecord"}],"kind":"symbol","url":"\/documentation\/linkersets\/linkersetrecord","role":"symbol"},"doc://LinkerSets/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/LinkerSets\/s16SendableMetatypeP"},"doc://LinkerSets/documentation/LinkerSets/LinkerSet/init(kind:)":{"url":"\/documentation\/linkersets\/linkerset\/init(kind:)","abstract":[{"text":"The set of records of ","type":"text"},{"type":"codeVoice","code":"kind"},{"text":".","type":"text"}],"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/init(kind:)","kind":"symbol","role":"symbol","title":"init(kind:)","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"LinkerSetKind","kind":"typeIdentifier","preciseIdentifier":"s:10LinkerSets0A7SetKindV"},{"text":")","kind":"text"}]},"doc://LinkerSets/documentation/LinkerSets/LinkerSetRecord/isSupportedVersion":{"abstract":[{"type":"text","text":"Whether this version of LinkerSets can read the record: its reserved fields are zero, as"},{"type":"text","text":" "},{"type":"text","text":"every record of the current layout’s are."}],"type":"topic","title":"isSupportedVersion","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/isSupportedVersion","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isSupportedVersion","kind":"identifier"},{"text":": ","