pe":"codeVoice"},{"text":" with its terminating","type":"text"},{"text":" ","type":"text"},{"text":"zero, padded to 12 bytes; ","type":"text"},{"code":"descriptorSize","type":"codeVoice"},{"text":", the size of a record (32 bytes where pointers","type":"text"},{"text":" ","type":"text"},{"text":"are 64 bits, 20 where they are 32); and ","type":"text"},{"code":"type","type":"codeVoice"},{"text":" 1. The record follows as the descriptor:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let note: LinkerSetRecord.Note = (11, 32, 1, (76, 105, 110, 107, 101, 114, 83, 101, 116, 115, 0, 0),","                                  (0x726F_7574, 0, { outValue, type, hint, reserved in false }, 0, 0))"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The 24-byte header keeps the record at its own alignment, whether a reader aligns notes to"},{"type":"text","text":" "},{"type":"text","text":"4 bytes or to 8."}],"type":"paragraph"}]}],"metadata":{"roleHeading":"Type Alias","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Note","kind":"identifier"}],"modules":[{"name":"LinkerSetsRuntime"}],"navigatorTitle":[{"kind":"identifier","text":"Note"}],"externalID":"s:17LinkerSetsRuntime0A9SetRecordV4Notea","role":"symbol","title":"LinkerSetRecord.Note","remoteSource":{"fileName":"LinkerSetRecord.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSetsRuntime\/LinkerSetRecord.swift#L74"},"symbolKind":"typealias"},"variants":[{"paths":["\/documentation\/linkersetsruntime\/linkersetrecord\/note"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://LinkerSetsRuntime/documentation/LinkerSetsRuntime":{"abstract":[{"text":"Find every record of a kind at run time, without building any macros.","type":"text"}],"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime","title":"LinkerSetsRuntime","kind":"symbol","rol