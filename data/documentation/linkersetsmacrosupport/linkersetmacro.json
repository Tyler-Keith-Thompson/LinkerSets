{"relationshipsSections":[{"kind":"relationships","title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/LinkerSetsMacroSupport\/s16SendableMetatypeP","doc:\/\/LinkerSetsMacroSupport\/17SwiftSyntaxMacros13AttachedMacroP","doc:\/\/LinkerSetsMacroSupport\/17SwiftSyntaxMacros5MacroP","doc:\/\/LinkerSetsMacroSupport\/17SwiftSyntaxMacros9PeerMacroP"]}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetMacro","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"PeerMacro","kind":"typeIdentifier","preciseIdentifier":"s:17SwiftSyntaxMacros9PeerMacroP"}]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"A client declares its own macro by conforming a type in its compiler plugin and returning","type":"text"},{"text":" ","type":"text"},{"text":"its kind; the expansion is shared:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import LinkerSetsMacroSupport","import SwiftCompilerPlugin","","@main","struct RoutesPlugin: CompilerPlugin {","    let providingMacros: [any Macro.Type] = [RouteMacro.self]","}","","public enum RouteMacro: LinkerSetMacro {","    public static func kind(of attribute: AttributeSyntax) -> UInt32 { 0x726F_7574 }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The expansion is one peer, ","type":"text"},{"code":"#linkerSetRecord(kind:storing:)","type":"codeVoice"},{"text":" (","type":"text"},{"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetRecordMacro","type":"reference","isActive":true},{"text":"), which","type":"text"},{"text":" ","type":"text"},{"text":"the LinkerSets module declares and which expands in turn to a private ","type":"text"},{"code":"@used","type":"codeVoice"},{"text":" declaration,","type":"text"},{"text":" ","type":"text"},{"text":"placed with ","type":"text"},{"code":"@section","type":"codeVoice"},{"text":" in the section LinkerSets owns, whose accessor produces the declaration’s","type":"text"},{"text":" ","type":"text"},{"text":"value:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a static property’s or a global variable’s value;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a static or free function, as a value of its function type;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a struct, enum, class or actor, as its metatype: "},{"type":"codeVoice","code":"any P.Type"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/requiredConformance(of:)"},{"type":"text","text":" names a protocol "},{"type":"codeVoice","code":"P"},{"type":"text","text":", which the type must then conform to or the"},{"type":"text","text":" "},{"type":"text","text":"expansion doesn’t compile, and "},{"type":"codeVoice","code":"Any.Type"},{"type":"text","text":" otherwise."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A function isolated to the main actor, by its own "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" or its type’s or extension’s,"},{"type":"text","text":" "},{"type":"text","text":"is stored as its isolated type ("},{"code":"@MainActor () -> Void","type":"codeVoice"},{"type":"text","text":"), read with"},{"type":"text","text":" "},{"code":"LinkerSet<@MainActor () -> Void>","type":"codeVoice"},{"type":"text","text":" and called on the main actor. A property isolated to the"},{"type":"text","text":" "},{"type":"text","text":"main actor is refused, since the record’s nonisolated accessor can’t read it: one marked"},{"type":"text","text":" "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":", or a "},{"code":"var","type":"codeVoice"},{"type":"text","text":" of a "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" type. Only a written "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" is seen. A custom"},{"type":"text","text":" "},{"type":"text","text":"global actor’s attribute, and isolation a type inherits from a protocol it conforms to, can’t"},{"type":"text","text":" "},{"type":"text","text":"be seen in the syntax, so a member isolated that way fails to compile inside the expansion."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It diagnoses anything else, each with a message of its own: generic functions and types,"},{"type":"text","text":" "},{"type":"text","text":"members of generic types, instance members, protocol requirements, declarations inside a"},{"type":"text","text":" "},{"type":"text","text":"function, closure or accessor, a kind that isn’t a 32-bit literal other than 0, and a unique key"},{"type":"text","text":" "},{"type":"text","text":"that is empty or sits in a private or fileprivate type, unless "},{"type":"reference","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/uniqueKeyInPrivateScope","isActive":true},{"type":"text","text":" says"},{"type":"text","text":" "},{"type":"text","text":"to omit that one."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A member of an extension of a generic type is refused when the extension names generic"},{"type":"text","text":" "},{"type":"text","text":"arguments or has a "},{"type":"codeVoice","code":"where"},{"type":"text","text":" clause. A plain "},{"type":"codeVoice","code":"extension Box"},{"type":"text","text":" of "},{"type":"codeVoice","code":"struct Box<T>"},{"type":"text","text":" doesn’t show that"},{"type":"text","text":" "},{"type":"codeVoice","code":"Box"},{"type":"text","text":" is generic, so the compiler refuses that member in the expansion instead."}],"type":"paragraph"},{"inlineContent":[{"text":"A member’s record names it through the enclosing types, ","type":"text"},{"code":"Scheduler.Jobs.clean","type":"codeVoice"},{"text":", which works","type":"text"},{"text":" ","type":"text"},{"text":"in a class or an actor too.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Before swift-syntax 600 a macro can’t see its lexical context. There a type it registers must"},{"type":"text","text":" "},{"type":"text","text":"be declared at file scope, a member’s record names it through "},{"code":"Self","type":"codeVoice"},{"type":"text","text":", so a static member of a"},{"type":"text","text":" "},{"type":"text","text":"class or an actor fails to compile in the expansion, and the compiler, not the macro, refuses"},{"type":"text","text":" "},{"type":"text","text":"a local declaration or a member of a generic type, with an error in the expansion."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"remoteSource":{"fileName":"LinkerSetMacro.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSetsMacroSupport\/LinkerSetMacro.swift#L60"},"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetMacro","kind":"identifier"}],"role":"symbol","symbolKind":"protocol","navigatorTitle":[{"kind":"identifier","text":"LinkerSetMacro"}],"modules":[{"name":"LinkerSetsMacroSupport"}],"roleHeading":"Protocol","title":"LinkerSetMacro","externalID":"s:22LinkerSetsMacroSupport0a3SetC0P"},"variants":[{"paths":["\/documentation\/linkersetsmacrosupport\/linkersetmacro"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"A macro that turns the declaration it’s attached to into a linker-set record of one kind."}],"kind":"symbol","topicSections":[{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/record