"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10LinkerSets0A7SetKindV","text":"LinkerSetKind","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"The set of records of "},{"type":"codeVoice","code":"kind"},{"type":"text","text":"."}]},"doc://LinkerSets/documentation/LinkerSets/LinkerSet/records":{"title":"records","url":"\/documentation\/linkersets\/linkerset\/records","abstract":[{"text":"Every record of this set’s kind, skipping other kinds’ records, empty slots and records of","type":"text"},{"text":" ","type":"text"},{"text":"a layout this version doesn’t know (","type":"text"},{"isActive":true,"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/isSupportedVersion","type":"reference"},{"text":").","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/records","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"records"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:10LinkerSets0A9SetRecordV","kind":"typeIdentifier","text":"LinkerSetRecord"},{"kind":"text","text":"]"}]},"doc://LinkerSets/documentation/LinkerSets/LinkerSetRecord/Literal":{"kind":"symbol","url":"\/documentation\/linkersets\/linkersetrecord\/literal","title":"LinkerSetRecord.Literal","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Literal","type":"topic","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Literal","kind":"identifier"}],"abstract":[{"text":"A record as a macro writes it: a tuple of the record’s fields, in order.","type":"text"}],"navigatorTitle":[{"text":"Literal","kind":"identifier"}]}}}