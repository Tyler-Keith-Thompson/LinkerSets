saw","text":"Records the linker never saw","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A record is in the program only if its module is. SwiftPM and Bazel link every module a target"},{"type":"text","text":" "},{"type":"text","text":"depends on, so a module whose only job is to declare records still reaches the program. A build"},{"type":"text","text":" "},{"type":"text","text":"that links a static library’s members only when something calls into them leaves such a module"},{"type":"text","text":" "},{"type":"text","text":"out. Link it whole: "},{"code":"-force_load","type":"codeVoice"},{"type":"text","text":" on Apple platforms, "},{"code":"--whole-archive","type":"codeVoice"},{"type":"text","text":" on Linux."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","modules":[{"name":"LinkerSets"}],"role":"article","title":"Finding records"},"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets"]]},"references":{"doc://LinkerSets/documentation/LinkerSets/LinkerSet/records":{"title":"records","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/records","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"records","kind":"identifier"},{"text":": [","kind":"text"},{"text":"LinkerSetRecord","preciseIdentifier":"s:10LinkerSets0A9SetRecordV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/linkersets\/linkerset\/records","abstract":[{"text":"Every record of this set’s kind, skipping other kinds’ records, empty slots and records of","type":"text"},{"text":" ","type":"text"},{"text":"a layout this version doesn’t know (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/