{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersetsruntime\/linkerset"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/init(kind:)"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/kind","doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/records","doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/values"],"generated":true}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/LinkerSetsRuntime\/s8SendableP","doc:\/\/LinkerSetsRuntime\/s16SendableMetatypeP"],"type":"conformsTo"}],"abstract":[{"text":"Every record of one kind, across every image the program has loaded, and the values they","type":"text"},{"text":" ","type":"text"},{"text":"produce.","type":"text"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSet","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Records are declared at compile time as "},{"code":"@used","type":"codeVoice"},{"type":"text","text":" globals in the section LinkerSets owns. In a"},{"type":"text","text":" "},{"type":"text","text":"Mach-O image that is "},{"code":"__DATA_CONST,__linker_sets","type":"codeVoice"},{"type":"text","text":", each record a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/Literal"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"In an ELF image it is the note section "},{"code":".note.linker_sets","type":"codeVoice"},{"type":"text","text":", each record wrapped in a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/Note"},{"type":"text","text":". In a WebAssembly module it is the data section "},{"code":"linker_sets","type":"codeVoice"},{"type":"text","text":", and in"},{"type":"text","text":" "},{"type":"text","text":"a PE image (Windows) the grouped section "},{"code":".lnkset$M","type":"codeVoice"},{"type":"text","text":", which the linker merges into "},{"code":".lnkset","type":"codeVoice"},{"type":"text","text":". A"},{"type":"text","text":" "},{"type":"text","text":"linker set finds them at run time in every image the loader has mapped: the program, the"},{"type":"text","text":" "},{"type":"text","text":"shared libraries it was linked with, and any loaded later with "},{"code":"dlopen","type":"codeVoice"},{"type":"text","text":". On Apple platforms it"},{"type":"text","text":" "},{"type":"text","text":"reads each image’s section through the loader’s list of images; on ELF platforms (Linux,"},{"type":"text","text":" "},{"type":"text","text":"Android) it reads each image’s note segments through "},{"code":"dl_iterate_phdr","type":"codeVoice"},{"type":"text","text":"; on"},{"type":"text","text":" "},{"type":"text","text":"WebAssembly (WASI), whose program is one statically linked module, it reads the section"},{"type":"text","text":" "},{"type":"text","text":"between the "},{"code":"__start_linker_sets","type":"codeVoice"},{"type":"text","text":" and "},{"code":"__stop_linker_sets","type":"codeVoice"},{"type":"text","text":" symbols wasm-ld defines; on Windows"},{"type":"text","text":" "},{"type":"text","text":"it reads each loaded module’s "},{"code":".lnkset","type":"codeVoice"},{"type":"text","text":" section through "},{"code":"K32EnumProcessModules","type":"codeVoice"},{"type":"text","text":" and the"},{"type":"text","text":" "},{"type":"text","text":"module’s PE section table, skipping the zero padding the linker may put between contributions:"}],"type":"paragraph"},{"syntax":"swift","code":["let routes = LinkerSet<Route>(kind: .routes).values"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each read asks the loader again, so a read after a "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":" includes the new image’s records."},{"type":"text","text":" "},{"type":"text","text":"Records come back image by image in the loader’s order, and within an image in the order the"},{"type":"text","text":" "},{"type":"text","text":"linker laid them out, so two reads with no load between them return the same records in the"},{"type":"text","text":" "},{"type":"text","text":"same order."},{"type":"text","text":" "},{"type":"text","text":"A kind no record was declared with gives an empty set, as does kind 0, which marks an empty"},{"type":"text","text":" "},{"type":"text","text":"slot."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Records survive dead stripping ("},{"code":"-dead_strip","type":"codeVoice"},{"type":"text","text":", "},{"code":"--gc-sections","type":"codeVoice"},{"type":"text","text":") in debug and release builds:"},{"type":"text","text":" "},{"type":"text","text":"each is "},{"code":"@used","type":"codeVoice"},{"type":"text","text":", and the section is retained. A record reaches the program only when the"},{"type":"text","text":" "},{"type":"text","text":"linker links its module’s object file, though. SwiftPM links every object of a target’s"},{"type":"text","text":" "},{"type":"text","text":"dependencies, and so does Bazel’s "},{"code":"swift_library","type":"codeVoice"},{"type":"text","text":", which is "},{"code":"alwayslink","type":"codeVoice"},{"type":"text","text":" by default. A build"},{"type":"text","text":" "},{"type":"text","text":"that links a static archive’s members only on demand drops a module that nothing references"},{"type":"text","text":" "},{"type":"text","text":"by name. Link such a module whole ("},{"code":"-force_load","type":"codeVoice"},{"type":"text","text":" on Mach-O, "},{"code":"--whole-archive","type":"codeVoice"},{"type":"text","text":" on ELF)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Reading never traps. A record whose reserved fields aren’t zero, written by a newer layout, is"},{"type":"text","text":" "},{"type":"text","text":"skipped; a section whose size isn’t a whole number of records is read up to its last whole"},{"type":"text","text":" "},{"type":"text","text":"record; on ELF, a note that isn’t LinkerSets’, or whose record size this version doesn’t know,"},{"type":"text","text":" "},{"type":"text","text":"is skipped."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet"},"seeAlsoSections":[{"title":"Finding records","anchor":"Finding-records","identifiers":["doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord","doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetKind"],"generated":true}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSet"}],"symbolKind":"struct","modules":[{"name":"LinkerSetsRuntime"}],"navigatorTitle":[{"text":"LinkerSet","kind":"identifier"}],"remoteSource":{"fileName":"LinkerSet.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSetsRuntime\/LinkerSet.swift#L41"},"externalID":"s:17LinkerSetsRuntime0A3SetV","role":"symbol","roleHeading":"Structure","title":"LinkerSet"},"references":{"doc://LinkerSetsRuntime/documentation/LinkerSe