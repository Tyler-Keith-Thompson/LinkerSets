{"topicSections":[{"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)"],"anchor":"Declaring-records","title":"Declaring records"},{"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind"],"anchor":"Finding-records","title":"Finding records"}],"metadata":{"roleHeading":"Framework","role":"collection","title":"LinkerSets","modules":[{"name":"LinkerSets"}],"externalID":"LinkerSets","symbolKind":"module"},"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Declarations that register themselves at compile time and are found at run time across every module a program links."}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An attached macro emits a small record into a section LinkerSets owns, and a typed run-time API"},{"type":"text","text":" "},{"type":"text","text":"enumerates every record of one kind in a deterministic order. Each record carries a kind, so"},{"type":"text","text":" "},{"type":"text","text":"clients share the mechanism without seeing each other’s records. Failures are typed errors; the"},{"type":"text","text":" "},{"type":"text","text":"run-time API never traps."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A declaration registers itself with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)"},{"type":"text","text":", tagged with a kind: four ASCII"},{"type":"text","text":" "},{"type":"text","text":"characters read as a 32-bit integer. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet"},{"type":"text","text":" of that kind finds every such declaration"},{"type":"text","text":" "},{"type":"text","text":"at run time:"}]},{"type":"codeListing","code":["import LinkerSets","","enum Routes {","    @LinkerSetEntry(kind: 0x726F_7574)  \/\/ \"rout\"","    static let home = Route(path: \"\/\")","}","","let routes = LinkerSet<Route>(kind: LinkerSetKind(rawValue: 0x726F_7574)).values"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A client that registers one kind of thing can give it a macro with the kind fixed, such as"},{"type":"text","text":" "},{"code":"@Route","type":"codeVoice"},{"type":"text","text":", from its own compiler plugin. The LinkerSetsMacroSupport module’s documentation shows"},{"type":"text","text":" "},{"type":"text","text":"how."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSets\/documentation\/LinkerSets"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersets"]}],"references":{"doc://LinkerSets/documentation/LinkerSets":{"url":"\/documentation\/linkersets","title":"LinkerSets","type":"topic","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets","role":"collection","kind":"symbol","abstract":[{"text":"Declarations that register themselves at compile time and are found at run time across every module a program links.","type":"text"}]},"doc://LinkerSets/documentation/LinkerSets/LinkerSetRecord":{"title":"LinkerSetRecord","navigatorTitle":[{"text":"LinkerSetRecord","kind":"identifier"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetRecord","kind":"identifier"}],"abstract":[{"text":"One entry in a linker set: a record an attached macro places in the section LinkerSets owns.","type":"text"}],"url":"\/documentation\/linkersets\/linkersetrecord"},"doc://LinkerSets/documentation/LinkerSets/LinkerSetKind":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetKind","kind":"identifier"}],"url":"\/documentation\/linkersets\/linkersetkind","title":"LinkerSetKind","type":"topic","kind":"symbol","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind","abstract":[{"type":"text","text":"The tag that says which client a linker-set record belongs to."}],"role":"symbol","navigatorTitle":[{"text":"LinkerSetKind","kind":"identifier"}]},"doc://LinkerSets/documentation/LinkerSets/LinkerSet":{"type":"topic","navigatorTitle":[{"text":"LinkerSet","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/linkersets\/linkerset","title":"LinkerSet","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSet","kind":"identifier"}],"abstract":[{"type":"text","text":"Every record of one kind, across every image the program has loaded, and the values they"},{"type":"text","text":" "},{"type":"text","text":"produce."}]},"doc://LinkerSets/documentation/LinkerSets/LinkerSetEntry(kind:)":{"url":"\/documentation\/linkersets\/linkersetentry(kind:)","title":"LinkerSetEntry(kind:)","type":"topic","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)","role":"symbol","kind":"symbol","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetEntry","kind":"identifier"},{"text":"(","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt32","kind":"typeIdentifier","preciseIdentifier":"s:s6UInt32V"},{"text":")","kind":"text"}],"abstract":[{"text":"Declares a record of ","type":"text"},{"type":"codeVoice","code":"kind"},{"text":" whose value is this declaration’s.","type":"text"}]}}}