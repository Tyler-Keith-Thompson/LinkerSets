,"text":" "},{"type":"text","text":"no record, and a "},{"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","isActive":true},{"type":"text","text":" of it is always empty."}]}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord"],"anchor":"Finding-records","title":"Finding records","generated":true}],"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets"]]},"sections":[],"identifier":{"url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Structure","modules":[{"name":"LinkerSets"}],"symbolKind":"struct","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LinkerSetKind"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSets\/LinkerSetKind.swift#L19","fileName":"LinkerSetKind.swift"},"externalID":"s:10LinkerSets0A7SetKindV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetKind","kind":"identifier"}],"title":"LinkerSetKind"},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind\/init(rawValue:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind\/rawValue"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind\/Equatable-Implementations","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind\/RawRepresentable-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"abstract":[{"type":"text","text":"The tag that says which client a linker-set record belongs to."}],"references"