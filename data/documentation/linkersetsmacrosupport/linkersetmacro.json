{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetMacro"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:17SwiftSyntaxMacros9PeerMacroP","kind":"typeIdentifier","text":"PeerMacro"}]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A client declares its own macro by conforming a type in its compiler plugin and returning"},{"type":"text","text":" "},{"type":"text","text":"its kind; the expansion is shared:"}],"type":"paragraph"},{"syntax":"swift","code":["import LinkerSetsMacroSupport","import SwiftCompilerPlugin","","@main","struct RoutesPlugin: CompilerPlugin {","    let providingMacros: [any Macro.Type] = [RouteMacro.self]","}","","public enum RouteMacro: LinkerSetMacro {","    public static func kind(of attribute: AttributeSyntax) -> UInt32 { 0x726F_7574 }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The expansion is a private "},{"type":"codeVoice","code":"@used"},{"type":"text","text":" peer, placed with "},{"type":"codeVoice","code":"@section"},{"type":"text","text":" in the section LinkerSets"},{"type":"text","text":" "},{"type":"text","text":"owns, whose accessor produces the declaration’s value:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"a static property’s or a global variable’s value;"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"a static or free function, as a value of its function type;","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"a struct, enum, class or actor, as its metatype: ","type":"text"},{"code":"any P.Type","type":"codeVoice"},{"text":" when","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/requiredConformance(of:)"},{"text":" names a protocol ","type":"text"},{"code":"P","type":"codeVoice"},{"text":", which the type must then conform to or the","type":"text"},{"text":" ","type":"text"},{"text":"expansion doesn’t compile, and ","type":"text"},{"code":"Any.Type","type":"codeVoice"},{"text":" otherwise.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A function isolated to the main actor, by its own ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" or its type’s or extension’s,","type":"text"},{"text":" ","type":"text"},{"text":"is stored as its isolated type (","type":"text"},{"code":"@MainActor () -> Void","type":"codeVoice"},{"text":"), read with","type":"text"},{"text":" ","type":"text"},{"code":"LinkerSet<@MainActor () -> Void>","type":"codeVoice"},{"text":" and called on the main actor. A property isolated to the","type":"text"},{"text":" ","type":"text"},{"text":"main actor is refused, since the record’s nonisolated accessor can’t read it: one marked","type":"text"},{"text":" ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":", or a ","type":"text"},{"code":"var","type":"codeVoice"},{"text":" of a ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" type. Only a written ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" is seen. A custom","type":"text"},{"text":" ","type":"text"},{"text":"global actor’s attribute, and isolation a type inherits from a protocol it conforms to, can’t","type":"text"},{"text":" ","type":"text"},{"text":"be seen in the syntax, so a member isolated that way fails to compile inside the expansion.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It diagnoses anything else, each with a message of its own: generic functions and types,"},{"type":"text","text":" "},{"type":"text","text":"members of generic types, instance members, protocol requirements, declarations inside a"},{"type":"text","text":" "},{"type":"text","text":"function, closure or accessor, and a kind that isn’t a 32-bit literal other than 0."}],"type":"paragraph"},{"inlineContent":[{"text":"Before swift-syntax 600 a macro can’t see its lexical context. There a type it registers must","type":"text"},{"text":" ","type":"text"},{"text":"be declared at file scope, and the compiler, not the macro, refuses a local declaration or a","type":"text"},{"text":" ","type":"text"},{"text":"member of a generic type, with an error in the expansion.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","sections":[],"metadata":{"remoteSource":{"fileName":"LinkerSetMacro.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSetsMacroSupport\/LinkerSetMacro.swift#L48"},"modules":[{"name":"LinkerSetsMacroSupport"}],"externalID":"s:22LinkerSetsMacroSupport0a3SetC0P","symbolKind":"protocol","title":"LinkerSetMacro","roleHeading":"Protocol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetMacro","kind":"identifier"}],"navigatorTitle":[{"text":"LinkerSetMacro","kind":"identifier"}]},"abstract":[{"text":"A macro that turns the declaration it’s attached to into a linker-set record of one kind.","type":"text"}],"topicSections":[{"generated":true,"anchor":"Type-Methods","identifiers":["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/kind(of:)","doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/kindArgument(of:)","doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/requiredConformance(of:)"],"title":"Type Methods"}],"relationshipsSections":[{"kind":"relationships","type":"inheritsFrom","identifiers":["doc:\/\/LinkerSetsMacroSupport\/s16SendableMetatypeP","doc:\/\/LinkerSetsMacroSupport\/17SwiftSynta