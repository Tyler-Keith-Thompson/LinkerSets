{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Read every declaration of a kind, as the type you expect.","type":"text"}],"identifier":{"url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","doc:\/\/LinkerSets\/documentation\/LinkerSets\/UniqueKeys","doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking","doc:\/\/LinkerSets\/documentation\/LinkerSets\/Performance"],"title":"Guides","anchor":"Guides","generated":true}],"sections":[],"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets"]]},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"LinkerSets"}],"title":"Finding records"},"kind":"article","primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet","isActive":true},{"type":"text","text":" names a kind and a type. Its "},{"type":"reference","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/values","isActive":true},{"type":"text","text":" are the values of every record of"},{"type":"text","text":" "},{"type":"text","text":"that kind that produces the type:"}],"type":"paragraph"},{"syntax":"swift","code":["let routes = LinkerSet<Route>(kind: .routes).values"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"What you ask for depends on what was marked:"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Marked declaration","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Ask for","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"static let home = Route(path: \"\/\")"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LinkerSet<Route>","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"static func migrate(_ db: inout Database)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LinkerSet<(inout Database) -> Void>","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"@MainActor static func show()","type":"codeVoice"},{"type":"text","text":", or a static func of a "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" type"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LinkerSet<@MainActor () -> Void>","type":"codeVoice"},{"text":", read on the main actor","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"struct Login: AnalyticsEvent"},{"type":"text","text":", with "},{"type":"codeVoice","code":"@LinkerSetEntry"}],"type":"paragraph"}],[{"inlineContent":[{"code":"LinkerSet<Any.Type>","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"struct Login: AnalyticsEvent","type":"codeVoice"},{"text":", with a macro requiring ","type":"text"},{"code":"AnalyticsEvent","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"LinkerSet<any AnalyticsEvent.Type>"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"A record of the right kind but another type is left out of "},{"type":"codeVoice","code":"values"},{"type":"text","text":". Nothing traps, and nothing"},{"type":"text","text":" "},{"type":"text","text":"throws: a set with no matching records is empty."}],"type":"paragraph"},{"level":3,"text":"Types registered by hand","anchor":"Types-registered-by-hand","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"@LinkerSetEntry"},{"type":"text","text":" on a type stores it as "},{"type":"codeVoice","code":"Any.Type"},{"type":"text","text":", so a "},{"type":"codeVoice","code":"LinkerSet<any Step.Type>"},{"type":"text","text":" doesn’t find"},{"type":"text","text":" "},{"type":"text","text":"it. A client macro that requires "},{"type":"codeVoice","code":"Step"},{"type":"text","text":" stores "},{"type":"codeVoice","code":"any Step.Type"},{"type":"text","text":"; until there is one (or in tests"},{"type":"text","text":" "},{"type":"text","text":"that use a kind of their own), mark a static let typed as the existential metatype:"}],"type":"paragraph"},{"syntax":"swift","code":["protocol Step: SendableMetatype {","    static var name: String { get }","}","","struct First: Step { static let name = \"first\" }","","enum Steps {","    @LinkerSetEntry(kind: .steps)","    static let first: any Step.Type = First.self","}","","let steps = LinkerSet<any Step.Type>(kind: .steps).values"],"type":"codeListing"},{"inlineContent":[{"code":"Step","type":"codeVoice"},{"type":"text","text":" refines "},{"code":"SendableMetatype","type":"codeVoice"},{"type":"text","text":" because a static let must be "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" in Swift 6, and"},{"type":"text","text":" "},{"code":"any Step.Type","type":"codeVoice"},{"type":"text","text":" is "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" only when the protocol says its metatypes are. Without it the"},{"type":"text","text":" "},{"type":"text","text":"compiler warns that the property isn’t concurrency-safe ("},{"code":"MutableGlobalVariable","type":"codeVoice"},{"type":"text","text":"), which is an"},{"type":"text","text":" "},{"type":"text","text":"error in a build that treats warnings as errors. A "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" protocol, such as a UIKit delegate"},{"type":"text","text":" "},{"type":"text","text":"protocol, refines it the same way."}],"type":"paragraph"},{"level":3,"text":"Order","anchor":"Order","type":"heading"},{"inlineContent":[{"type":"text","text":"Records come back image by image in the order the loader lists them (the program, then its"},{"type":"text","text":" "},{"type":"text","text":"libraries, then each library loaded later), and within an image in the order the linker laid them"},{"type":"text","text":" "},{"type":"text","text":"out. The order is stable from one read to the next while nothing new is loaded, but it isn’t one"},{"type":"text","text":" "},{"type":"text","text":"you choose. Sort the values when order matters:"}],"type":"paragraph"},{"syntax":"swift","code":["let migrations = LinkerSet<Migration>(kind: .migrations).values.sorted { $0.version < $1.version }"],"type":"codeListing"},{"level":3,"text":"When records are read","anchor":"When-records-are-read","type":"heading"},{"inlineContent":[{"type":"text","text":"Nothing runs at launch. Each read of "},{"type":"codeVoice","code":"values"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/records"},{"type":"text","text":" asks the loader for its"},{"type":"text","text":" "},{"type":"text","text":"images and walks their records, so a read after "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":" includes the new library’s records. A read"},{"type":"text","text":" "},{"type":"text","text":"walks every record of every kind, O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") in their number; keep the result rather than reading it in"},{"type":"text","text":" "},{"type":"text","text":"a hot loop."}],"type":"paragraph"},{"level":3,"text":"Records one at a time","anchor":"Records-one-at-a-time","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/records","isActive":true},{"type":"text","text":" gives the records themselves, of the set’s kind, before any type is asked"},{"type":"text","text":" "},{"type":"text","text":"for. "},{"type":"reference","identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/value(as:)","isActive":true},{"type":"text","text":" asks one record for a value and says why it can’t produce one:"}],"type":"paragraph"},{"syntax":"swift","code":["for record in LinkerSet<Route>(kind: .routes).records {","    do {","        let route = try record.value(as: Route.self)","        print(route.path)","    } catch .typeMismatch {","        \/\/ A record of this kind that holds something else.","    } catch {","        \/\/ .emptySlot or .unsupportedVersion: the set already leaves these out.","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A record whose reserved fields aren’t zero was written by a newer layout of the library; the set"},{"type":"text","text":" "},{"type":"text","text":"skips it rather than call an accessor whose contract it doesn’t know."}],"type":"paragraph"},{"level":3,"text":"Records the linker never saw","anchor":"Records-the-linker-never-saw","type":"heading"},{"inlineContent":[{"text":"A record is in the program only if its object file is. SwiftPM, and Bazel for ","type":"text"},{"code":"swift_library","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(whose ","type":"text"},{"code":"alwayslink","type":"codeVoice"},{"text":" defaults to ","type":"text"},{"code":"True","type":"codeVoice"},{"text":"), link every object file of each module a target depends","type":"text"},{"text":" ","type":"text"},{"text":"on, so a module whose only job is to declare records still reaches the program. A build that","type":"text"},{"text":" ","type":"text"},{"text":"links a static archive’s members only when something references them leaves such a file out,","type":"text"},{"text":" ","type":"text"},{"text":"even from a module the program calls into. Link it whole: ","type":"text"},{"code":"-force_load","type":"codeVoice"},{"text":" on Apple platforms,","type":"text"},{"text":" ","type":"text"},{"code":"--whole-archive","type":"codeVoice"},{"text":" on Linux, ","type":"text"},{"code":"alwayslink = True","type":"codeVoice"},{"text":" on a Bazel ","type":"text"},{"code":"cc_library","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"objc_library","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"-ObjC","type":"codeVoice"},{"text":" isn’t enough; ","type":"text"},{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking#Linking-modes","isActive":true,"type":"reference"},{"text":" says what it keeps.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersets\/findingrecords"]}],"references":{"doc://LinkerSetsRuntime/documentation/LinkerSetsRuntime/LinkerSet":{"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet","type":"topic","url":"\/documentation\/linkersetsruntime\/linkerset","abstract":[{"type":"text","text":"Every record of one kind, across every image the program has loaded, and the values they"},{"type":"text","text":" "},{"type":"text","text":"produce."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LinkerSet"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSet"}],"title":"LinkerSet","kind":"symbol"},"doc://LinkerSetsRuntime/documentation/LinkerSetsRuntime/LinkerSet/values":{"kind":"symbol","type":"topic","url":"\/documentation\/linkersetsruntime\/linkerset\/values","abstract":[{"type":"text","text":"The value of each record that produces a "},{"code":"Value","type":"codeVoice"},{"type":"text","text":", in the order of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/records"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"values","kind":"identifier"},{"text":": [","kin