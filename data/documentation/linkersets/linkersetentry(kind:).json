SetEntry(kind: 0x726F_7574)","    static let home = Route(path: \"\/\")","}","","let routes = LinkerSet<Route>(kind: LinkerSetKind(rawValue: 0x726F_7574)).values"]},{"inlineContent":[{"type":"text","text":"The kind is an integer literal from 1 through "},{"type":"codeVoice","code":"UInt32.max"},{"type":"text","text":"; kind 0 is reserved for empty"},{"type":"text","text":" "},{"type":"text","text":"slots. A record produces its value only for a request of exactly its type: a function"},{"type":"text","text":" "},{"type":"codeVoice","code":"func f(_ x: Int) -> String"},{"type":"text","text":" is found by "},{"type":"codeVoice","code":"LinkerSet<(Int) -> String>"},{"type":"text","text":", and a type by"},{"type":"text","text":" "},{"type":"codeVoice","code":"LinkerSet<Any.Type>"},{"type":"text","text":". A client whose types share a protocol reads them as "},{"type":"codeVoice","code":"any P.Type"},{"type":"text","text":" through"},{"type":"text","text":" "},{"type":"text","text":"a macro of its own that requires it (LinkerSetsMacroSupport’s "},{"type":"codeVoice","code":"LinkerSetMacro"},{"type":"text","text":")."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersets\/linkersetentry(kind:)"]}],"metadata":{"externalID":"s:10LinkerSets0A8SetEntry4kindys6UInt32V_tcfm","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetEntry","kind":"identifier"},{"text":"(","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt32","kind":"typeIdentifier","preciseIdentifier":"s:s6UInt32V"},{"text":")","kind":"text"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSets\/LinkerSetEntry.swift#L26","fileName":"LinkerSetEntry.swift"},"modules":[{"name":"LinkerSets"}],"title":"LinkerSetEntry(kind:)","roleHeading":"Macro","role":"symbol","symbolKind":"macro"},"abstract":[{"type":"text","text":"D