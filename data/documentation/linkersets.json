{"metadata":{"externalID":"LinkerSets","symbolKind":"module","role":"collection","title":"LinkerSets","modules":[{"name":"LinkerSets"}],"roleHeading":"Framework"},"abstract":[{"type":"text","text":"Declarations that register themselves at compile time and are found at run time across every module a program links."}],"topicSections":[{"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking"]},{"title":"Declaring records","anchor":"Declaring-records","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)"]},{"title":"Finding records","anchor":"Finding-records","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind"]}],"kind":"symbol","variants":[{"paths":["\/documentation\/linkersets"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"An attached macro emits a small record into a section LinkerSets owns, and a typed run-time API"},{"type":"text","text":" "},{"type":"text","text":"enumerates every record of one kind in a deterministic order. Each record carries a kind, so"},{"type":"text","text":" "},{"type":"text","text":"clients share the mechanism without seeing each other’s records. Failures are typed errors; the"},{"type":"text","text":" "},{"type":"text","text":"run-time API never traps."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A declaration registers itself with "},{"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)","isActive":true},{"type":"text","text":", tagged with a kind: four ASCII"},{"type":"text","text":" "},{"type":"text","text":"characters read as a 32-bit integer. A "},{"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","isActive":true},{"type":"text","text":" of that kind finds every such declaration"},{"type":"text","text":" "},{"type":"text","text":"at run time:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import LinkerSets","","enum Routes {","    @LinkerSetEntry(kind: 0x726F_7574)  \/\/ \"rout\"","    static let home = Route(path: \"\/\")","}","","let routes = LinkerSet<Route>(kind: LinkerSetKind(rawValue: 0x726F_7574)).values"]},{"inlineContent":[{"type":"text","text":"A client that registers one kind of thing can give it a macro with the kind fixed, such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Route"},{"type":"text","text":", from its own compiler plugin. The LinkerSetsMacroSupport module’s documentation shows"},{"type":"text","text":" "},{"type":"text","text":"how."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSets\/documentation\/LinkerSets"},"references":{"doc://LinkerSets/documentation/LinkerSets/LinkerSetKind":{"abstract":[{"type":"text","text":"The tag that says which client a linker-set record belongs to."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetKind","kind":"identifier"}],"navigatorTitle":[{"text":"LinkerSetKind","kind":"identifier"}],"kind":"symbol","title":"LinkerSetKind","url":"\/documentation\/linkersets\/linkersetkind","type":"topic","role":"symbol","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind"},"doc://LinkerSets/documentation/LinkerSets/LinkerSet":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSet","kind":"identifier"}],"abstract":[{"text":"Every record of one kind, across every image the program has loaded, and the values they","type":"text"},{"text":" ","type":"text"},{"text":"produce.","type":"text"}],"title":"LinkerSet","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","url":"\/documentation\/linkersets\/linkerset","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"LinkerSet","kind":"identifier"}]},"doc://LinkerSets/documentation/LinkerSets/ReplacingARegistry":{"title":"Replacing a hand-written registry","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","kind":"article","abstract":[{"type":"text","text":"Move a central list of event types, routes or registrations onto declarations that find"},{"type":"text","text":" "},{"type":"text","text":"themselves."}],"type":"topic","role":"article","url":"\/documentation\/linkersets\/replacingaregistry"},"doc://LinkerSets/documentation/LinkerSets/DeclaringAKind":{"abstract":[{"text":"Pick the number that tags your declarations, and decide whether your users write it.","type":"text"}],"title":"Declaring a kind","url":"\/documentation\/linkersets\/declaringakind","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","kind":"article","type":"topic","role":"article"},"doc://LinkerSets/documentation/LinkerSets/WhatTheMacrosRefuse":{"title":"What the macros refuse","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","kind":"article","abstract":[{"text":"Every declaration a record can’t describe is a compile error, with a message that says why.","type":"text"}],"type":"topic","role":"article","url":"\/documentation\/linkersets\/whatthemacrosrefuse"},"doc://LinkerSets/documentation/LinkerSets/FindingRecords":{"title":"Finding records","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","kind":"article","a