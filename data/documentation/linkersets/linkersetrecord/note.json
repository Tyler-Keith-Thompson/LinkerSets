type":"text"},{"type":"codeVoice","code":"descriptorSize"},{"text":", the size of a record (32 bytes where pointers","type":"text"},{"text":" ","type":"text"},{"text":"are 64 bits, 20 where they are 32); and ","type":"text"},{"type":"codeVoice","code":"type"},{"text":" 1. The record follows as the descriptor:","type":"text"}],"type":"paragraph"},{"code":["let note: LinkerSetRecord.Note = (11, 32, 1, (76, 105, 110, 107, 101, 114, 83, 101, 116, 115, 0, 0),","                                  (0x726F_7574, 0, { outValue, type, hint, reserved in false }, 0, 0))"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The 24-byte header keeps the record at its own alignment, whether a reader aligns notes to"},{"type":"text","text":" "},{"type":"text","text":"4 bytes or to 8."}],"type":"paragraph"}]}],"metadata":{"externalID":"s:10LinkerSets0A9SetRecordV4Notea","roleHeading":"Type Alias","modules":[{"name":"LinkerSets"}],"navigatorTitle":[{"text":"Note","kind":"identifier"}],"title":"LinkerSetRecord.Note","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSets\/LinkerSetRecord.swift#L74","fileName":"LinkerSetRecord.swift"},"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Note"}],"symbolKind":"typealias","role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Note"},"sections":[],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://LinkerSets/documentation/LinkerSets/LinkerSet":{"navigatorTitle":[{"text":"LinkerSet","kind":"identifier"}],"url":"\/documentation\/linkersets\/linkerset","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","abstract":[{"type":"text","text":"Every record of one kind, across every image the program has loaded, and the values they"},{"type":"text","text":" "},{"type":"text","text":"produc