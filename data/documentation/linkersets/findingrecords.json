stract":[{"type":"text","text":"Declarations that register themselves at compile time and are found at run time across every module a program links."}],"type":"topic","role":"collection","title":"LinkerSets"},"doc://LinkerSets/documentation/LinkerSets/WhatTheMacrosRefuse":{"url":"\/documentation\/linkersets\/whatthemacrosrefuse","type":"topic","kind":"article","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","role":"article","title":"What the macros refuse","abstract":[{"type":"text","text":"Every declaration a record can’t describe is a compile error, with a message that says why."}]}}}