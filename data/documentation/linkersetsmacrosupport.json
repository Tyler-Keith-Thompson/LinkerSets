{"identifier":{"url":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersetsmacrosupport"]}],"metadata":{"externalID":"LinkerSetsMacroSupport","roleHeading":"Framework","symbolKind":"module","role":"collection","modules":[{"name":"LinkerSetsMacroSupport"}],"title":"LinkerSetsMacroSupport"},"topicSections":[{"title":"Declaring a macro","identifiers":["doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro"],"anchor":"Declaring-a-macro"}],"kind":"symbol","abstract":[{"text":"The expansion behind every linker-set macro, for clients that declare a kind and a macro of","type":"text"},{"text":" ","type":"text"},{"text":"their own.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@LinkerSetEntry(kind:)"},{"type":"text","text":" takes its kind as an argument. A client that registers one kind of"},{"type":"text","text":" "},{"type":"text","text":"thing (routes, events, migrations) gives it a macro that fixes the kind instead, so its users"},{"type":"text","text":" "},{"type":"text","text":"write "},{"type":"codeVoice","code":"@Route"},{"type":"text","text":" and never see a number. That takes three declarations."}]},{"type":"paragraph","inlineContent":[{"text":"The client’s compiler plugin, a ","type":"text"},{"code":".macro","type":"codeVoice"},{"text":" target that depends on this module, names the kind:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import LinkerSetsMacroSupport","import SwiftCompilerPlugin","","@main","struct RoutesMacrosPlugin: CompilerPlugin {","    let providingMacros: [any Macro.Type] = [RouteMacro.self]","}","","public enum RouteMacro: LinkerSetMacro {","    public static func kind(of attribute: AttributeSyntax) -> UInt32 { 0x726F_7574 }  \/\/ \"rout\"","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The client’s library declares the macro and the same kind for reading. It re-exports LinkerSets,"},{"type":"text","text":" "},{"type":"text","text":"because the expansion names LinkerSets’ types in its users’ files:"}]},{"type":"codeListing","syntax":"swift","code":["@_exported import LinkerSets","","extension LinkerSetKind {","    public static let routes = LinkerSetKind(rawValue: 0x726F_7574)","}","","@attached(peer)","public macro Route() = #externalMacro(module: \"RoutesMacros\", type: \"RouteMacro\")"]},{"type":"paragraph","inlineContent":[{"text":"Its users then register and find routes:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["enum Endpoints {","    @Route static let home = Endpoint(path: \"\/\")","}","","let endpoints = LinkerSet<Endpoint>(kind: .routes).values"]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro"},{"text":" writes the same record ","type":"text"},{"type":"codeVoice","code":"@LinkerSetEntry"},{"text":" writes, in the same section, and its","type":"text"},{"text":" ","type":"text"},{"text":"diagnostics name the client’s attribute (","type":"text"},{"type":"codeVoice","code":"'@Route' applies to static members only"},{"text":"). Each kind","type":"text"},{"text":" ","type":"text"},{"text":"is a set of its own, so two clients in one program never see each other’s records as long as","type":"text"},{"text":" ","type":"text"},{"text":"their kinds differ. Kind 0 is reserved, and the expansion refuses it.","type":"text"}]},{"level":3,"type":"heading","text":"Registering types","anchor":"Registering-types"},{"type":"paragraph","inlineContent":[{"text":"A macro attached to a struct, enum, class or actor stores the type’s metatype. To read the types","type":"text"},{"text":" ","type":"text"},{"text":"as a protocol they share, without casting, the plugin names that protocol in","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/requiredConformance(of:)"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public enum EventMacro: LinkerSetMacro {","    public static func kind(of attribute: AttributeSyntax) -> UInt32 { 0x6576_6E74 }  \/\/ \"evnt\"","","    public static func requiredConformance(of attribute: AttributeSyntax) -> TypeSyntax? {","        \"Events.AnalyticsEvent\"","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Each record then holds ","type":"text"},{"code":"any AnalyticsEvent.Type","type":"codeVoice"},{"text":", read with","type":"text"},{"text":" ","type":"text"},{"code":"LinkerSet<any AnalyticsEvent.Type>(kind: .events).values","type":"codeVoice"},{"text":". A type that doesn’t conform fails to","type":"text"},{"text":" ","type":"text"},{"text":"compile where it’s declared: “cannot convert value of type ‘NotAnEvent.Type’ to type","type":"text"},{"text":" ","type":"text"},{"text":"‘any AnalyticsEvent.Type’”. Qualify the protocol with its module so a type of the same name at","type":"text"},{"text":" ","type":"text"},{"text":"the use site can’t stand in for it. Without a required protocol, a type’s record holds","type":"text"},{"text":" ","type":"text"},{"code":"Any.Type","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A registered type can be nested in another from swift-syntax 600 on. Before 600 a macro can’t","type":"text"},{"text":" ","type":"text"},{"text":"see where its declaration sits, so the type must be declared at file scope.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A macro that takes its kind as an argument can return "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/kindArgument(of:)"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/kind(of:)"},{"type":"text","text":"."}]}]}],"references":{"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetMacro/kindArgument(of:)":{"title":"kindArgument(of:)","kind":"symbol","url":"\/documentation\/linkersetsmacrosupport\/linkersetmacro\/kindargument(of:)","type":"topic","role":"symbol","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/kindArgument(of:)","abstract":[{"type":"text","text":"The attribute’s "},{"type":"codeVoice","code":"kind:"},{"type":"text","text":" argument: an integer literal from 1 through "},{"type":"codeVoice","code":"UInt32.max"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"kindArgument"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11SwiftSyntax09AttributeB0V","kind":"typeIdentifier","text":"AttributeSyntax"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:s6UInt32V","kind":"typeIdentifier","text":"UInt32"}]},"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetMacro/kind(of:)":{"required":true,"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/kind(of:)","url":"\/documentation\/linkersetsmacrosupport\/linkersetmacro\/kind(of:)","title":"kind(of:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"f