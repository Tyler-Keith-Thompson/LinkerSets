# Unique keys the linker checks (tools/link_test.bzl): two modules with an event of the same name
# fail to link, one of them read from its archive on demand; two with different names link, and
# both records are read; two keys alike in one module fail to compile.

swift_library(
    name = "Orders",
    testonly = True,
    srcs = ["Orders/OrderPlaced.swift"],
    module_name = "Orders",
    plugins = ["//Sources/ExampleEventsMacros", "//Sources/LinkerSetsMacros"],
    deps = ["//Sources/ExampleEvents"],
)

swift_library(
    name = "Checkout",
    testonly = True,
    srcs = ["Checkout/OrderPlaced.swift"],
    module_name = "Checkout",
    plugins = ["//Sources/ExampleEventsMacros", "//Sources/LinkerSetsMacros"],
    deps = ["//Sources/ExampleEvents"],
)

swift_library(
    name = "Shipping",
    testonly = True,
    srcs = ["Shipping/OrderShipped.swift"],
    module_name = "Shipping",
    plugins = ["//Sources/ExampleEventsMacros", "//Sources/LinkerSetsMacros"],
    deps = ["//Sources/ExampleEvents"],
)

swift_link_test(
    name = "DuplicateEventNames",
    size = "small",
    expected_errors = ["$linkerset_kind_65766E74_key_OrderPlaced"],
    main = "DuplicateEventNames.swift",
    on_demand = [":Checkout"],
    tags = ["debug-only"],
    deps = [":Checkout", ":Orders"],
)

swift_link_test(
    name = "DistinctEventNames",
    size = "small",
    main = "DistinctEventNames.swift",
    on_demand = [":Shipping"],
    tags = ["debug-only"],
    deps = [":Orders", ":Shipping"],
)

swift_link_test(
    name = "DuplicateKeyInOneModule",
