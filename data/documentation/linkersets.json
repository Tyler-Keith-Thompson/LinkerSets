chanism without seeing each other’s records. Failures are typed errors; the","type":"text"},{"text":" ","type":"text"},{"text":"run-time API never traps.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A declaration registers itself with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)"},{"type":"text","text":", tagged with a kind: four ASCII"},{"type":"text","text":" "},{"type":"text","text":"characters read as a 32-bit integer. A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet"},{"type":"text","text":" of that kind finds every such declaration"},{"type":"text","text":" "},{"type":"text","text":"at run time:"}]},{"type":"codeListing","syntax":"swift","code":["import LinkerSets","","enum Routes {","    @LinkerSetEntry(kind: 0x726F_7574)  \/\/ \"rout\"","    static let home = Route(path: \"\/\")","}","","let routes = LinkerSet<Route>(kind: LinkerSetKind(rawValue: 0x726F_7574)).values"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A client that registers one kind of thing can give it a macro with the kind fixed, such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Route"},{"type":"text","text":", from its own compiler plugin. The LinkerSetsMacroSupport module’s documentation shows"},{"type":"text","text":" "},{"type":"text","text":"how."}]}]}],"references":{"doc://LinkerSets/documentation/LinkerSets/WhatTheMacrosRefuse":{"role":"article","kind":"article","url":"\/documentation\/linkersets\/whatthemacrosrefuse","title":"What the macros refuse","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","abstract":[{"text":"Every declaration a record can’t describe is a compile error, with a message that says why.","type":"text"}],"type":"topic"},"doc://LinkerSets/documentation/LinkerSets/PlatformsAndLinking":{"identifier":"doc:\/\/LinkerSets\/