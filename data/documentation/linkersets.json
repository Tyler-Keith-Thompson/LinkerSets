{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An attached macro emits a small record into a section LinkerSets owns, and a typed run-time API"},{"type":"text","text":" "},{"type":"text","text":"enumerates every record of one kind in a deterministic order. Each record carries a kind, so"},{"type":"text","text":" "},{"type":"text","text":"clients share the mechanism without seeing each other’s records. Failures are typed errors; the"},{"type":"text","text":" "},{"type":"text","text":"run-time API never traps."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A declaration registers itself with "},{"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)","isActive":true},{"type":"text","text":", tagged with a kind: four ASCII"},{"type":"text","text":" "},{"type":"text","text":"characters read as a 32-bit integer. A "},{"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","isActive":true},{"type":"text","text":" of that kind finds every such declaration"},{"type":"text","text":" "},{"type":"text","text":"at run time:"}]},{"type":"codeListing","syntax":"swift","code":["import LinkerSets","","enum Routes {","    @LinkerSetEntry(kind: 0x726F_7574)  \/\/ \"rout\"","    static let home = Route(path: \"\/\")","}","","let routes = LinkerSet<Route>(kind: LinkerSetKind(rawValue: 0x726F_7574)).values"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A client that registers one kind of thing can give it a macro with the kind fixed, such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Route"},{"type":"text","text":", from its own compiler plugin. The LinkerSetsMacroSupport module’s documentation shows"},{"type":"text","text":" "},{"type":"text","text":"how."}]}],"kind":"content"}],"kind":"symbol","topicSections":[{"anchor":"Declaring-records","title":"Declaring records","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)"]},{"anchor":"Finding-records","title":"Finding records","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind"]}],"hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"LinkerSets"}],"roleHeading":"Framework","title":"LinkerSets","externalID":"LinkerSets","symbolKind":"module","role":"collection"},"sections":[],"abstract":[{"type":"text","text":"Declarations that register themselves at compile time and are found at run time across every module a program links."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersets"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSets\/documentation\/LinkerSets"},"references":{"doc://LinkerSets/documentation/LinkerSets/LinkerSetEntry(kind:)":{"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSetEntry","kind":"identifier"},{"text":"(","kind":"text"},{"text":"kind","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt32","kind":"typeIdentifier","preciseIdentifier":"s:s6UInt32V"},{"text":")","kind":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/linkersets\/linkersetentry(kind:)","abstract":[{"text":"Declares a record of ","type":"text"},{"code":"kind","type":"codeVoice"},{"text":" whose value is this declaration’s.","type":"text"}],"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:)","type":"topic","title":"LinkerSetEntry(kind:)"},"doc://LinkerSets/documentation/LinkerSets/LinkerSetRecord":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetRecord"}],"navigatorTitle":[{"kind":"identifier","text":"LinkerSetRecord"}],"kind":"symbol","role":"symbol","url":"\/documentation\/linkersets\/linkersetrecord","abstract":[{"type":"text","text":"One entry in a linker set: a record an attached macro places in the section LinkerSets owns."}],"title":"LinkerSetRecord","type":"topic","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord"},"doc://LinkerSets/documentation/LinkerSets":{"kind":"symbol","role":"collection","abstract":[{"type":"text","text":"Declarations that register themselves at compile time and are found at run time across every module a program links."}],"type":"topic","url":"\/documentation\/linkersets","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets","title":"LinkerSets"},"doc://LinkerSets/documentation/LinkerSets/LinkerSetKind":{"kind":"symbol","url":"\/documentation\/linkersets\/linkersetkind","title":"LinkerSetKind","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetKind"}],"abstract":[{"type":"text","text":"The tag that says which client a linker-set record belongs to."}],"navigatorTitle":[{"kind":"identifier","text":"LinkerSetKind"}]},"doc://LinkerSets/documentation/LinkerSets/LinkerSet":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSet"}],"navigatorTitle":[{"kind":"identifier","text":"LinkerSet"}],"kind":"symbol","role":"symbol","url":"\/documentation\/linkersets\/linkerset","abstract":[{"text":"Every record of one kind, across every image the program has loaded, and the values they","type":"text"},{"text":" ","type":"text"},{"text":"produce.","type":"text"}],"title":"LinkerSet","type":"topic","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet"}}}