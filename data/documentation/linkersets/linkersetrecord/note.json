ro, padded to 12 bytes; "},{"type":"codeVoice","code":"descriptorSize"},{"type":"text","text":", the size of a record (32 bytes where pointers"},{"type":"text","text":" "},{"type":"text","text":"are 64 bits, 20 where they are 32); and "},{"type":"codeVoice","code":"type"},{"type":"text","text":" 1. The record follows as the descriptor:"}],"type":"paragraph"},{"code":["let note: LinkerSetRecord.Note = (11, 32, 1, (76, 105, 110, 107, 101, 114, 83, 101, 116, 115, 0, 0),","                                  (0x726F_7574, 0, { outValue, type, hint, reserved in false }, 0, 0))"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The 24-byte header keeps the record at its own alignment, whether a reader aligns notes to"},{"type":"text","text":" "},{"type":"text","text":"4 bytes or to 8."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Note","kind":"identifier"}],"modules":[{"name":"LinkerSets"}],"role":"symbol","symbolKind":"typealias","externalID":"s:10LinkerSets0A9SetRecordV4Notea","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSets\/LinkerSetRecord.swift#L74","fileName":"LinkerSetRecord.swift"},"roleHeading":"Type Alias","navigatorTitle":[{"text":"Note","kind":"identifier"}],"title":"LinkerSetRecord.Note"},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Note","interfaceLanguage":"swift"},"references":{"doc://LinkerSets/documentation/LinkerSets":{"title":"LinkerSets","role":"collection","abstract":[{"text":"Declarations that register themselves at compile time and are found at run time across every module a program links.","type":"text"}],"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets","type":"topic","kind":"symbol","url":"\/documentation\/linkersets"},"doc://LinkerSets/documentation/LinkerSets/Lin