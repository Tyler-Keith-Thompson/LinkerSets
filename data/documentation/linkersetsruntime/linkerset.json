{"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"generated":true,"title":"Finding records","identifiers":["doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord","doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetKind"],"anchor":"Finding-records"}],"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/init(kind:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/kind","doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/records","doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet\/values"],"anchor":"Instance-Properties"}],"abstract":[{"text":"Every record of one kind, across every image the program has loaded, and the values they","type":"text"},{"text":" ","type":"text"},{"text":"produce.","type":"text"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/LinkerSetsRuntime\/s8SendableP","doc:\/\/LinkerSetsRuntime\/s16SendableMetatypeP"],"type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSet","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"text":"Records are declared at compile time as ","type":"text"},{"type":"codeVoice","code":"@used"},{"text":" globals in the section LinkerSets owns. In a","type":"text"},{"text":" ","type":"text"},{"text":"Mach-O image that is ","type":"text"},{"type":"codeVoice","code":"__DATA_CONST,__linker_sets"},{"text":", each record a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/Literal"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"In an ELF image it is the note section ","type":"text"},{"type":"codeVoice","code":".note.linker_sets"},{"text":", each record wrapped in a","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSetRecord\/Note"},{"text":". In a WebAssembly module it is the data section ","type":"text"},{"type":"codeVoice","code":"linker_sets"},{"text":", and in","type":"text"},{"text":" ","type":"text"},{"text":"a PE image (Windows) the grouped section ","type":"text"},{"type":"codeVoice","code":".lnkset$M"},{"text":", which the linker merges into ","type":"text"},{"type":"codeVoice","code":".lnkset"},{"text":". A","type":"text"},{"text":" ","type":"text"},{"text":"linker set finds them at run time in every image the loader has mapped: the program, the","type":"text"},{"text":" ","type":"text"},{"text":"shared libraries it was linked with, and any loaded later with ","type":"text"},{"type":"codeVoice","code":"dlopen"},{"text":". On Apple platforms it","type":"text"},{"text":" ","type":"text"},{"text":"reads each image’s section through the loader’s image callbacks; on ELF platforms (Linux,","type":"text"},{"text":" ","type":"text"},{"text":"Android) it reads each image’s note segments through ","type":"text"},{"type":"codeVoice","code":"dl_iterate_phdr"},{"text":"; on","type":"text"},{"text":" ","type":"text"},{"text":"WebAssembly (WASI), whose program is one statically linked module, it reads the section","type":"text"},{"text":" ","type":"text"},{"text":"between the ","type":"text"},{"type":"codeVoice","code":"__start_linker_sets"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"__stop_linker_sets"},{"text":" symbols wasm-ld defines; on Windows","type":"text"},{"text":" ","type":"text"},{"text":"it reads each loaded module’s ","type":"text"},{"type":"codeVoice","code":".lnkset"},{"text":" section through ","type":"text"},{"type":"codeVoice","code":"K32EnumProcessModules"},{"text":" and the","type":"text"},{"text":" ","type":"text"},{"text":"module’s PE section table, skipping the zero padding the linker may put between contributions:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let routes = LinkerSet<Route>(kind: .routes).values"]},{"inlineContent":[{"text":"Each read asks the loader again, so a read after a ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"text":" includes the new image’s records,","type":"text"},{"text":" ","type":"text"},{"text":"and one after the loader unmaps an image leaves its records out. An image loaded or unloaded","type":"text"},{"text":" ","type":"text"},{"text":"during a read is in it whole or not at all. Don’t ","type":"text"},{"code":"dlclose","type":"codeVoice"},{"text":" a library that holds Swift code:","type":"text"},{"text":" ","type":"text"},{"text":"dyld keeps such an image mapped, and on Linux and Android the Swift runtime still refers to its","type":"text"},{"text":" ","type":"text"},{"text":"metadata after the loader unmaps it, as a record read from it refers to its accessor.","type":"text"},{"text":" ","type":"text"},{"text":"Records come back image by image in the loader’s order, and within an image in the order the","type":"text"},{"text":" ","type":"text"},{"text":"linker laid them out, so two reads with no load between them return the same records in the","type":"text"},{"text":" ","type":"text"},{"text":"same order.","type":"text"},{"text":" ","type":"text"},{"text":"A kind no record was declared with gives an empty set, as does kind 0, which marks an empty","type":"text"},{"text":" ","type":"text"},{"text":"slot.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Records survive dead stripping ("},{"type":"codeVoice","code":"-dead_strip"},{"type":"text","text":", "},{"type":"codeVoice","code":"--gc-sections"},{"type":"text","text":") in debug and release builds:"},{"type":"text","text":" "},{"type":"text","text":"each is "},{"type":"codeVoice","code":"@used"},{"type":"text","text":", and the section is retained. A record reaches the program only when the"},{"type":"text","text":" "},{"type":"text","text":"linker links its module’s object file, though. SwiftPM links every object of a target’s"},{"type":"text","text":" "},{"type":"text","text":"dependencies, and so does Bazel’s "},{"type":"codeVoice","code":"swift_library"},{"type":"text","text":", which is "},{"type":"codeVoice","code":"alwayslink"},{"type":"text","text":" by default. A build"},{"type":"text","text":" "},{"type":"text","text":"that links a static archive’s members only on demand drops a module that nothing references"},{"type":"text","text":" "},{"type":"text","text":"by name. Link such a module whole ("},{"type":"codeVoice","code":"-force_load"},{"type":"text","text":" on Mach-O, "},{"type":"codeVoice","code":"--whole-archive"},{"type":"text","text":" on ELF)."}],"type":"paragraph"},{"inlineContent":[{"text":"Reading never traps. A record whose reserved fields aren’t zero, written by a newer layout, is","type":"text"},{"text":" ","type":"text"},{"text":"skipped; a section whose size isn’t a whole number of records is read up to its last whole","type":"text"},{"text":" ","type":"text"},{"text":"record; on ELF, a note that isn’t LinkerSets’, or whose record size this version doesn’t know,","type":"text"},{"text":" ","type":"text"},{"text":"is skipped.","type":"text"}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime\/LinkerSet"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/LinkerSetsRuntime\/documentation\/LinkerSetsRuntime"]]},"sections":[],"metadata":{"title":"LinkerSet","remoteSource":{"url":"https:\/\/github.