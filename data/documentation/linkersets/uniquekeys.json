{"variants":[{"paths":["\/documentation\/linkersets\/uniquekeys"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","abstract":[{"type":"text","text":"Make two records of one kind with the same key fail to build, within one executable or library."}],"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets"]]},"seeAlsoSections":[{"title":"Guides","generated":true,"anchor":"Guides","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking","doc:\/\/LinkerSets\/documentation\/LinkerSets\/Performance"]}],"sections":[],"identifier":{"url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/UniqueKeys","interfaceLanguage":"swift"},"metadata":{"title":"Unique keys","modules":[{"name":"LinkerSets"}],"roleHeading":"Article","role":"article"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Records are anonymous bytes in a section, and the linker concatenates them, so two modules can"},{"type":"text","text":" "},{"type":"text","text":"register the same route or the same event name, and nothing notices until the program reads the"},{"type":"text","text":" "},{"type":"text","text":"set. The linker does refuse two definitions of one symbol. A record declared with a unique key gets"},{"type":"text","text":" "},{"type":"text","text":"a function beside it whose symbol is named for the record’s kind and the key, so a second"},{"type":"text","text":" "},{"type":"text","text":"declaration of that kind and key defines the symbol again and the build fails, naming it."}]},{"type":"codeListing","code":["enum Routes {","    @LinkerSetEntry(kind: 0x726F_7574, uniqueKey: \"\/home\")","    static let home = Route(path: \"\/home\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:uniqueKey:)"},{"type":"text","text":" takes the key as a string literal. A client’s own macro gives"},{"type":"text","text":" "},{"type":"text","text":"each declaration its key from LinkerSetsMacroSupport’s "},{"type":"codeVoice","code":"uniqueKey(of:attribute:)"},{"type":"text","text":": from the"},{"type":"text","text":" "},{"type":"text","text":"declaration, such as an event type’s name, or from an argument of the attribute through"},{"type":"text","text":" "},{"type":"codeVoice","code":"uniqueKeyArgument(of:)"},{"type":"text","text":". Records of different kinds never clash, because the kind is part of the"},{"type":"text","text":" "},{"type":"text","text":"symbol’s name."}]},{"type":"heading","level":3,"anchor":"What-the-developer-sees","text":"What the developer sees"},{"type":"paragraph","inlineContent":[{"text":"The symbol reads ","type":"text"},{"code":"$linkerset_kind_<kind>_key_<key>","type":"codeVoice"},{"text":": the kind as eight hex digits, then the key,","type":"text"},{"text":" ","type":"text"},{"text":"with ASCII letters and digits as they are and every other UTF-8 byte as ","type":"text"},{"code":"_","type":"codeVoice"},{"text":" and two hex digits. The","type":"text"},{"text":" ","type":"text"},{"text":"route above is ","type":"text"},{"code":"$linkerset_kind_726F7574_key__2Fhome","type":"codeVoice"},{"text":", and an event named ","type":"text"},{"code":"OrderPlaced","type":"codeVoice"},{"text":" of kind","type":"text"},{"text":" ","type":"text"},{"code":"\"evnt\"","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"$linkerset_kind_65766E74_key_OrderPlaced","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two declarations in one module are caught by the compiler:"}]},{"type":"codeListing","code":["error: multiple definitions of symbol '$linkerset_kind_726F7574_key__2Fhome'"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two modules linked into one program are caught by the linker, which names both object files. Each"},{"type":"text","text":" "},{"type":"text","text":"linker words it its own way."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apple’s "},{"type":"codeVoice","code":"ld"},{"type":"text","text":":"}]},{"type":"codeListing","code":["duplicate symbol '_$linkerset_kind_65766E74_key_OrderPlaced' in:","    ...\/libCheckout.a[2](OrderPlaced.swift.o)","    ...\/libOrders.a[2](OrderPlaced.swift.o)","ld: 1 duplicate symbols"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"LLVM’s ","type":"text"},{"code":"lld","type":"codeVoice"},{"text":" for ELF, which Bazel links with on Linux and Android uses, points at the macro","type":"text"},{"text":" ","type":"text"},{"text":"expansion that declares each one:","type":"text"}]},{"type":"codeListing","code":["ld.lld: error: duplicate symbol: $linkerset_kind_65766E74_key_OrderPlaced",">>> defined at @__swiftmacro_6Orders11OrderPlaced5EventfMp_.swift:6",">>>            OrderPlaced.swift.o:($linkerset_kind_65766E74_key_OrderPlaced) in archive libOrders.a",">>> defined at @__swiftmacro_8Checkout11OrderPlaced5EventfMp_.swift:6",">>>            OrderPlaced.swift.o:(.text.$linkerset_kind_65766E74_key_OrderPlaced+0x0) in archive libCheckout.a"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"GNU gold, which "},{"type":"codeVoice","code":"swiftc"},{"type":"text","text":" links with on Linux by default:"}]},{"type":"codeListing","code":["\/usr\/bin\/ld.gold: error: .\/libCheckout.a(OrderPlaced.swift.o): multiple definition of '$linkerset_kind_65766E74_key_OrderPlaced'","\/usr\/bin\/ld.gold: .\/libOrders.a(OrderPlaced.swift.o): previous definition here"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"wasm-ld"},{"type":"text","text":", for WebAssembly:"}]},{"type":"codeListing","code":["wasm-ld: error: duplicate symbol: $linkerset_kind_65766E74_key_OrderPlaced",">>> defined in ...\/Orders.objlib\/a.o",">>> defined in ...\/Checkout.objlib\/b.o"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"On Windows, "},{"code":"lld-link","type":"codeVoice"},{"type":"text","text":" and "},{"code":"link.exe","type":"codeVoice"},{"type":"text","text":" refuse a symbol defined twice as well ("},{"code":"LNK2005","type":"codeVoice"},{"type":"text","text":" from"},{"type":"text","text":" "},{"code":"link.exe","type":"codeVoice"},{"type":"text","text":"), but no test shows it yet."}]},{"type":"heading","level":3,"anchor":"One-linked-image-at-a-time","text":"One linked image at a time"},{"type":"paragraph","inlineContent":[{"text":"The check covers the modules linked statically into one executable or one shared library. It","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t reach across images:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shared libraries and frameworks keep their symbols apart. On Apple platforms each image’s"},{"type":"text","text":" "},{"type":"text","text":"symbols live in a namespace of their own, and on ELF the first definition the loader finds wins"},{"type":"text","text":" "},{"type":"text","text":"without an error. The function is internal, so a library doesn’t export it either."}]}]},{"content":[{"inlineContent":[{"text":"A library opened with ","type":"text"},{"type":"codeVoice","code":"dlopen"},{"text":" is never compared with the program.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A record of the same key in another image is still read, so a client that needs the guarantee for","type":"text"},{"text":" ","type":"text"},{"text":"the whole process keeps a check at run time too, such as throwing when two records share a name.","type":"text"}]},{"type":"heading","level":3,"anchor":"Static-archives","text":"Static archives"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A static archive’s member is linked only when something references it. Its record and its key’s"},{"type":"text","text":" "},{"type":"text","text":"symbol sit in the same object file, so the two are linked together or not at all: a module whose"},{"type":"text","text":" "},{"type":"text","text":"records are missing (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking"},{"type":"text","text":") is missing from the check as well."}]},{"type":"paragraph","inlineContent":[{"text":"SwiftPM and Bazel link a target’s modules whole, and there a duplicate is an error. Apple’s ","type":"text"},{"type":"codeVoice","code":"ld"},{"text":" ","type":"text"},{"text":"makes one exception: with ","type":"text"},{"type":"codeVoice","code":"-dead_strip"},{"text":", the default for release builds in Xcode, a duplicate from","type":"text"},{"text":" ","type":"text"},{"text":"an archive member read on demand is only a warning, ","type":"text"},{"type":"codeVoice","code":"ld: warning: duplicate symbol"},{"text":", and the link","type":"text"},{"text":" ","type":"text"},{"text":"succeeds. Link the archive whole (","type":"text"},{"type":"codeVoice","code":"-force_load"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"-all_load"},{"text":" for every archive), or make the","type":"text"},{"text":" ","type":"text"},{"text":"linker’s warnings errors with ","type":"text"},{"type":"codeVoice","code":"-Xlinker -fatal_warnings"},{"text":", to keep it an error. Linux’s linkers and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"wasm-ld"},{"text":" make it an error either way.","type":"text"}]},{"type":"heading","level":3,"anchor":"Where-a-key-cant-be-checked","text":"Where a key can’t be checked"},{"type":"paragraph","inlineContent":[{"text":"A symbol declared inside a ","type":"text"},{"code":"private","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"fileprivate","type":"codeVoice"},{"text":" type, or an extension marked either way, is","type":"text"},{"text":" ","type":"text"},{"text":"local to its file, and the linker never compares local symbols. The macros refuse a unique key","type":"text"},{"text":" ","type":"text"},{"text":"there: “can’t check its unique key inside a private or fileprivate type”. The enclosing type can be","type":"text"},{"text":" ","type":"text"},{"text":"seen from swift-syntax 600 on. With an older swift-syntax the key in such a type compiles and goes","type":"text"},{"text":" ","type":"text"},{"text":"unchecked. A key that is empty, or a ","type":"text"},{"code":"uniqueKey:","type":"codeVoice"},{"text":" argument that isn’t a string literal or holds an","type":"text"},{"text":" ","type":"text"},{"text":"interpolation, is refused too (","type":"text"},{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","isActive":true,"type":"reference"},{"text":").","type":"text"}]},{"type":"heading","level":3,"anchor":"What-is-tested-where","text":"What is tested where"},{"type":"table","rows":[[[{"inlineContent":[{"text":"Format","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Covered by"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Runs in","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Mach-O, macOS","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Tests\/CompileFailures"},{"type":"text","text":": "},{"type":"codeVoice","code":"DuplicateEventNames"},{"type":"text","text":" (an archive read on demand), "},{"type":"codeVoice","code":"DistinctEventNames"},{"type":"text","text":", "},{"type":"codeVoice","code":"DuplicateKeyInOneModule"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"just test"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"ELF, Linux"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The same tests, linked with ","type":"text"},{"code":"lld","type":"codeVoice"},{"text":"; gold checked by hand","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"CI’s Linux Bazel job"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"WebAssembly","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Checked by hand with the 6.4.3 SDK’s ","type":"text"},{"code":"wasm-ld","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"UniqueKeyRecordTests","type":"codeVoice"},{"text":" reads keyed records","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"just wasi-test"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"COFF, Windows","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Untested: ","type":"text"},{"code":"UniqueKeyRecordTests","type":"codeVoice"},{"text":" shows keyed records build and read, but no test links a duplicate","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"CI’s Windows workflow"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"The Bazel tests build their programs with ","type":"text"},{"code":"tools\/link_test.bzl","type":"codeVoice"},{"text":", which links outside Bazel’s own","type":"text"},{"text":" ","type":"text"},{"text":"link step so that a link meant to fail doesn’t fail the build. SwiftPM can’t hold such a test: a","type":"text"},{"text":" ","type":"text"},{"text":"package with a duplicate fails to build as a whole.","type":"text"}]}]}],"references":{"doc://LinkerSets/documentation/LinkerSets/PlatformsAndLinking":{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking","abstract":[{"type":"text","text":"Where records are found, how, and which test shows it."}],"url":"\/documentation\/linkersets\/platformsandlinking","kind":"article","role":"article","title":"Platforms and linking","type":"topic"},"doc://LinkerSets/documentation/LinkerSets/FindingRecords":{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","abstract":[{"type":"text","text":"Read every declaration of a kind, as the type you expect."}],"kind":"article","url":"\/documentation\/linkersets\/findingrecords","role":"article","title":"Finding records","type":"topic"},"doc://LinkerSets/documentation/LinkerSets/Performance":{"type":"topic","title":"Performance","abstract":[{"text":"What records cost as an app grows: nothing at launch, a walk of the records when a set is read,","type":"text"},{"text":" ","type":"text"},{"text":"and a few milliseconds of build time per marked declaration.","type":"text"}],"kind":"article","url":"\/documentation\/linkersets\/performance","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/Performance","role":"article"},"doc://LinkerSets/documentation/LinkerSets/LinkerSetEntry(kind:uniqueKey:)":{"title":"LinkerSetEntry(kind:uniqueKey:)","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetEntry"},{"kind":"text","text":"("},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s6UInt32V","text":"UInt32"},{"kind":"text","text":", "},{"kind":"externalParam","text":"uniqueKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":")"}],"kind":"symbol","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetEntry(kind:uniqueKey:)","abstract":[{"type":"text","text":"Declares a record of "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" whose value is this declaration’s, and that no other record of"},{"type":"text","text":" "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" in the same executable or library may share "},{"type":"codeVoice","code":"uniqueKey"},{"type":"text","text":" with."}],"role":"symbol","type":"topic","url":"\/documentation\/linkersets\/linkersetentry(kind:uniquekey:)"},"doc://LinkerSets/documentation/LinkerSets/ReplacingARegistry":{"type":"topic","kind":"article","title":"Replacing a hand-written registry","abstract":[{"type":"text","text":"Move a central list of event types, routes or registrations onto declarations that find"},{"type":"text","text":" "},{"type":"text","text":"themselves."}],"url":"\/documentation\/linkersets\/replacingaregistry","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","role":"article"},"doc://LinkerSets/documentation/LinkerSets/DeclaringAKind":{"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","abstract":[{"text":"Pick the number that tags your declarations, and decide whether your users write it.","type":"text"}],"kind":"article","url":"\/documentation\/linkersets\/declaringakind","role":"article","title":"Declaring a kind","type":"topic"},"doc://LinkerSets/documentation/LinkerSets/WhatTheMacrosRefuse":{"role":"article","kind":"article","url":"\/documentation\/linkersets\/whatthemacrosrefuse","title":"What the macros refuse","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","abstract":[{"text":"Every declaration a record can’t describe is a compile error, with a message that says why.","type":"text"}],"type":"topic"},"doc://LinkerSets/documentation/LinkerSets":{"type":"topic","abstract":[{"text":"Declarations that register themselves at compile time and are found at run time across every module a program links.","type":"text"}],"title":"LinkerSets","kind":"symbol","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets","url":"\/documentation\/linkersets","role":"collection"}}}