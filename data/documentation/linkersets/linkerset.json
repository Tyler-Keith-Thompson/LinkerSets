{"abstract":[{"type":"text","text":"Every record of one kind, across every image the program has loaded, and the values they"},{"type":"text","text":" "},{"type":"text","text":"produce."}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/LinkerSets\/s8SendableP","doc:\/\/LinkerSets\/s16SendableMetatypeP"]}],"seeAlsoSections":[{"generated":true,"title":"Finding records","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetKind"],"anchor":"Finding-records"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSet","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Records are declared at compile time as ","type":"text"},{"code":"@used","type":"codeVoice"},{"text":" globals in the section LinkerSets owns. In a","type":"text"},{"text":" ","type":"text"},{"text":"Mach-O image that is ","type":"text"},{"code":"__DATA_CONST,__linker_sets","type":"codeVoice"},{"text":", each record a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Literal","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"In an ELF image it is the note section ","type":"text"},{"code":".note.linker_sets","type":"codeVoice"},{"text":", each record wrapped in a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSetRecord\/Note","type":"reference"},{"text":". In a WebAssembly module it is the data section ","type":"text"},{"code":"linker_sets","type":"codeVoice"},{"text":". A","type":"text"},{"text":" ","type":"text"},{"text":"linker set finds them at run time in every image the loader has mapped: the program, the","type":"text"},{"text":" ","type":"text"},{"text":"shared libraries it was linked with, and any loaded later with ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"text":". On Apple platforms it","type":"text"},{"text":" ","type":"text"},{"text":"reads each image’s section through the loader’s list of images; on ELF platforms (Linux,","type":"text"},{"text":" ","type":"text"},{"text":"Android, FreeBSD) it reads each image’s note segments through ","type":"text"},{"code":"dl_iterate_phdr","type":"codeVoice"},{"text":"; on","type":"text"},{"text":" ","type":"text"},{"text":"WebAssembly (WASI), whose program is one statically linked module, it reads the section","type":"text"},{"text":" ","type":"text"},{"text":"between the ","type":"text"},{"code":"__start_linker_sets","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"__stop_linker_sets","type":"codeVoice"},{"text":" symbols wasm-ld defines:","type":"text"}]},{"type":"codeListing","code":["let routes = LinkerSet<Route>(kind: .routes).values"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each read asks the loader again, so a read after a "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":" includes the new image’s records."},{"type":"text","text":" "},{"type":"text","text":"Records come back image by image in the loader’s order, and within an image in the order the"},{"type":"text","text":" "},{"type":"text","text":"linker laid them out, so two reads with no load between them return the same records in the"},{"type":"text","text":" "},{"type":"text","text":"same order."},{"type":"text","text":" "},{"type":"text","text":"A kind no record was declared with gives an empty set, as does kind 0, which marks an empty"},{"type":"text","text":" "},{"type":"text","text":"slot."}]},{"type":"paragraph","inlineContent":[{"text":"Records survive dead stripping (","type":"text"},{"code":"-dead_strip","type":"codeVoice"},{"text":", ","type":"text"},{"code":"--gc-sections","type":"codeVoice"},{"text":") in debug and release builds:","type":"text"},{"text":" ","type":"text"},{"text":"each is ","type":"text"},{"code":"@used","type":"codeVoice"},{"text":", and the section is retained. A record reaches the program only when the","type":"text"},{"text":" ","type":"text"},{"text":"linker links its module’s object file, though. SwiftPM links every object of a target’s","type":"text"},{"text":" ","type":"text"},{"text":"dependencies, and so does Bazel’s ","type":"text"},{"code":"swift_library","type":"codeVoice"},{"text":", which is ","type":"text"},{"code":"alwayslink","type":"codeVoice"},{"text":" by default. A build","type":"text"},{"text":" ","type":"text"},{"text":"that links a static archive’s members only on demand drops a module that nothing references","type":"text"},{"text":" ","type":"text"},{"text":"by name. Link such a module whole (","type":"text"},{"code":"-force_load","type":"codeVoice"},{"text":" on Mach-O, ","type":"text"},{"code":"--whole-archive","type":"codeVoice"},{"text":" on ELF).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reading never traps. A record whose reserved fields aren’t zero, written by a newer layout, is"},{"type":"text","text":" "},{"type":"text","text":"skipped; a section whose size isn’t a whole number of records is read up to its last whole"},{"type":"text","text":" "},{"type":"text","text":"record; on ELF, a note that isn’t LinkerSets’, or whose record size this version doesn’t know,"},{"type":"text","text":" "},{"type":"text","text":"is skipped."}]}],"kind":"content"}],"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/init(kind:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/kind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/records","doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/values"],"anchor":"Instance-Properties"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersets\/linkerset"]}],"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet"},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Structure","externalID":"s:10LinkerSets0A3SetV","modules":[{"name":"LinkerSets"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/LinkerSets\/blob\/main\/Sources\/LinkerSets\/LinkerSet.swift#L38","fileName":"LinkerSet.swift"},"title":"LinkerSet","symbolKind":"struct","navigatorTitle":[{"text":"LinkerSet","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkerSet","kind":"identifier"}]},"kind":"symbol","references":{"doc://LinkerSets/documentation/LinkerSets/LinkerSet/init(kind:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"kind"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"LinkerSetKind","preciseIdentifier":"s:10LinkerSets0A7SetKindV"},{"kind":"text","text":")"}],"abstract":[{"text":"The set of records of ","type":"text"},{"code":"kind","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/linkersets\/linkerset\/init(kind:)","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/LinkerSet\/init(kind:)","title":"init(kind:)"},"doc://LinkerSets/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/LinkerSets\/s8SendableP"},"doc://LinkerSets/documentation/LinkerSets/LinkerSet":{"type":"topic","navigatorTitle":[{"t