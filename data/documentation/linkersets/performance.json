{"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersets\/performance"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"A record is data the linker places in a section, so nothing runs for it at launch. Reading a set"},{"type":"text","text":" "},{"type":"text","text":"walks every loaded image’s section once and calls the accessor of each record of the set’s kind."},{"type":"text","text":" "},{"type":"text","text":"That’s linear in the records the program holds, and the reads aren’t cached, so read a set once"},{"type":"text","text":" "},{"type":"text","text":"where the program starts and keep the array. "},{"type":"codeVoice","code":"LinkerSetsPerformanceTests"},{"type":"text","text":" checks the scaling in"},{"type":"text","text":" "},{"type":"text","text":"release builds: reading 3,000 records costs no more than about 10 times reading 300."}],"type":"paragraph"},{"inlineContent":[{"text":"The build pays for each marked declaration: the macro’s expansion and the record it compiles to.","type":"text"},{"text":" ","type":"text"},{"text":"That cost is also linear while the records are spread across files, as they are in an app.","type":"text"},{"text":" ","type":"text"},{"text":"Thousands of records in one file take the compiler much longer, so generated registries are","type":"text"},{"text":" ","type":"text"},{"text":"better split.","type":"text"}],"type":"paragraph"},{"anchor":"Measured","type":"heading","level":3,"text":"Measured"},{"inlineContent":[{"type":"codeVoice","code":"just benchmark"},{"type":"text","text":" measures both in a SwiftPM package of generated records, against the same"},{"type":"text","text":" "},{"type":"text","text":"declarations without the macro. These figures are from an M1 Ultra with Swift 6.4.2, in a debug"},{"type":"text","text":" "},{"type":"text","text":"build, with each size’s records split across 10 files:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Records"}]}],[{"type":"paragraph","inlineContent":[{"text":"Build time the records add","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Per record","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Reading every record (release)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"100","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"2.6 s"}]}],[{"type":"paragraph","inlineContent":[{"text":"26 ms","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"77 µs","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"1,000"}]}],[{"type":"paragraph","inlineContent":[{"text":"4.2 s","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"4.3 ms","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"242 µs","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"10,000"}]}],[{"type":"paragraph","inlineContent":[{"text":"50 s","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"5.0 ms"}]}],[{"type":"paragraph","inlineContent":[{"text":"2.0 ms","type":"text"}]}]]],"alignments":["right","right","right","right"],"type":"table"},{"inlineContent":[{"text":"The 100-record row is mostly the macro plugin’s start-up, paid once per module that uses it. A","type":"text"},{"text":" ","type":"text"},{"text":"read also has a fixed part, the walk over every image the process has loaded, which is about","type":"text"},{"text":" ","type":"text"},{"text":"70 µs on macOS. In a single file, 10,000 records added 111 s to the build instead of 50 s.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/Performance","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Guides","anchor":"Guides","generated":true,"identifiers":["doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind","doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse","doc:\/\/LinkerSets\/documentation\/LinkerSets\/UniqueKeys","doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking"]}],"hierarchy":{"paths":[["doc:\/\/LinkerSets\/documentation\/LinkerSets"]]},"kind":"article","metadata":{"title":"Performance","modules":[{"name":"LinkerSets"}],"roleHeading":"Article","role":"article"},"abstract":[{"type":"text","text":"What records cost as an app grows: nothing at launch, a walk of the records when a set is read,"},{"type":"text","text":" "},{"type":"text","text":"and a few milliseconds of build time per marked declaration."}],"references":{"doc://LinkerSets/documentation/LinkerSets/DeclaringAKind":{"kind":"article","abstract":[{"type":"text","text":"Pick the number that tags your declarations, and decide whether your users write it."}],"type":"topic","role":"article","title":"Declaring a kind","url":"\/documentation\/linkersets\/declaringakind","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/DeclaringAKind"},"doc://LinkerSets/documentation/LinkerSets/UniqueKeys":{"kind":"article","abstract":[{"type":"text","text":"Make two records of one kind with the same key fail to build, within one executable or library."}],"type":"topic","role":"article","url":"\/documentation\/linkersets\/uniquekeys","title":"Unique keys","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/UniqueKeys"},"doc://LinkerSets/documentation/LinkerSets/ReplacingARegistry":{"type":"topic","kind":"article","url":"\/documentation\/linkersets\/replacingaregistry","abstract":[{"text":"Move a central list of event types, routes or registrations onto declarations that find","type":"text"},{"text":" ","type":"text"},{"text":"themselves.","type":"text"}],"role":"article","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/ReplacingARegistry","title":"Replacing a hand-written registry"},"doc://LinkerSets/documentation/LinkerSets/PlatformsAndLinking":{"type":"topic","kind":"article","url":"\/documentation\/linkersets\/platformsandlinking","abstract":[{"type":"text","text":"Where records are found, how, and which test shows it."}],"role":"article","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/PlatformsAndLinking","title":"Platforms and linking"},"doc://LinkerSets/documentation/LinkerSets/WhatTheMacrosRefuse":{"kind":"article","abstract":[{"type":"text","text":"Every declaration a record can’t describe is a compile error, with a message that says why."}],"type":"topic","role":"article","title":"What the macros refuse","url":"\/documentation\/linkersets\/whatthemacrosrefuse","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/WhatTheMacrosRefuse"},"doc://LinkerSets/documentation/LinkerSets/FindingRecords":{"type":"topic","title":"Finding records","url":"\/documentation\/linkersets\/findingrecords","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets\/FindingRecords","role":"article","kind":"article","abstract":[{"text":"Read every declaration of a kind, as the type you expect.","type":"text"}]},"doc://LinkerSets/documentation/LinkerSets":{"kind":"symbol","abstract":[{"text":"Declarations that register themselves at compile time and are found at run time across every module a program links.","type":"text"}],"type":"topic","role":"collection","url":"\/documentation\/linkersets","title":"LinkerSets","identifier":"doc:\/\/LinkerSets\/documentation\/LinkerSets"}}}