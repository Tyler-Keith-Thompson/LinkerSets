type":"text","text":"a static property’s or a global variable’s value;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a static or free function, as a value of its function type;"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"a struct, enum, class or actor, as its metatype: "},{"type":"codeVoice","code":"any P.Type"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro\/requiredConformance(of:)"},{"type":"text","text":" names a protocol "},{"type":"codeVoice","code":"P"},{"type":"text","text":", which the type must then conform to or the"},{"type":"text","text":" "},{"type":"text","text":"expansion doesn’t compile, and "},{"type":"codeVoice","code":"Any.Type"},{"type":"text","text":" otherwise."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A function isolated to the main actor, by its own ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" or its type’s or extension’s,","type":"text"},{"text":" ","type":"text"},{"text":"is stored as its isolated type (","type":"text"},{"type":"codeVoice","code":"@MainActor () -> Void"},{"text":"), read with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"LinkerSet<@MainActor () -> Void>"},{"text":" and called on the main actor. A property isolated to the","type":"text"},{"text":" ","type":"text"},{"text":"main actor is refused, since the record’s nonisolated accessor can’t read it: one marked","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":", or a ","type":"text"},{"type":"codeVoice","code":"var"},{"text":" of a ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" type. Only a written ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" is seen. A custom","type":"text"},{"text":" ","type":"text"},{"text":"global actor’s attribute, and isolation a type inherits from a protocol it conforms to, can’t","type":"text"},{"text":" ","type":"text"},{"text":"be seen in the syntax, so a member isolated that way fails to compile inside the expansion.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It diagnoses anything else, each with a message of its own: generic functions and types,"},{"type":"text","text":" "},{"type":"text","text":"members of generic types, instance members, protocol requirements, declarations inside a"},{"type":"text","text":" "},{"type":"text","text":"function, closure or accessor, and a kind that isn’t a 32-bit literal other than 0."}],"type":"paragraph"},{"inlineContent":[{"text":"Before swift-syntax 600 a macro can’t see its lexical context. There a type it registers must","type":"text"},{"text":" ","type":"text"},{"text":"be declared at file scope, and the compiler, not the macro, refuses a local declaration or a","type":"text"},{"text":" ","type":"text"},{"text":"member of a generic type, with an error in the expansion.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/linkersetsmacrosupport\/linkersetmacro"]}],"identifier":{"url":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetMacro","interfaceLanguage":"swift"},"references":{"doc://LinkerSetsMacroSupport/documentation/LinkerSetsMacroSupport/LinkerSetRecordMacro":{"title":"LinkerSetRecordMacro","type":"topic","url":"\/documentation\/linkersetsmacrosupport\/linkersetrecordmacro","identifier":"doc:\/\/LinkerSetsMacroSupport\/documentation\/LinkerSetsMacroSupport\/LinkerSetRecordMacro","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"LinkerSetRecordMacro"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"LinkerSetRecordMacro"}],"ab